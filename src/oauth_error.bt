/// OAuthError — the structured error every public operation answers in
/// a `Result` (language ADR 0060).
///
/// `code` is a string from one of three families:
///
/// - provider codes, verbatim, from an `oidcc` `{http_error, Status, Body}`
///   (`invalid_grant`, `invalid_client`, `access_denied`, ...);
/// - `oidcc` reasons, by atom name (`missing_claim`, `token_expired`,
///   `no_supported_auth_method`, ...);
/// - local codes: `transport`, `parse`, `config`, `expired_session`,
///   `reused_state`, `session_mismatch`, `insecure_endpoint`,
///   `callback_timeout`.
///
/// `detail` keeps the original term for debugging, with every token-like
/// binary and every claims map replaced by `"[redacted]"`.
///
/// ## Examples
/// ```beamtalk
/// (OAuthError transport: "connection refused") code   // => "transport"
/// (OAuthError fromOidcc: #token_expired) code          // => "token_expired"
/// ```
typed Value subclass: OAuthError
  /// Machine-readable error code.
  field: code :: String = ""
  /// Human-readable description; may be empty.
  field: description :: String = ""
  /// HTTP status when the error came from a provider response.
  field: status :: Integer | Nil = nil
  /// The original error term, redacted of secrets.
  field: detail :: Object = nil

  /// An error with `code` and `description` and no status or detail.
  class code: code :: String description: description :: String -> OAuthError =>
    self new: #{#code => code, #description => description}

  /// The network call failed: connect, TLS, timeout, closed connection.
  class transport: description :: String -> OAuthError =>
    self code: "transport" description: description

  /// A response or callback could not be parsed.
  class parse: description :: String -> OAuthError =>
    self code: "parse" description: description

  /// The caller's configuration is invalid.
  class config: description :: String -> OAuthError =>
    self code: "config" description: description

  /// A plain-HTTP endpoint or a non-loopback http redirect was refused.
  class insecureEndpoint: description :: String -> OAuthError =>
    self code: "insecure_endpoint" description: description

  /// The session was consumed after its TTL.
  class expiredSession -> OAuthError =>
    self code: "expired_session" description: "login session expired"

  /// The session's state was already consumed once.
  class reusedState -> OAuthError =>
    self code: "reused_state" description: "login session already used"

  /// The callback came from a different user agent, issuer or redirect.
  class sessionMismatch -> OAuthError =>
    self code: "session_mismatch" description: "login session does not match"

  /// No callback arrived before the deadline.
  class callbackTimeout -> OAuthError =>
    self code: "callback_timeout" description: "no callback before the timeout"

  /// No callback was accepted before the deadline, after `refused`
  /// callbacks were refused for a missing, wrong or repeated parameter
  /// (see `LoopbackReceiver`). `detail` holds the count.
  class callbackTimeoutRefusing: refused :: Integer -> OAuthError =>
    refused =:= 0 ifTrue: [^self callbackTimeout withDetail: 0]
    (self code: "callback_timeout" description: "no matching callback before the timeout; {refused} callback(s) with a missing, wrong or repeated state, code or error were refused") withDetail: refused

  /// Map an `oidcc` error reason to an `OAuthError`.
  ///
  /// - `{http_error, Status, #{<<"error">> := Code}}` answers the provider
  ///   code verbatim, with the status and any `error_description`;
  ///   an `http_error` without an `error` member answers `http_error`.
  /// - `{http_client, Reason}` (the HTTP adapter got no response) answers
  ///   `transport`.
  /// - `{insecure_endpoint, Field, Url}` (the shim's HTTPS-only check)
  ///   answers `insecure_endpoint`, naming the field and URL.
  /// - An atom, or a tuple whose first element is an atom, answers that
  ///   atom's name (`missing_claim`, `token_expired`, ...).
  /// - Anything else answers `transport`.
  ///
  /// An Exception (how an FFI `{error, R}` arrives) is unwrapped to its
  /// `reason`, and wrapping `{error, Reason}` tuples are unwrapped, at any
  /// depth.
  /// `undefined`, `true` and `false` are not reasons and answer `transport`.
  /// `detail` always holds the redacted original term (see `redact:`).
  class fromOidcc: reason :: Object -> OAuthError =>
    self fromOidcc: reason secrets: #()

  /// As `fromOidcc:`, with every text in the reason that contains one of
  /// `secrets` (the tokens and client secret the request carried) replaced
  /// by the marker first (see `scrub:secrets:`), so a provider error that
  /// echoes a token cannot carry it into `description` or `detail`.
  class fromOidcc: reason :: Object secrets: secrets :: List(String) -> OAuthError =>
    // An FFI `{error, R}` arrives as `Result error:` an Exception whose
    // `reason` is `R`.
    term := (reason isKindOf: Exception) ifTrue: [
      reason reason
    ] ifFalse: [reason]
    [
      (term isKindOf: Tuple) and: [
        (term size =:= 2) and: [(term at: 1) =:= #error]
      ]
    ] whileTrue: [term := term at: 2]
    term := self scrub: term secrets: secrets
    detail := self redact: term
    tag := (term isKindOf: Symbol)
      ifTrue: [term]
      ifFalse: [
        ((term isKindOf: Tuple) and: [
          (term size >= 1) and: [(term at: 1) isKindOf: Symbol]
        ]) ifTrue: [term at: 1] ifFalse: [nil]
      ]
    (tag isNil or: [#(#undefined, #true, #false) includes: tag])
      ifTrue: [
        ^self
          new: #{
            #code => "transport",
            #description => "unexpected oidcc error",
            #detail => detail
          }
      ]
    (tag =:= #http_client and: [
      term isKindOf: Tuple
    ]) ifTrue: [^self fromHttpClient: term detail: detail]
    ((tag =:= #insecure_endpoint and: [
      term isKindOf: Tuple
    ]) and: [term size =:= 3])
      ifTrue: [
        field := (self textOf: (term at: 2)) ifNil: ["endpoint"]
        url := (self textOf: (term at: 3)) ifNil: [""]
        ^self
          new: #{
            #code => "insecure_endpoint",
            #description => "{field} must be https: {url}",
            #detail => detail
          }
      ]
    ((tag =:= #http_error)
      and: [
        (term isKindOf: Tuple) and: [
          (term size >= 2) and: [(term at: 2) isKindOf: Integer]
        ]
      ]) ifTrue: [^self fromHttpError: term detail: detail]
    self new: #{#code => tag asString, #detail => detail}

  /// `{http_client, Reason}` from the HTTP adapter: the request never got
  /// a response (connect, TLS, timeout, body over the cap). Answers
  /// `transport`, described by `Reason` when it is text that does not look
  /// secret (see `looksSecret:`).
  class fromHttpClient: term :: Tuple detail: detail :: Object -> OAuthError =>
    reason := term size >= 2 ifTrue: [term at: 2] ifFalse: [nil]
    text := self textOf: reason
    // A Symbol is one of the adapter's fixed reasons; text came from the
    // HTTP client and is redacted like a detail.
    (text isNil
      or: [
        (reason isKindOf: Symbol) not and: [
          self looksSecret: (Binary fromIolist: #(text))
        ]
      ]) ifTrue: [text := "HTTP request failed"]
    self new: #{#code => "transport", #description => text, #detail => detail}

  /// `{http_error, Status, Body}`: the provider's `error` member when the
  /// body is a map that carries one, `http_error` otherwise.
  class fromHttpError: term :: Tuple detail: detail :: Object -> OAuthError =>
    status := term at: 2
    body := term size >= 3 ifTrue: [term at: 3] ifFalse: [nil]
    providerCode := nil
    providerDescription := ""
    (body isKindOf: Dictionary)
      ifTrue: [
        providerCode := self textAt: "error" in: body
        providerDescription := (self textAt: "error_description" in: body) ifNil: [
          ""
        ]
      ]
    self
      new: #{
        #code => providerCode ifNil: ["http_error"],
        #description => providerDescription,
        #status => status,
        #detail => detail
      }

  /// The member `key` of `map` as a String, whether the map's keys are
  /// Strings or raw binaries (`oidcc` answers raw binaries). Answers nil
  /// when absent or not text.
  class textAt: key :: String in: map :: Dictionary -> String | Nil =>
    found := nil
    // Dictionary keys and values are untyped Erlang terms here.
    @expect type
    map
      keysAndValuesDo: [:k :v |
        (found isNil and: [
          (self textOf: k) =:= key
        ]) ifTrue: [found := self textOf: v]
      ]
    found

  /// `value` as a String when it is text (String, raw binary or Symbol),
  /// nil otherwise. Invalid UTF-8 answers nil.
  class textOf: value :: Object -> String | Nil =>
    (value isKindOf: String) ifTrue: [^value]
    (value isKindOf: Symbol) ifTrue: [^value asString]
    (value isKindOf: Binary) ifTrue: [
      ^value asString ifOk: [:text | text] ifError: [:e | nil]
    ]
    nil

  /// The marker that replaces redacted values.
  class redacted -> String => "[redacted]"

  /// `term` with every text (String or raw binary) that contains one of
  /// `secrets`, raw or URL-encoded, replaced by the marker, at any depth
  /// of tuples, lists, map keys and map values. A binary that is not
  /// valid UTF-8 cannot be searched and is replaced too. Empty secrets are
  /// ignored; with none, `term` is answered unchanged.
  class scrub: term :: Object secrets: secrets :: List(String) -> Dynamic =>
    (secrets anySatisfy: [:secret | secret isEmpty not]) ifFalse: [^term]
    (term isKindOf: Binary)
      ifTrue: [
        text := self textOf: term
        text isNil ifTrue: [^self redacted]
        ^(self mentions: text secrets: secrets) ifTrue: [
          self redacted
        ] ifFalse: [term]
      ]
    (term isKindOf: Tuple)
      ifTrue: [
        ^Tuple withAll: ((1 to: term size) collect: [:i |
          self scrub: (term at: i) secrets: secrets
        ])
      ]
    @expect type
    (term isKindOf: List) ifTrue: [
      ^term collect: [:each | self scrub: each secrets: secrets]
    ]
    (term isKindOf: Dictionary) ifFalse: [^term]
    out := #{}
    @expect type
    term
      keysAndValuesDo: [:k :v |
        out := out at: (self scrub: k secrets: secrets) put: (self scrub: v secrets: secrets)
      ]
    out

  /// True when `text` contains a non-empty member of `secrets`, raw,
  /// URL-encoded or form-encoded (a space as `+`, as `oidcc` sends a
  /// form body).
  class mentions: text :: String secrets: secrets :: List(String) -> Boolean =>
    secrets
      anySatisfy: [:secret |
        secret isEmpty not
          and: [
            encoded := secret urlEncoded
            (text includesSubstring: secret)
              or: [
                (text includesSubstring: encoded) or: [
                  text includesSubstring: (encoded replaceAll: "%20" with: "+")
                ]
              ]
          ]
      ]

  /// `term` with secrets removed, for `detail` and logs. Redaction errs
  /// towards hiding: the marker `"[redacted]"` replaces
  ///
  /// - any binary or String that `looksSecret:`;
  /// - `oidcc` token and client-context records and `jose` key records
  ///   (tuples tagged `oidcc_token*`, `oidcc_client_context`, `jose_jw*`),
  ///   whole;
  /// - a claims map: any map with a `sub`, `iss`, `aud`, `exp` or `email`
  ///   member;
  /// - the value of a `secretKeys` member, in a map or as a `{Key, Value}`
  ///   pair (keyword lists).
  ///
  /// Tuples, lists and other map values are redacted recursively; anything
  /// else (atoms, numbers, pids) is kept.
  class redact: term :: Object -> Object =>
    (term isKindOf: Binary) ifTrue: [
      ^(self looksSecret: term) ifTrue: [self redacted] ifFalse: [term]
    ]
    (term isKindOf: Tuple) ifTrue: [^self redactTuple: term]
    @expect type
    (term isKindOf: List) ifTrue: [^term collect: [:each | self redact: each]]
    (term isKindOf: Dictionary) ifTrue: [^self redactMap: term]
    term

  /// Secret-bearing records become the marker, a `{SecretKey, Value}` pair
  /// keeps its key, and other tuples are redacted element by element.
  class redactTuple: tuple :: Tuple -> Object =>
    tuple size =:= 0 ifTrue: [^tuple]
    tag := self textOf: (tuple at: 1)
    tag notNil
      ifTrue: [
        ((tuple at: 1) isKindOf: Symbol)
          ifTrue: [
            (self secretRecordPrefixes anySatisfy: [:prefix |
              tag startsWith: prefix
            ]) ifTrue: [^self redacted]
          ]
        ((tuple size =:= 2) and: [
          self secretKeys includes: tag
        ]) ifTrue: [^{tuple at: 1, self redacted}]
      ]
    Tuple withAll: ((1 to: tuple size) collect: [:i |
      self redact: (tuple at: i)
    ])

  /// A claims map becomes the marker; any other map keeps its keys, with
  /// secret-named members replaced and the rest redacted recursively.
  class redactMap: map :: Dictionary -> Object =>
    isClaims := false
    @expect type
    map
      keysAndValuesDo: [:k :v |
        name := self textOf: k
        (self claimKeys includes: name) ifTrue: [isClaims := true]
      ]
    isClaims ifTrue: [^self redacted]
    out := #{}
    @expect type
    map
      keysAndValuesDo: [:k :v |
        name := self textOf: k
        secret := name notNil and: [self secretKeys includes: name]
        out := out at: k put: (secret ifTrue: [
          self redacted
        ] ifFalse: [self redact: v])
      ]
    out

  /// Member names whose values are always secret.
  class secretKeys -> List(String) =>
    #("access_token", "refresh_token", "id_token", "id_token_hint", "logout_token", "token", "code", "code_verifier", "client_secret", "client_assertion", "assertion", "device_code", "password", "nonce", "k", "d")

  /// Member names that mark a map as ID-token or userinfo claims.
  class claimKeys -> List(String) => #("sub", "iss", "aud", "exp", "email")

  /// Record tags (atom prefixes) whose tuples always hold secrets.
  class secretRecordPrefixes -> List(String) =>
    #("oidcc_token", "oidcc_client_context", "jose_jw")

  /// True when `bin` should not appear in a detail: invalid UTF-8; anything
  /// containing a JWT (`eyJ...` segment pair), an auth scheme (`Bearer `,
  /// `Basic `) or a secret query parameter (`code=`, `token=`, `secret=`,
  /// `password=`, `assertion=`); or 16+ characters without whitespace,
  /// unless it is an http(s) URL with no query or fragment (an issuer or
  /// endpoint).
  class looksSecret: bin :: Binary -> Boolean =>
    text := self textOf: bin
    text isNil ifTrue: [^true]
    (text matchesRegex: "eyJ[A-Za-z0-9_-]+[.][A-Za-z0-9_-]+") ifTrue: [^true]
    (text matchesRegex: "(?i)(bearer|basic|dpop) +[^ ]") ifTrue: [^true]
    (text matchesRegex: "(?i)(code|token|secret|password|assertion|verifier)=") ifTrue: [
      ^true
    ]
    (text matchesRegex: "^(?i)https?://[^?#[:space:]]*$") ifTrue: [^false]
    (text size >= 16) and: [(text matchesRegex: "[[:space:]]") not]

  /// `OAuthError(code, status: 400): description`. `detail` is not shown.
  printString -> String =>
    statusPart := self.status isNil ifTrue: [
      ""
    ] ifFalse: [", status: {self.status}"]
    descPart := self.description isEmpty ifTrue: [
      ""
    ] ifFalse: [": {self.description}"]
    "OAuthError({self.code}{statusPart}){descPart}"

  /// The JSON shape. `detail` is an Erlang term, so it appears as the
  /// printString of its redacted form.
  asJson -> Dictionary =>
    #{
      "code" => self.code,
      "description" => self.description,
      "status" => self.status,
      "detail" => self.detail isNil ifTrue: [
        nil
      ] ifFalse: [self.detail printString]
    }
