/// TokenSet — the tokens a grant answered, plus their lifecycle.
///
/// `idTokenClaims` holds claims `oidcc` has already validated; the raw
/// `idToken` JWT is kept only for logout's `id_token_hint`. Times are
/// Unix seconds: `obtainedAt` is stamped when the token request was sent,
/// and `expiresIn` is the provider's lifetime in seconds (nil when the
/// provider gave none, in which case the set never reports expiry).
///
/// `printString` and `asJson` redact `accessToken`, `refreshToken` and
/// `idToken`.
///
/// ## Examples
/// ```beamtalk
/// toks := TokenSet new: #{#accessToken => "...", #expiresIn => 3600, #obtainedAt => 1700000000}
/// toks isExpiredAt: 1700003600   // => true
/// toks bearerHeader              // => "Bearer ..."
/// ```
typed Value subclass: TokenSet
  /// The access token.
  field: accessToken :: String = ""
  /// The token type the provider answered, normally `bearer`.
  field: tokenType :: String = "bearer"
  /// Lifetime in seconds from `obtainedAt`, or nil if unknown.
  field: expiresIn :: Integer | Nil = nil
  /// Unix seconds at which the token request was sent.
  field: obtainedAt :: Integer = 0
  /// The refresh token, if the provider issued one.
  field: refreshToken :: String | Nil = nil
  /// The granted scope, space-separated, if the provider stated it.
  field: scope :: String | Nil = nil
  /// The validated ID-token claims, if an ID token was issued.
  field: idTokenClaims :: Dictionary | Nil = nil
  /// The raw ID token (JWT), for `id_token_hint` only.
  field: idToken :: String | Nil = nil

  /// Seconds before expiry at which `needsRefresh` turns true, at most.
  class refreshMargin -> Integer => 60

  /// The current Unix time in seconds.
  class now -> Integer => Erlang erlang system_time: #second

  /// Unix seconds at which the access token expires, or nil if unknown.
  expiresAt -> Integer | Nil =>
    self.expiresIn isNil ifTrue: [
      nil
    ] ifFalse: [self.obtainedAt + self.expiresIn]

  /// True when the access token has expired at `now` (Unix seconds).
  /// Always false when the lifetime is unknown.
  isExpiredAt: now :: Integer -> Boolean =>
    deadline := self expiresAt
    deadline isNil ifTrue: [false] ifFalse: [now >= deadline]

  /// True when the access token expires within the refresh margin of
  /// `now` (Unix seconds), or already has. The margin is
  /// `TokenSet refreshMargin`, capped at half the lifetime so a short-lived
  /// token is not due for refresh the moment it is issued. Always false
  /// when the lifetime is unknown.
  needsRefreshAt: now :: Integer -> Boolean =>
    deadline := self expiresAt
    deadline isNil ifTrue: [^false]
    margin := TokenSet refreshMargin min: ((deadline - self.obtainedAt) div: 2)
    now >= (deadline - margin)

  /// `isExpiredAt:` against the system clock.
  isExpired -> Boolean => self isExpiredAt: TokenSet now

  /// `needsRefreshAt:` against the system clock.
  needsRefresh -> Boolean => self needsRefreshAt: TokenSet now

  /// The `Authorization` header value: `Bearer <accessToken>`.
  bearerHeader -> String => "Bearer " ++ self.accessToken

  /// The ID token's `sub` claim, or nil without ID-token claims.
  subject -> String | Nil =>
    self.idTokenClaims isNil ifTrue: [^nil]
    OAuthError textAt: "sub" in: self.idTokenClaims

  /// The result of a refresh: `response`'s values win, and this set's
  /// refresh token, scope, and ID token (claims and raw JWT together)
  /// carry forward when `response` omits them. The ID token carries
  /// forward only when the response has neither claims nor a raw JWT, so
  /// a new JWT is never paired with old claims. Providers often answer a
  /// refresh without a new refresh token (Google) or ID token, and an
  /// omitted scope means the scope is unchanged (RFC 6749 §5.1).
  mergedWith: response :: TokenSet -> TokenSet =>
    merged := response
    response refreshToken isNil ifTrue: [
      merged := merged withRefreshToken: self.refreshToken
    ]
    response scope isNil ifTrue: [merged := merged withScope: self.scope]
    (response idTokenClaims isNil and: [response idToken isNil])
      ifTrue: [
        merged := (merged withIdTokenClaims: self.idTokenClaims) withIdToken: self.idToken
      ]
    merged

  /// `TokenSet(tokenType: bearer, accessToken: [redacted], ...)`.
  printString -> String =>
    "TokenSet(tokenType: {self.tokenType}, accessToken: {self redact: self.accessToken}, expiresIn: {self.expiresIn}, obtainedAt: {self.obtainedAt}, refreshToken: {self redact: self.refreshToken}, scope: {self.scope}, idToken: {self redact: self.idToken})"

  /// The JSON shape, with the three tokens redacted. The ID-token claims
  /// are omitted; ask for `idTokenClaims` explicitly.
  asJson -> Dictionary =>
    #{
      "accessToken" => self redact: self.accessToken,
      "tokenType" => self.tokenType,
      "expiresIn" => self.expiresIn,
      "obtainedAt" => self.obtainedAt,
      "refreshToken" => self redact: self.refreshToken,
      "scope" => self.scope,
      "idToken" => self redact: self.idToken
    }

  /// `"[redacted]"` for a present token, nil for an absent one.
  redact: token :: String | Nil -> String | Nil =>
    token isNil ifTrue: [nil] ifFalse: [OAuthError redacted]
