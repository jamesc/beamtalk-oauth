/// Secrets — the only randomness this library produces.
///
/// `state`, `nonce` and the PKCE `code_verifier` all come from here.
/// `oidcc` computes the S256 challenge from the verifier; it does not
/// generate secrets for callers.
///
/// ## Examples
/// ```beamtalk
/// Secrets generate         // => "df7METgNuTR5HmbDP-7gzrsHWCpVXcTVXWmrk02nATg"
/// Secrets generate size    // => 43
/// ```
Object subclass: Secrets

  /// 32 CSPRNG bytes (`crypto:strong_rand_bytes/1`) as 43 characters of
  /// base64url.
  ///
  /// `asBase64Url` pads to 44 characters with `=`, which is outside
  /// RFC 7636's unreserved set, so the padding is stripped. The result
  /// matches `^[A-Za-z0-9_-]{43}$` and is a valid PKCE verifier.
  class generate -> String =>
    (Erlang crypto strong_rand_bytes: 32) asBase64Url replaceAll: "=" with: ""
