/// Callback — a parsed, accepted authorization callback.
///
/// `OAuthFlows handleCallback:store:boundTo:` answers one after it has
/// parsed the redirect's query, consumed the matching `OAuthSession` from
/// the `SessionStore` with the user-agent binding, and checked any RFC 9207
/// `iss` parameter. Pass it to `OAuthFlows exchangeCode:client:callback:store:`.
///
/// It carries a single-use `ticket` that `handleCallback` recorded in the
/// store and the exchange redeems before any network call. A `Callback`
/// built by hand (the keyword constructor is public, as for every Value)
/// or exchanged a second time therefore answers `reused_state`.
///
/// `printString` and `asJson` redact the authorization code and the
/// ticket (and, through the session, the nonce and code verifier).
///
/// ## Examples
/// ```beamtalk
/// cb := (OAuthFlows handleCallback: query store: store boundTo: binding) unwrap
/// cb session issuer      // => "https://gitlab.com"
/// cb printString         // code shows as [redacted]
/// ```
typed Value subclass: Callback
  /// The authorization code.
  field: code :: String = ""
  /// The RFC 9207 `iss` parameter, or nil when the provider sent none.
  field: iss :: String | Nil = nil
  /// The session the callback's `state` named, consumed from the store.
  field: session :: OAuthSession = OAuthSession new
  /// The single-use ticket recorded in the `SessionStore`.
  field: ticket :: String = ""

  /// `Callback(code: [redacted], iss: ..., state: ...)`. The ticket is not
  /// shown.
  printString -> String =>
    "Callback(code: {OAuthError redacted}, iss: {self.iss}, state: {self.session state})"

  /// The JSON shape, with the code redacted.
  asJson -> Dictionary =>
    #{
      "code" => OAuthError redacted,
      "iss" => self.iss,
      "ticket" => OAuthError redacted,
      "session" => self.session asJson
    }
