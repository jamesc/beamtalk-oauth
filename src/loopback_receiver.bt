/// LoopbackReceiver — one-shot loopback callback listener for native apps
/// (RFC 8252 §7.3).
///
/// `start` binds an `HTTPServer` to `127.0.0.1` on an OS-assigned port.
/// The first `GET /callback` carrying the flow's `state` is recorded and
/// answered with a static "you can close this tab" page that echoes no
/// provider data. Any other path or method, any callback with a missing,
/// wrong or repeated `state` (or a repeated `code` or `error`), and any
/// later callback answers 404 without touching the recorded query.
/// Browsers fetch `/favicon.ico` right after the redirect, and any web
/// page or local process can fire a junk `/callback` at the port, so a
/// slot that took the first request would let either block the login.
///
/// ## The expected state
///
/// The receiver learns the flow's `state` from `expectState:`, which must
/// be called before the authorize URL is opened: the redirect can arrive
/// as soon as the browser has the URL, and a callback that arrives before
/// the receiver knows the state is refused (404), not buffered. A native
/// app creates the session, then hands its state over:
///
/// ```beamtalk
/// sess := OAuthSession newSessionFor: server client: reg
/// store create: sess boundTo: rx binding
/// rx expectState: sess state
/// url := (OAuthFlows authorizeUrl: server client: reg scopes: scopes session: sess) unwrap
/// query := (rx awaitCallback: 300000) unwrap
/// ```
///
/// It is a setter rather than `awaitCallback:state:` because the await
/// usually starts after the URL is opened, too late to filter a callback
/// that beats it. `awaitCallback:` without a prior `expectState:` answers
/// a `config` error at once instead of waiting out its timeout.
///
/// One receiver serves one flow: `expectState:` raises when a state is
/// already expected. A timeout reports how many callbacks were refused,
/// so a receiver armed with the wrong state (the binding, or another
/// session's state) shows up as such rather than as a user who never
/// signed in.
///
/// This check only keeps junk from using up the one-shot slot.
/// `OAuthFlows handleCallback:store:boundTo:` still checks the state
/// against the `SessionStore`, and that is what stops a forged code.
///
/// Known limit: `state` is not a secret from the local machine. The
/// authorize URL carrying it can show up in the argv of the process that
/// opens the browser and in browser history, so a local process that
/// reads it can still send a matching junk callback first and use up the
/// slot. It cannot get a forged code accepted (PKCE and the session store
/// stop that), but the login fails and must be retried with a new
/// receiver. Web pages and blind port scans no longer can.
///
/// The receiver owns the per-flow `binding` (`Secrets generate`), so a
/// native app passes `rx binding` to the session store and never makes
/// one itself.
///
/// `awaitCallback:` waits in the calling process, for a message from the
/// handler, not in an actor call: the user may take minutes, and actor
/// calls time out at 5 s. That is why the receiver is a `Value` handle
/// (its methods run in the caller) over two actors, the `HTTPServer` and
/// its `LoopbackGate` handler, which holds the one-shot state.
///
/// The listener stops once `awaitCallback:` answers, either way; `stop`
/// stops it early and is idempotent. A receiver that is never awaited or
/// stopped keeps listening.
///
/// ## Examples
/// ```beamtalk
/// rx := LoopbackReceiver start unwrap
/// rx redirectUri                       // => "http://127.0.0.1:50278/callback"
/// rx binding size                      // => 43
/// rx expectState: sess state           // before opening the authorize URL
/// query := (rx awaitCallback: 300000) unwrap
/// query at: "code"                     // => "..."
/// ```
typed Value subclass: LoopbackReceiver
  /// The listening server.
  field: server :: HTTPServer | Nil = nil
  /// The actor behind the server's request handler, holding the one-shot
  /// callback state.
  field: gate :: LoopbackGate | Nil = nil
  /// The OS-assigned port the server listens on.
  field: port :: Integer = 0
  /// The per-flow session binding.
  field: binding :: String = ""

  /// Start a listener on `127.0.0.1`, port 0 (OS-assigned), with a fresh
  /// binding. Answers a `transport` error when the listener cannot start.
  class start -> Result(LoopbackReceiver, OAuthError) =>
    binding := Secrets generate
    gate := LoopbackGate spawn
    srv := nil
    outcome := Result
      tryDo: [
        srv := HTTPServer
          start: 0
          handler: (self handlerFor: gate)
          options: #{#bind => "127.0.0.1"}
        rx := self new: #{
          #server => srv,
          #gate => gate,
          #port => srv port,
          #binding => binding
        }
        gate expectHost: "127.0.0.1:{rx port}"
        rx
      ]
    outcome
      ifOk: [:rx | Result ok: rx]
      ifError: [:e |
        (self new: #{#server => srv, #gate => gate}) stop
        Result error: (OAuthError transport: "loopback listener failed to start: {e messageText}")
      ]

  /// The server's request handler: a block, so it runs in the connection
  /// process, the only one that can read the raw query string (to spot a
  /// repeated parameter, which `queryParams` hides). It forwards each
  /// request to `gate`, which decides. A failed read raises, so the server
  /// answers 500 and nothing is recorded: the check fails closed.
  class handlerFor: gate :: LoopbackGate -> Block =>
    [:req :: HTTPRequest |
      raw := req exchange isNil ifTrue: [nil] ifFalse: [req exchange query]
      gate handle: req rawQuery: raw
    ]

  /// The largest `awaitCallback:` timeout, in ms: the BEAM's limit for a
  /// receive timeout (about 49 days).
  class maxTimeout -> Integer => 4294967295

  /// Block the calling process until `{#beamtalk_oauth_callback, tag, query}`
  /// arrives from the gate process `gatePid`, `timeoutMs` passes
  /// (`#timeout`) or the gate exits (`#stopped`).
  class await: tag :: Reference from: gatePid :: Pid timeout: timeoutMs :: Integer -> Result(Dictionary, Object) =>
    // `{callback, Query}`, `timeout` or `stopped` from the native module.
    answer := Erlang beamtalk_oauth_loopback
      await: tag
      gate: gatePid
      timeout: timeoutMs
    (answer isKindOf: Tuple) ifTrue: [^Result ok: (answer at: 2)]
    Result error: answer

  /// The redirect URI to register with the provider for this flow:
  /// `http://127.0.0.1:{port}/callback`.
  redirectUri -> String => "http://127.0.0.1:{self.port}/callback"

  /// Record only a callback whose `state` is `expected`, normally
  /// `sess state`. Call it before opening the authorize URL: a callback
  /// that arrives earlier answers 404 and is lost. Answers the receiver.
  /// Raises when `expected` is nil or empty, when a state is already
  /// expected (start a new receiver for another flow), or when the
  /// receiver is stopped.
  expectState: expected :: String -> LoopbackReceiver =>
    self.gate expectState: expected
    self

  /// Wait up to `timeoutMs` for the callback and answer its raw query
  /// (`code`, `state`, or `error` and `error_description`), for
  /// `OAuthFlows handleCallback:store:boundTo:`. A callback that arrived
  /// before the call is answered at once.
  ///
  /// The wait happens in the calling process, which blocks: call this from
  /// a plain or forked process, not from inside an actor method, or that
  /// actor stops answering (and its callers time out) while the user signs
  /// in. The listener is stopped before this answers. Errors:
  ///
  /// - `callback_timeout`: nothing arrived in time; its `detail` is the
  ///   number of callbacks refused for a missing, wrong or repeated
  ///   parameter, also given in the description when it is not 0;
  /// - `config`: a timeout outside `0..maxTimeout`; `expectState:` was
  ///   never called; the receiver was stopped, before or during the wait;
  ///   or another process is already waiting on it. Only in the stopped
  ///   case is the listener gone: otherwise it stays up, and any other
  ///   wait carries on.
  awaitCallback: timeoutMs :: Integer -> Result(Dictionary, OAuthError) =>
    ((timeoutMs < 0) or: [timeoutMs > self class maxTimeout])
      ifTrue: [
        ^Result error: (OAuthError config: "awaitCallback: timeout must be between 0 and {self class maxTimeout} ms")
      ]
    tag := Reference new
    registered := Result tryDo: [self.gate awaitFrom: Pid current tag: tag]
    registered isError
      ifTrue: [
        self stop
        ^Result error: (OAuthError config: "LoopbackReceiver is stopped")
      ]
    registered value =:= #noState
      ifTrue: [
        ^Result error: (OAuthError config: "call expectState: on the LoopbackReceiver before opening the authorize URL")
      ]
    registered value =:= #busy
      ifTrue: [
        ^Result error: (OAuthError config: "another process is already waiting on this LoopbackReceiver")
      ]
    gatePid := self.gate pid
    outcome := self class
      await: tag
      from: gatePid
      timeout: timeoutMs
    refused := 0
    (outcome isError and: [
      outcome error =:= #timeout
    ]) ifTrue: [refused := [self.gate refusedCount] on: Error do: [:e | 0]]
    self stop
    // A callback that raced the timeout may already be in the mailbox:
    // take it, which also leaves no stray message behind.
    (outcome isError and: [outcome error =:= #timeout])
      ifTrue: [
        outcome := self class
          await: tag
          from: gatePid
          timeout: 0
      ]
    outcome
      ifOk: [:query | Result ok: query]
      ifError: [:reason |
        reason =:= #stopped
          ifTrue: [
            Result error: (OAuthError config: "LoopbackReceiver was stopped while waiting")
          ]
          ifFalse: [Result error: (OAuthError callbackTimeoutRefusing: refused)]
      ]

  /// Stop the listener, then its handler. Idempotent: answers `#ok` every
  /// time, like `Actor>>stop`, and never raises, so the handler is stopped
  /// even when the server's shutdown fails. The server gets 10 s, more
  /// than the 5 s its own engine shutdown may take.
  stop -> Symbol =>
    self.server isNil ifFalse: [
      [self.server stopWith: #normal timeout: 10000] on: Error do: [:e | nil]
    ]
    self.gate isNil ifFalse: [[self.gate stop] on: Error do: [:e | nil]]
    #ok

  /// Whether the listener is still accepting connections.
  isListening -> Boolean => self.server notNil and: [self.server isAlive]

  /// `LoopbackReceiver(http://127.0.0.1:{port}/callback)`. The binding is
  /// not shown.
  printString -> String => "LoopbackReceiver({self redirectUri})"

  /// The JSON shape, with the binding redacted.
  asJson -> Dictionary =>
    #{"redirectUri" => self redirectUri, "binding" => OAuthError redacted}
