TestCase subclass: SessionStoreTest
  field: session = nil
  field: binding = nil

  setUp =>
    server := OAuthServer new: #{#issuer => "https://gitlab.com"}
    reg := (ClientRegistration forClient: "app" redirect: "http://127.0.0.1:50278/callback") unwrap
    self.session := OAuthSession newSessionFor: server client: reg
    self.binding := Secrets generate
    self

  /// A store whose clock reads the `clock` actor and whose TTL is 1000 ms.
  storeWith: clock =>
    SessionStore spawnWith: #{#ttl => 1000, #now => [clock time]}

  /// `storeWith:`, plus the spawn options in `options`.
  storeWith: clock options: options =>
    SessionStore spawnWith: ((options at: #ttl put: 1000) at: #now put: [
      clock time
    ])

  /// A fresh session from the same setUp recipe, with another state.
  otherSession =>
    server := OAuthServer new: #{#issuer => "https://gitlab.com"}
    reg := (ClientRegistration forClient: "app" redirect: "http://127.0.0.1:50278/callback") unwrap
    OAuthSession newSessionFor: server client: reg

  /// `term` as `~p` prints it, flattened to a String.
  render: term =>
    Erlang unicode characters_to_binary: (Erlang io_lib format: "~p" with: #(term))

  // === create:boundTo: ===
  testCreateStoresSession =>
    store := SessionStore spawn
    self assert: (store create: self.session boundTo: self.binding) isOk
    self assert: store size equals: 1

  testCreateAnswersStampedSession =>
    clock := FakeClock spawnWith: #{#time => 7000}
    store := self storeWith: clock
    stored := (store create: self.session boundTo: self.binding) unwrap
    self assert: stored createdAt equals: 7000
    self assert: stored state equals: self.session state

  testCreateStampsCreatedAt =>
    clock := FakeClock spawnWith: #{#time => 5000}
    store := self storeWith: clock
    store create: self.session boundTo: self.binding
    got := (store consume: self.session state boundTo: self.binding) unwrap
    self assert: got createdAt equals: 5000
    self assert: got state equals: self.session state
    self assert: got codeVerifier equals: self.session codeVerifier

  testCreateWithSystemClockStampsNow =>
    store := SessionStore spawn
    before := Erlang erlang system_time: #millisecond
    store create: self.session boundTo: self.binding
    got := (store consume: self.session state boundTo: self.binding) unwrap
    self assert: got createdAt >= before

  testCreateWithNilBindingRaises =>
    store := SessionStore spawn
    @expect type
    self should: [store create: self.session boundTo: nil] raise: #user_error
    self assert: store size equals: 0

  testCreateWithEmptyBindingRaises =>
    store := SessionStore spawn
    self should: [store create: self.session boundTo: ""] raise: #user_error
    self assert: store size equals: 0

  testCreateWithoutStateRaises =>
    store := SessionStore spawn
    self should: [
      store create: (self.session withState: "") boundTo: self.binding
    ] raise: #user_error

  testCreateWithStateAsBindingRaises =>
    store := SessionStore spawn
    self should: [
      store create: self.session boundTo: self.session state
    ] raise: #user_error
    self assert: store size equals: 0

  testCreateDuplicateStateRaises =>
    store := SessionStore spawn
    store create: self.session boundTo: self.binding
    self should: [
      store create: self.session boundTo: Secrets generate
    ] raise: #user_error
    // The original binding still holds.
    self assert: (store consume: self.session state boundTo: self.binding) isOk

  testNoCreateWithoutBinding =>
    self deny: (SessionStore canUnderstand: #create:)
    self deny: (SessionStore canUnderstand: #consume:)

  testSpawnRejectsBadTtl =>
    self should: [
      SessionStore spawnWith: #{#ttl => 0}
    ] raise: #instantiation_error
    @expect type
    self should: [
      SessionStore spawnWith: #{#ttl => nil}
    ] raise: #instantiation_error

  testSpawnRejectsBadMaxSessions =>
    self should: [
      SessionStore spawnWith: #{#maxSessions => 0}
    ] raise: #instantiation_error
    @expect type
    self should: [
      SessionStore spawnWith: #{#maxSessions => "many"}
    ] raise: #instantiation_error

  testSpawnRejectsBadSweepEvery =>
    self should: [
      SessionStore spawnWith: #{#sweepEvery => 0}
    ] raise: #instantiation_error
    @expect type
    self should: [
      SessionStore spawnWith: #{#sweepEvery => nil}
    ] raise: #instantiation_error

  testDefaultCapAndSweepInterval =>
    self assert: SessionStore defaultMaxSessions equals: 10000
    self assert: SessionStore defaultSweepEvery equals: 64
    store := SessionStore spawn
    self assert: (store fieldAt: #maxSessions) equals: 10000
    self assert: (store fieldAt: #sweepEvery) equals: 64

  testSpawnRejectsBadClock =>
    @expect type
    self should: [
      SessionStore spawnWith: #{#now => 42}
    ] raise: #instantiation_error

  testDefaultTtlIsTenMinutes =>
    self assert: SessionStore defaultTtl equals: 600000
    clock := FakeClock spawnWith: #{#time => 0}
    store := SessionStore spawnWith: #{#now => [clock time]}
    store create: self.session boundTo: self.binding
    clock time: 599999
    self assert: (store consume: self.session state boundTo: self.binding) isOk
    late := self otherSession
    store create: late boundTo: self.binding
    clock time: 599999 + 600000
    self assert: (store consume: late state boundTo: self.binding) error code equals: "expired_session"

  // === consume:boundTo: ===
  testConsumeAnswersSessionOnce =>
    store := SessionStore spawn
    store create: self.session boundTo: self.binding
    first := store consume: self.session state boundTo: self.binding
    self assert: first isOk
    self assert: first unwrap nonce equals: self.session nonce
    self assert: store size equals: 0
    second := store consume: self.session state boundTo: self.binding
    self assert: second isError
    self assert: second error code equals: "reused_state"

  testConsumeUnknownStateIsReused =>
    store := SessionStore spawn
    out := store consume: Secrets generate boundTo: self.binding
    self assert: out error code equals: "reused_state"

  testConsumeWithNilBindingRaises =>
    store := SessionStore spawn
    store create: self.session boundTo: self.binding
    @expect type
    self should: [
      store consume: self.session state boundTo: nil
    ] raise: #user_error
    self should: [
      store consume: self.session state boundTo: ""
    ] raise: #user_error
    // A raising consume does not burn the session.
    self assert: (store consume: self.session state boundTo: self.binding) isOk

  testConsumeMismatchFailsAndBurns =>
    store := SessionStore spawn
    store create: self.session boundTo: self.binding
    probe := store consume: self.session state boundTo: Secrets generate
    self assert: probe error code equals: "session_mismatch"
    self assert: store size equals: 0
    // The rightful owner cannot complete either: the probe burned it.
    retry := store consume: self.session state boundTo: self.binding
    self assert: retry error code equals: "reused_state"

  testConsumeMismatchOfDifferentLength =>
    store := SessionStore spawn
    store create: self.session boundTo: self.binding
    probe := store consume: self.session state boundTo: "x"
    self assert: probe error code equals: "session_mismatch"

  testConsumeExpiredMismatchReportsMismatch =>
    clock := FakeClock spawnWith: #{#time => 0}
    store := self storeWith: clock
    store create: self.session boundTo: self.binding
    clock time: 1500
    // The wrong binding never learns that the session expired.
    out := store consume: self.session state boundTo: Secrets generate
    self assert: out error code equals: "session_mismatch"

  testConsumeExpiredSession =>
    clock := FakeClock spawnWith: #{#time => 0}
    store := self storeWith: clock
    store create: self.session boundTo: self.binding
    clock time: 1000
    out := store consume: self.session state boundTo: self.binding
    self assert: out error code equals: "expired_session"
    // Expiry burns the session too.
    again := store consume: self.session state boundTo: self.binding
    self assert: again error code equals: "reused_state"

  testConsumeJustBeforeTtl =>
    clock := FakeClock spawnWith: #{#time => 0}
    store := self storeWith: clock
    store create: self.session boundTo: self.binding
    clock time: 999
    self assert: (store consume: self.session state boundTo: self.binding) isOk

  // === peek:boundTo: ===
  testPeekAnswersSessionAndKeepsIt =>
    store := SessionStore spawn
    store create: self.session boundTo: self.binding
    got := (store peek: self.session state boundTo: self.binding) unwrap
    self assert: got issuer equals: "https://gitlab.com"
    self assert: store size equals: 1
    self assert: (store consume: self.session state boundTo: self.binding) isOk

  testPeekFailuresBurnNothing =>
    clock := FakeClock spawnWith: #{#time => 0}
    store := self storeWith: clock
    store create: self.session boundTo: self.binding
    self assert: (store peek: Secrets generate boundTo: self.binding) error code equals: "reused_state"
    self assert: (store peek: self.session state boundTo: Secrets generate) error code equals: "session_mismatch"
    self assert: store size equals: 1
    clock time: 1000
    self assert: (store peek: self.session state boundTo: self.binding) error code equals: "expired_session"
    self assert: store size equals: 1

  testPeekWithEmptyBindingRaises =>
    store := SessionStore spawn
    store create: self.session boundTo: self.binding
    self should: [store peek: self.session state boundTo: ""] raise: #user_error
    self assert: store size equals: 1

  testConsumeOnlyTakesItsOwnSession =>
    store := SessionStore spawn
    other := self otherSession
    otherBinding := Secrets generate
    store create: self.session boundTo: self.binding
    store create: other boundTo: otherBinding
    self assert: (store consume: self.session state boundTo: otherBinding) error code equals: "session_mismatch"
    got := (store consume: other state boundTo: otherBinding) unwrap
    self assert: got state equals: other state

  // === sweep ===
  testSweepDropsAbandonedSessions =>
    clock := FakeClock spawnWith: #{#time => 0}
    store := self storeWith: clock options: #{#sweepEvery => 1}
    store create: self.session boundTo: self.binding
    clock time: 900
    late := self otherSession
    store create: late boundTo: self.binding
    self assert: store size equals: 2
    clock time: 2000
    fresh := self otherSession
    store create: fresh boundTo: self.binding
    // The first session is two TTLs old: swept. `late` is expired but
    // within the grace, so it is kept and reported as expired.
    self assert: store size equals: 2
    out := store consume: self.session state boundTo: self.binding
    self assert: out error code equals: "reused_state"
    self assert: (store consume: late state boundTo: self.binding) error code equals: "expired_session"
    self assert: (store consume: fresh state boundTo: self.binding) isOk

  testSweepRunsOnConsume =>
    clock := FakeClock spawnWith: #{#time => 0}
    store := self storeWith: clock options: #{#sweepEvery => 1}
    store create: self.session boundTo: self.binding
    clock time: 5000
    store consume: Secrets generate boundTo: self.binding
    self assert: store size equals: 0

  testSweepRunsEveryKCalls =>
    clock := FakeClock spawnWith: #{#time => 0}
    store := self storeWith: clock options: #{#sweepEvery => 3}
    store create: self.session boundTo: self.binding
    clock time: 5000
    store consume: Secrets generate boundTo: self.binding
    // Two calls so far: no sweep yet.
    self assert: store size equals: 1
    store consume: Secrets generate boundTo: self.binding
    self assert: store size equals: 0

  testSweepCountsTicketCalls =>
    clock := FakeClock spawnWith: #{#time => 0}
    store := self storeWith: clock options: #{#sweepEvery => 3}
    store create: self.session boundTo: self.binding
    store issueTicket: Secrets generate forState: self.session state
    clock time: 5000
    store redeemTicket: Secrets generate forState: self.session state
    self assert: store size equals: 0
    self assert: store ticketCount equals: 0

  testStaleUnsweptSessionIsReused =>
    clock := FakeClock spawnWith: #{#time => 0}
    store := self storeWith: clock
    store create: self.session boundTo: self.binding
    clock time: 2000
    // Past the grace but not yet swept: the same answer as once swept.
    self assert: store size equals: 1
    out := store consume: self.session state boundTo: self.binding
    self assert: out error code equals: "reused_state"
    self assert: store size equals: 0

  testStaleUnsweptTicketIsReused =>
    clock := FakeClock spawnWith: #{#time => 0}
    store := self storeWith: clock
    ticket := Secrets generate
    store issueTicket: ticket forState: self.session state
    clock time: 1500
    out := store redeemTicket: ticket forState: self.session state
    self assert: out error code equals: "expired_session"
    other := Secrets generate
    store issueTicket: other forState: self.session state
    clock time: 3500
    self assert: (store redeemTicket: other forState: self.session state) error code equals: "reused_state"

  // === size cap ===
  testCapRejects =>
    clock := FakeClock spawnWith: #{#time => 0}
    store := self storeWith: clock options: #{#maxSessions => 2}
    self assert: (store create: self.session boundTo: self.binding) isOk
    self assert: (store create: self otherSession boundTo: self.binding) isOk
    extra := self otherSession
    out := store create: extra boundTo: self.binding
    self assert: out isError
    self assert: out error code equals: "session_store_full"
    self assert: store size equals: 2
    // Nothing was stored for the refused login.
    self assert: (store consume: extra state boundTo: self.binding) error code equals: "reused_state"

  testFullStoreWithCodePointStampsRefuses =>
    // Stamps that are all Unicode code points once crossed the FFI as a
    // charlist (a String) when the full store looked for its oldest row.
    clock := FakeClock spawnWith: #{#time => 1000}
    store := self storeWith: clock options: #{#maxSessions => 1}
    store create: self.session boundTo: self.binding
    self assert: (store create: self otherSession boundTo: self.binding) error code equals: "session_store_full"

  testCapKeepsLiveSessions =>
    clock := FakeClock spawnWith: #{#time => 0}
    store := self storeWith: clock options: #{#maxSessions => 1}
    store create: self.session boundTo: self.binding
    clock time: 999
    self assert: (store create: self otherSession boundTo: self.binding) error code equals: "session_store_full"
    self assert: (store consume: self.session state boundTo: self.binding) isOk

  testFullStoreDropsExpiredSessions =>
    clock := FakeClock spawnWith: #{#time => 0}
    store := self storeWith: clock options: #{#maxSessions => 1}
    store create: self.session boundTo: self.binding
    // Expired, though within the grace: it can never complete, so a full
    // store drops it to make room.
    clock time: 1000
    fresh := self otherSession
    self assert: (store create: fresh boundTo: self.binding) isOk
    self assert: (store consume: self.session state boundTo: self.binding) error code equals: "reused_state"
    self assert: (store consume: fresh state boundTo: self.binding) isOk

  testSweepFreesRoomWhenFull =>
    clock := FakeClock spawnWith: #{#time => 0}
    store := self storeWith: clock options: #{#maxSessions => 2}
    store create: self.session boundTo: self.binding
    store create: self otherSession boundTo: self.binding
    clock time: 2000
    // Full, but both sessions are past the grace: the full store sweeps
    // before it refuses, though the call count is far from #sweepEvery.
    fresh := self otherSession
    self assert: (store create: fresh boundTo: self.binding) isOk
    self assert: store size equals: 1
    self assert: (store consume: fresh state boundTo: self.binding) isOk

  testFullStoreSkipsSweepUntilOldestExpires =>
    clock := FakeClock spawnWith: #{#time => 0}
    store := self storeWith: clock options: #{#maxSessions => 2}
    store create: self.session boundTo: self.binding
    clock time: 500
    second := self otherSession
    store create: second boundTo: self.binding
    clock time: 600
    self assert: (store create: self otherSession boundTo: self.binding) error code equals: "session_store_full"
    // The oldest session expires at 0 + ttl: refused without a sweep until
    // then.
    self assert: (store fieldAt: #fullUntil) values asList equals: #(1000)
    clock time: 999
    self assert: (store create: self otherSession boundTo: self.binding) error code equals: "session_store_full"
    clock time: 1000
    third := self otherSession
    self assert: (store create: third boundTo: self.binding) isOk
    self assert: store size equals: 2
    // Full again: the next sweep waits a tenth of a TTL, though `second`
    // expires first.
    self assert: (store fieldAt: #fullUntil) values asList equals: #(1100)
    clock time: 1050
    self assert: (store create: self otherSession boundTo: self.binding) error code equals: "session_store_full"
    clock time: 1500
    self assert: (store create: self otherSession boundTo: self.binding) isOk
    self assert: (store consume: second state boundTo: self.binding) error code equals: "reused_state"
    self assert: (store consume: third state boundTo: self.binding) isOk

  testConsumeFreesSlotBeforeFullUntil =>
    clock := FakeClock spawnWith: #{#time => 0}
    store := self storeWith: clock options: #{#maxSessions => 1}
    store create: self.session boundTo: self.binding
    late := self otherSession
    self assert: (store create: late boundTo: self.binding) error code equals: "session_store_full"
    store consume: self.session state boundTo: self.binding
    // fullUntil is far off, but the store has room: no sweep needed.
    self assert: (store create: late boundTo: self.binding) isOk
    self assert: (store create: self otherSession boundTo: self.binding) error code equals: "session_store_full"
    self assert: (store consume: late state boundTo: self.binding) isOk

  testFullUntilIsPerTable =>
    clock := FakeClock spawnWith: #{#time => 0}
    store := self storeWith: clock options: #{#maxSessions => 1}
    store create: self.session boundTo: self.binding
    self assert: (store create: self otherSession boundTo: self.binding) isError
    // A full session table does not hold back tickets.
    self assert: store hasTicketRoom
    store issueTicket: Secrets generate forState: self.session state
    self deny: store hasTicketRoom
    self assert: (store fieldAt: #fullUntil) size equals: 2

  testConsumeWorksWhenFull =>
    store := SessionStore spawnWith: #{#maxSessions => 1}
    store create: self.session boundTo: self.binding
    late := self otherSession
    self assert: (store create: late boundTo: self.binding) error code equals: "session_store_full"
    got := store consume: self.session state boundTo: self.binding
    self assert: got isOk
    // The consume freed the slot.
    self assert: (store create: late boundTo: self.binding) isOk

  testTicketCapIsSeparate =>
    store := SessionStore spawnWith: #{#maxSessions => 1}
    store create: self.session boundTo: self.binding
    // A full session table does not stop a ticket.
    first := Secrets generate
    self assert: (store issueTicket: first forState: self.session state) isOk
    self assert: store ticketCount equals: 1
    second := Secrets generate
    out := store issueTicket: second forState: self.session state
    self assert: out error code equals: "session_store_full"
    self assert: store ticketCount equals: 1
    self assert: (store redeemTicket: first forState: self.session state) isOk
    self assert: (store issueTicket: second forState: self.session state) isOk

  testTicketSweepFreesRoomWhenFull =>
    clock := FakeClock spawnWith: #{#time => 0}
    store := self storeWith: clock options: #{#maxSessions => 1}
    store issueTicket: Secrets generate forState: self.session state
    clock time: 1000
    self assert: (store issueTicket: Secrets generate forState: self.session state) isOk
    self assert: store ticketCount equals: 1

  // === redaction ===
  testStatusRedactsSessionsAndBindings =>
    store := SessionStore spawn
    s := self.session
    store create: s boundTo: self.binding
    status := Erlang sys get_status: store pid
    text := self render: status
    self assert: (text includesSubstring: "#Ref<")
    self deny: (text includesSubstring: s state)
    self deny: (text includesSubstring: s nonce)
    self deny: (text includesSubstring: s codeVerifier)
    self deny: (text includesSubstring: self.binding)

  testStateRedactsSessionsAndBindings =>
    store := SessionStore spawn
    s := self.session
    store create: s boundTo: self.binding
    st := Erlang sys get_state: store pid
    text := self render: st
    self deny: (text includesSubstring: s state)
    self deny: (text includesSubstring: s codeVerifier)
    self deny: (text includesSubstring: self.binding)

  testSecretSelectorsCoverEverySecretMessage =>
    secret := SessionStore secretSelectors
    #(#create:boundTo:, #restore:boundTo:, #consume:boundTo:, #peek:boundTo:, #issueTicket:forState:, #redeemTicket:forState:) do: [:sel |
      self assert: (secret includes: sel)
    ]

  // BT-4567: with `sys:log` on, the formatted status (the part OTP passes
  // through format_status/1) redacts the arguments and replies of the
  // secret selectors. OTP's raw debug term beside it is not covered.
  testSysLogRedactsSecretSends =>
    store := SessionStore spawn
    s := self.session
    Erlang sys log: store pid with: true
    store create: s boundTo: self.binding
    (store consume: s state boundTo: self.binding) unwrap
    status := Erlang sys get_status: store pid
    misc := (Erlang erlang element: 4 with: status) last
    text := self render: misc
    self assert: (text includesSubstring: "consume:boundTo:")
    self deny: (text includesSubstring: s nonce)
    self deny: (text includesSubstring: s codeVerifier)
    self deny: (text includesSubstring: s state)
    self deny: (text includesSubstring: self.binding)

  testTableIsPrivate =>
    store := SessionStore spawn
    store create: self.session boundTo: self.binding
    table := store fieldAt: #table
    self assert: (Erlang ets info: table with: #protection) equals: #private
    self assert: (Erlang ets info: table with: #size) equals: 1
    // FFI wraps ets's badarg as a type_error.
    self should: [Erlang ets tab2list: table] raise: #type_error

  // === restore:boundTo: (BT-4572) ===
  testRestorePutsTheSameSessionBack =>
    clock := FakeClock spawnWith: #{#time => 1000}
    store := self storeWith: clock
    store create: self.session boundTo: self.binding
    taken := (store consume: self.session state boundTo: self.binding) unwrap
    clock time: 1400
    self assert: (store restore: taken boundTo: self.binding) isOk
    self assert: store size equals: 1
    // Still bound: another binding burns it.
    self assert: (store consume: self.session state boundTo: Secrets generate) error code equals: "session_mismatch"

  testRestoredSessionKeepsItsVerifierAndNonce =>
    store := SessionStore spawn
    store create: self.session boundTo: self.binding
    taken := (store consume: self.session state boundTo: self.binding) unwrap
    (store restore: taken boundTo: self.binding) unwrap
    again := (store consume: self.session state boundTo: self.binding) unwrap
    self assert: again codeVerifier equals: self.session codeVerifier
    self assert: again nonce equals: self.session nonce
    self assert: again createdAt equals: taken createdAt

  testRestoreDoesNotExtendTheTtl =>
    clock := FakeClock spawnWith: #{#time => 1000}
    store := self storeWith: clock
    store create: self.session boundTo: self.binding
    taken := (store consume: self.session state boundTo: self.binding) unwrap
    clock time: 1900
    (store restore: taken boundTo: self.binding) unwrap
    // Created at 1000 with a 1000 ms TTL: expired at 2000, restore or not.
    clock time: 2000
    self assert: (store consume: self.session state boundTo: self.binding) error code equals: "expired_session"

  testRestoreWithSystemClockKeepsTheExpiry =>
    // Wide margins: test classes run concurrently, so a tight TTL flakes.
    store := SessionStore spawnWith: #{#ttl => 1000}
    store create: self.session boundTo: self.binding
    taken := (store consume: self.session state boundTo: self.binding) unwrap
    Timer sleep: 300
    (store restore: taken boundTo: self.binding) unwrap
    Timer sleep: 900
    self assert: (store consume: self.session state boundTo: self.binding) error code equals: "expired_session"

  testRestoreOfAnExpiredSessionStoresNothing =>
    clock := FakeClock spawnWith: #{#time => 1000}
    store := self storeWith: clock
    store create: self.session boundTo: self.binding
    taken := (store consume: self.session state boundTo: self.binding) unwrap
    clock time: 2000
    self assert: (store restore: taken boundTo: self.binding) error code equals: "expired_session"
    self assert: store size equals: 0

  testRestoreWithAFutureCreatedAtCountsAsNow =>
    clock := FakeClock spawnWith: #{#time => 1000}
    store := self storeWith: clock
    (store restore: (self.session withCreatedAt: 999999) boundTo: self.binding) unwrap
    clock time: 2000
    self assert: (store consume: self.session state boundTo: self.binding) error code equals: "expired_session"

  testRestoreIntoAFullStoreAnswersFull =>
    clock := FakeClock spawnWith: #{#time => 1000}
    store := self storeWith: clock options: #{#maxSessions => 1}
    store create: self.session boundTo: self.binding
    taken := (store consume: self.session state boundTo: self.binding) unwrap
    store create: self otherSession boundTo: self.binding
    self assert: (store restore: taken boundTo: self.binding) error code equals: "session_store_full"
    self assert: store size equals: 1

  testRestoreOfAStoredStateRaises =>
    store := SessionStore spawn
    stored := (store create: self.session boundTo: self.binding) unwrap
    self should: [
      store restore: stored boundTo: self.binding
    ] raise: #user_error
