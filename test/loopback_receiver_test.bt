// HTTPClient plays the browser.
TestCase subclass: LoopbackReceiverTest
  field: rx = nil

  setUp => self.rx := LoopbackReceiver start unwrap expectState: self expected

  /// The state every test flow expects.
  expected => "flow-state-1"

  tearDown =>
    self.rx stop
    self

  /// GET `path` (with any query) on the receiver's listener.
  browse: path => HTTPClient get: "http://127.0.0.1:{self.rx port}{path}"

  /// GET `/callback` with `query` and the expected state.
  callback: query => self browse: "/callback?{query}&state={self expected}"

  testRedirectUriIsLoopbackOnEphemeralPort =>
    self assert: self.rx port > 0
    self assert: self.rx redirectUri equals: "http://127.0.0.1:{self.rx port}/callback"

  testEachReceiverGetsItsOwnPort =>
    other := LoopbackReceiver start unwrap
    self deny: other port =:= self.rx port
    other stop

  testBindingIsAFreshSecret =>
    other := LoopbackReceiver start unwrap
    self assert: self.rx binding size equals: 43
    self assert: (self.rx binding matchesRegex: "^[A-Za-z0-9_-]+$")
    self deny: other binding =:= self.rx binding
    other stop

  testPrintStringAndJsonHideBinding =>
    self deny: (self.rx printString includesSubstring: self.rx binding)
    self deny: ((Json generate: self.rx) includesSubstring: self.rx binding)
    self assert: (self.rx printString includesSubstring: self.rx redirectUri)

  testCallbackIsDelivered =>
    resp := (self callback: "code=abc123") unwrap
    self assert: resp status equals: 200
    self assert: (resp body includesSubstring: "close this tab")
    query := (self.rx awaitCallback: 5000) unwrap
    self assert: (query at: "code") equals: "abc123"
    self assert: (query at: "state") equals: self expected

  testCloseTabPageEchoesNoProviderData =>
    resp := (self callback: "code=SECRETCODE&error_description=EVIL") unwrap
    self assert: resp status equals: 200
    self deny: (resp body includesSubstring: "SECRETCODE")
    self deny: (resp body includesSubstring: self expected)
    self deny: (resp body includesSubstring: "EVIL")

  testProviderErrorQueryIsDeliveredRaw =>
    self callback: "error=access_denied"
    query := (self.rx awaitCallback: 5000) unwrap
    self assert: (query at: "error") equals: "access_denied"

  testFaviconBeforeCallbackDoesNotBlockIt =>
    resp := (self browse: "/favicon.ico") unwrap
    self assert: resp status equals: 404
    self callback: "code=first"
    query := (self.rx awaitCallback: 5000) unwrap
    self assert: (query at: "code") equals: "first"

  testFaviconAfterCallbackDoesNotOverwriteIt =>
    self callback: "code=first"
    resp := (self browse: "/favicon.ico?code=second") unwrap
    self assert: resp status equals: 404
    query := (self.rx awaitCallback: 5000) unwrap
    self assert: (query at: "code") equals: "first"

  testSecondCallbackAnswers404 =>
    self callback: "code=first"
    resp := (self callback: "code=second") unwrap
    self assert: resp status equals: 404
    query := (self.rx awaitCallback: 5000) unwrap
    self assert: (query at: "code") equals: "first"

  testOtherMethodOnCallbackAnswers404 =>
    resp := (HTTPClient post: "http://127.0.0.1:{self.rx port}/callback?code=posted&state={self expected}" body: "") unwrap
    self assert: resp status equals: 404
    self callback: "code=got"
    query := (self.rx awaitCallback: 5000) unwrap
    self assert: (query at: "code") equals: "got"

  testAwaitWaitsForALaterCallback =>
    url := self.rx redirectUri ++ "?code=late&state={self expected}"
    [
      Timer sleep: 200
      HTTPClient get: url
    ] fork
    query := (self.rx awaitCallback: 5000) unwrap
    self assert: (query at: "code") equals: "late"

  testTimeoutAnswersCallbackTimeout =>
    outcome := self.rx awaitCallback: 50
    self assert: outcome isError
    self assert: outcome error code equals: "callback_timeout"

  testListenerIsClosedAfterTimeout =>
    self.rx awaitCallback: 50
    self deny: self.rx isListening
    self assert: (self callback: "code=x") isError

  testListenerIsClosedAfterCallback =>
    self callback: "code=x"
    (self.rx awaitCallback: 5000) unwrap
    self deny: self.rx isListening
    self assert: (self callback: "code=y") isError

  testStopIsIdempotent =>
    self assert: self.rx isListening
    self assert: self.rx stop equals: #ok
    self assert: self.rx stop equals: #ok
    self deny: self.rx isListening

  testAwaitAfterStopAnswersConfigError =>
    self.rx stop
    outcome := self.rx awaitCallback: 50
    self assert: outcome isError
    self assert: outcome error code equals: "config"

  testNegativeTimeoutAnswersConfigError =>
    outcome := self.rx awaitCallback: -1
    self assert: outcome error code equals: "config"

  testKeptAliveBrowserConnectionDoesNotStallShutdown =>
    // Browsers keep the connection open after the redirect; stopping the
    // listener must not wait out the engine's drain on it.
    browser := HTTPClient spawnWith: #{
      #baseUrl => "http://127.0.0.1:{self.rx port}"
    }
    (browser get: "/favicon.ico") unwrap
    (browser get: "/callback?code=kept&state={self expected}") unwrap
    t0 := Erlang erlang monotonic_time: #millisecond
    query := (self.rx awaitCallback: 5000) unwrap
    elapsed := (Erlang erlang monotonic_time: #millisecond) - t0
    browser stop
    self assert: (query at: "code") equals: "kept"
    self assert: elapsed < 2000

  testHeadOnCallbackAnswers404AndKeepsTheSlot =>
    resp := (HTTPClient
      request: #HEAD
      url: self.rx redirectUri ++ "?code=head&state={self expected}"
      options: #{}) unwrap
    self assert: resp status equals: 404
    self callback: "code=got"
    query := (self.rx awaitCallback: 5000) unwrap
    self assert: (query at: "code") equals: "got"

  testNearMissPathsAnswer404AndKeepTheSlot =>
    #("/callback/?code=a", "/Callback?code=b", "/callbackx?code=c")
      do: [:path |
        self assert: (self browse: path ++ "&state={self expected}") unwrap status equals: 404
      ]
    self callback: "code=got"
    query := (self.rx awaitCallback: 5000) unwrap
    self assert: (query at: "code") equals: "got"

  testForeignHostAnswers404AndKeepsTheSlot =>
    // HTTPClient always sends its own Host, so drive the gate directly.
    gate := LoopbackGate spawn
    gate expectHost: "127.0.0.1:4000"
    gate expectState: "s1"
    rebound := HTTPRequest
      new: #{
        #method => "GET",
        #path => "/callback",
        #headers => #(#("host", "evil.example:4000")),
        #queryParams => #{"code" => "rebound", "state" => "s1"}
      }
    raw := "code=rebound&state=s1"
    self assert: (gate handle: rebound rawQuery: raw) status equals: 404
    good := rebound withHeaders: #(#("Host", "127.0.0.1:4000"))
    self assert: (gate handle: good rawQuery: raw) status equals: 200
    gate stop

  testCloseTabPageForbidsScriptsAndFraming =>
    resp := (self callback: "code=x") unwrap
    csp := resp headers detect: [:h |
      (h at: 1) lowercase =:= "content-security-policy"
    ] ifNone: [nil]
    self assert: csp notNil
    self assert: ((csp at: 2) includesSubstring: "frame-ancestors 'none'")

  testAwaitFromAnotherProcess =>
    // The receiver need not be awaited by the process that started it.
    self callback: "code=elsewhere"
    me := Pid current
    tag := Reference new
    rx := self.rx
    worker := [
      query := (rx awaitCallback: 5000) unwrap
      me send: {#beamtalk_oauth_callback, tag, query}
    ] fork
    reply := (LoopbackReceiver
      await: tag
      from: worker
      timeout: 5000) unwrap
    self assert: (reply at: "code") equals: "elsewhere"
    self deny: rx isListening

  testStopWhileWaitingEndsTheWaitPromptly =>
    rx := self.rx
    [
      Timer sleep: 200
      rx stop
    ] fork
    t0 := Erlang erlang monotonic_time: #millisecond
    outcome := self.rx awaitCallback: 5000
    elapsed := (Erlang erlang monotonic_time: #millisecond) - t0
    self assert: outcome error code equals: "config"
    self assert: elapsed < 3000

  testSecondConcurrentWaiterIsRefused =>
    rx := self.rx
    [rx awaitCallback: 3000] fork
    Timer sleep: 200
    outcome := self.rx awaitCallback: 50
    self assert: outcome error code equals: "config"
    self assert: self.rx isListening

  testAwaitAfterSuccessAnswersConfigError =>
    self callback: "code=x"
    (self.rx awaitCallback: 5000) unwrap
    self assert: (self.rx awaitCallback: 50) error code equals: "config"

  testAwaitZeroTakesAnArrivedCallback =>
    self callback: "code=ready"
    self assert: ((self.rx awaitCallback: 0) unwrap at: "code") equals: "ready"

  testOversizedTimeoutAnswersConfigError =>
    outcome := self.rx awaitCallback: LoopbackReceiver maxTimeout + 1
    self assert: outcome error code equals: "config"
    self assert: self.rx isListening

  testNoStrayMessagesAfterTimeoutOrCallback =>
    before := Erlang beamtalk_oauth_loopback mailbox_size
    self.rx awaitCallback: 20
    other := LoopbackReceiver start unwrap
    other expectState: "other-state"
    HTTPClient get: other redirectUri ++ "?code=x&state=other-state"
    (other awaitCallback: 5000) unwrap
    self assert: (Erlang beamtalk_oauth_loopback mailbox_size) equals: before

  // --- BT-4569: only a callback carrying the flow's state is recorded ---
  testJunkCallbacksBeforeTheRealOneDoNotBlockIt =>
    junk := #("/callback", "/callback?code=junk", "/callback?code=junk&state=wrong", "/callback?error=access_denied", "/callback?state=", "/callback?state")
    junk do: [:path |
      self assert: (self browse: path) unwrap status equals: 404
    ]
    self assert: (self callback: "code=real") unwrap status equals: 200
    query := (self.rx awaitCallback: 5000) unwrap
    self assert: (query at: "code") equals: "real"

  testStatePrefixOrExtensionIsRefused =>
    #("flow-state-", "flow-state-12", "FLOW-STATE-1", "flow-state-1%00")
      do: [:st |
        self assert: (self browse: "/callback?code=junk&state={st}") unwrap status equals: 404
      ]
    self callback: "code=real"
    self assert: ((self.rx awaitCallback: 5000) unwrap at: "code") equals: "real"

  testProviderErrorWithWrongStateIsRefused =>
    resp := (self browse: "/callback?error=access_denied&state=wrong") unwrap
    self assert: resp status equals: 404
    self callback: "error=consent_required"
    query := (self.rx awaitCallback: 5000) unwrap
    self assert: (query at: "error") equals: "consent_required"

  testDuplicateParametersAreRefusedAndKeepTheSlot =>
    st := self expected
    dupes := #("/callback?state=wrong&state={st}&code=a", "/callback?state={st}&state={st}&code=b", "/callback?code=c1&code=c2&state={st}", "/callback?error=e1&error=e2&state={st}", "/callback?code=d&error=access_denied&error=x&state={st}", "/callback?code=e&iss=a&iss=b&state={st}", "/callback?code=f&st%61te=wrong&state={st}", "/callback?code=g&%73tate={st}&state={st}", "/callback?error=e&error_description=a&error_description=b&state={st}", "/callback?error=e&error_uri=a&error_uri=b&state={st}", "/callback?error=e&iss=a&iss=b&state={st}")
    dupes do: [:path |
      self assert: (self browse: path) unwrap status equals: 404
    ]
    self callback: "code=real"
    self assert: ((self.rx awaitCallback: 5000) unwrap at: "code") equals: "real"

  testOtherRepeatedParametersAreAllowed =>
    self callback: "code=ok&scope=a&scope=b"
    self assert: ((self.rx awaitCallback: 5000) unwrap at: "code") equals: "ok"

  testAwaitWithoutExpectedStateAnswersConfigError =>
    other := LoopbackReceiver start unwrap
    outcome := other awaitCallback: 5000
    self assert: outcome error code equals: "config"
    self assert: (outcome error description includesSubstring: "expectState:")
    self assert: other isListening
    other stop

  testCallbackBeforeExpectStateIsRefused =>
    other := LoopbackReceiver start unwrap
    early := (HTTPClient get: other redirectUri ++ "?code=early&state=s9") unwrap
    self assert: early status equals: 404
    other expectState: "s9"
    self assert: (HTTPClient get: other redirectUri ++ "?code=late&state=s9") unwrap status equals: 200
    self assert: ((other awaitCallback: 5000) unwrap at: "code") equals: "late"

  testExpectStateAnswersTheReceiver =>
    other := LoopbackReceiver start unwrap
    self assert: (other expectState: "s") port equals: other port
    other stop

  testExpectStateRefusesAnEmptyState =>
    self should: [self.rx expectState: ""] raise: #user_error
    self should: [self.rx expectState: nil] raise: #user_error
    // The earlier expected state still holds.
    self callback: "code=still"
    self assert: ((self.rx awaitCallback: 5000) unwrap at: "code") equals: "still"

  testExpectStateTwiceRaisesAndKeepsTheFirst =>
    self should: [self.rx expectState: "another-flow"] raise: #user_error
    self should: [self.rx expectState: self expected] raise: #user_error
    resp := (self browse: "/callback?code=x&state=another-flow") unwrap
    self assert: resp status equals: 404
    self callback: "code=first-flow"
    self assert: ((self.rx awaitCallback: 5000) unwrap at: "code") equals: "first-flow"

  testExpectStateOnAStoppedReceiverRaises =>
    other := LoopbackReceiver start unwrap
    other stop
    self should: [other expectState: "s"] raise: #actor_dead

  testPercentEncodedStateMatches =>
    other := LoopbackReceiver start unwrap
    other expectState: "a+b/c d"
    resp := (HTTPClient get: other redirectUri ++ "?code=enc&state=a%2Bb%2Fc+d") unwrap
    self assert: resp status equals: 200
    self assert: ((other awaitCallback: 5000) unwrap at: "state") equals: "a+b/c d"

  testMalformedQueryAnswers400AndKeepsTheSlot =>
    resp := (self browse: "/callback?code=a&junk=%ZZ&state={self expected}") unwrap
    self assert: resp status equals: 400
    self callback: "code=real"
    self assert: ((self.rx awaitCallback: 5000) unwrap at: "code") equals: "real"

  testGateParsesTheRawQueryNotQueryParams =>
    // A request without a raw query is refused even when its decoded
    // queryParams carry the right state: the raw query is the only source.
    gate := LoopbackGate spawn
    gate expectHost: "127.0.0.1:4000"
    gate expectState: "s1"
    req := HTTPRequest
      new: #{
        #method => "GET",
        #path => "/callback",
        #headers => #(#("host", "127.0.0.1:4000")),
        #queryParams => #{"code" => "smuggled", "state" => "s1"}
      }
    self assert: (gate handle: req rawQuery: nil) status equals: 404
    self assert: (gate handle: req rawQuery: "code=a&state=s1&state=s1") status equals: 404
    self assert: gate refusedCount equals: 2
    self assert: (gate handle: req rawQuery: "code=real&state=s1") status equals: 200
    gate stop

  testTimeoutReportsRefusedCallbacks =>
    self browse: "/callback?code=a&state=wrong"
    self browse: "/callback?code=b"
    self browse: "/favicon.ico"
    outcome := self.rx awaitCallback: 50
    self assert: outcome error code equals: "callback_timeout"
    self assert: outcome error detail equals: 2
    self assert: (outcome error description includesSubstring: "2 callback")

  testTimeoutWithNothingRefusedReportsZero =>
    outcome := self.rx awaitCallback: 20
    self assert: outcome error code equals: "callback_timeout"
    self assert: outcome error detail equals: 0

  // --- BT-4570: the listener does not outlive a crashed owner ---

  /// Poll until `rx` stops listening, for up to about 2 s.
  awaitClosed: rx =>
    100 timesRepeat: [rx isListening ifTrue: [Timer sleep: 20]]
    rx isListening not

  /// Fork `body` with a receiver it starts and publishes in `table` under
  /// `#rx`; answer the receiver once published.
  receiverStartedIn: table by: body =>
    [
      started := LoopbackReceiver start unwrap
      table at: #rx put: started
      body value: started
    ] fork
    100 timesRepeat: [(table at: #rx) isNil ifTrue: [Timer sleep: 10]]
    table at: #rx

  testListenerClosesWhenStarterCrashes =>
    table := Ets new: #bt4570Crash type: #set
    rx := self
      receiverStartedIn: table
      by: [:started |
        Timer sleep: 100
        Erlang erlang exit: #boom
      ]
    self assert: rx notNil
    self assert: (self awaitClosed: rx)
    self assert: (HTTPClient get: rx redirectUri ++ "?code=x&state=s") isError
    self assert: (rx awaitCallback: 50) error code equals: "config"
    table delete

  testListenerSurvivesStarterExitingNormally =>
    table := Ets new: #bt4570Normal type: #set
    rx := self receiverStartedIn: table by: [:started | nil]
    Timer sleep: 100
    self assert: rx isListening
    rx expectState: "handed-over"
    HTTPClient get: rx redirectUri ++ "?code=kept&state=handed-over"
    self assert: ((rx awaitCallback: 5000) unwrap at: "code") equals: "kept"
    table delete

  testListenerClosesWhenWaiterIsKilled =>
    rx := self.rx
    waiter := [rx awaitCallback: 30000] fork
    Timer sleep: 100
    self assert: rx isListening
    Erlang erlang exit: waiter with: #kill
    self assert: (self awaitClosed: rx)

  testWaiterOwnsTheReceiverOnceWaiting =>
    // The starter crashing does not cut off a wait already under way.
    table := Ets new: #bt4570Waiter type: #set
    rx := self
      receiverStartedIn: table
      by: [:started |
        started expectState: "w"
        table at: #armed put: true
        Timer sleep: 500
        Erlang erlang exit: #boom
      ]
    100 timesRepeat: [(table at: #armed) isNil ifTrue: [Timer sleep: 10]]
    [
      Timer sleep: 900
      HTTPClient get: rx redirectUri ++ "?code=waited&state=w"
    ] fork
    self assert: ((rx awaitCallback: 5000) unwrap at: "code") equals: "waited"
    table delete

  testUnawaitedReceiverStopsAfterItsLifetime =>
    other := (LoopbackReceiver startWithLifetime: 100) unwrap
    self assert: other isListening
    self assert: (self awaitClosed: other)

  testAwaitedReceiverOutlivesItsLifetime =>
    other := (LoopbackReceiver startWithLifetime: 100) unwrap
    other expectState: "slow"
    [
      Timer sleep: 400
      HTTPClient get: other redirectUri ++ "?code=slow&state=slow"
    ] fork
    self assert: ((other awaitCallback: 5000) unwrap at: "code") equals: "slow"

  testLifetimeOutOfRangeAnswersConfigError =>
    self assert: (LoopbackReceiver startWithLifetime: 0) error code equals: "config"
    self assert: (LoopbackReceiver startWithLifetime: LoopbackReceiver maxTimeout + 1) error code equals: "config"

  testListenerClosesWhenStarterCrashesRightAfterStart =>
    table := Ets new: #bt4570Immediate type: #set
    rx := self receiverStartedIn: table by: [:started |
      Erlang erlang exit: #boom
    ]
    self assert: (self awaitClosed: rx)
    table delete

  testStarterDyingDuringListenNeverLeaksTheServer =>
    // The starter is killed while the gate starts the server: whichever
    // way the race goes, no server is left listening.
    10
      timesRepeat: [
        starter := [Timer sleep: 60000] fork
        gate := LoopbackGate spawnWith: #{#starter => starter}
        Erlang erlang exit: starter with: #kill
        outcome := Result tryDo: [
          gate listenWith: (LoopbackReceiver handlerFor: gate) lifetime: 60000
        ]
        outcome isOk
          ifTrue: [
            srv := outcome value
            100 timesRepeat: [srv isAlive ifTrue: [Timer sleep: 20]]
            self deny: srv isAlive
          ]
        100 timesRepeat: [gate isAlive ifTrue: [Timer sleep: 20]]
        self deny: gate isAlive
      ]

  testGateWithADeadStarterShutsDownBeforeListening =>
    starter := [nil] fork
    Timer sleep: 50
    gate := LoopbackGate spawnWith: #{#starter => starter}
    100 timesRepeat: [gate isAlive ifTrue: [Timer sleep: 20]]
    self deny: gate isAlive

  // ===== Re-arming (BT-4572) =====
  testKeepListeningLeavesTheListenerUp =>
    self callback: "code=junk"
    query := (self.rx awaitCallback: 5000 keepListening: true) unwrap
    self assert: (query at: "code") equals: "junk"
    self assert: self.rx isListening
    // The slot is still taken until rearm.
    self assert: (self callback: "code=real") unwrap status equals: 404

  testRearmRecordsTheNextCallbackOnTheSamePort =>
    port := self.rx port
    self callback: "code=junk"
    (self.rx awaitCallback: 5000 keepListening: true) unwrap
    self assert: (self.rx rearm) isOk
    self assert: self.rx port equals: port
    // The expected state is kept: a wrong one is still refused.
    self assert: (self browse: "/callback?code=x&state=wrong") unwrap status equals: 404
    self assert: (self callback: "code=real") unwrap status equals: 200
    query := (self.rx awaitCallback: 5000) unwrap
    self assert: (query at: "code") equals: "real"
    self deny: self.rx isListening

  testKeepListeningStillStopsOnTimeout =>
    self assert: (self.rx awaitCallback: 50 keepListening: true) error code equals: "callback_timeout"
    self deny: self.rx isListening

  testRearmAfterStopAnswersConfigError =>
    self.rx stop
    self assert: self.rx rearm error code equals: "config"

  testRearmWithoutExpectedStateAnswersConfigError =>
    other := LoopbackReceiver start unwrap
    self assert: other rearm error code equals: "config"
    self assert: other isListening
    other stop

  testRearmWhileAWaitIsPendingAnswersConfigError =>
    rx := self.rx
    [rx awaitCallback: 2000] fork
    Timer sleep: 100
    self assert: rx rearm error code equals: "config"
    self assert: rx isListening

  testListenerClosesWhenOwnerEndsAfterAKeptCallback =>
    // The waiter stays the owner after a wait that keeps the listener up:
    // when it ends without stopping it, the listener goes with it.
    rx := self.rx
    self callback: "code=junk"
    [(rx awaitCallback: 5000 keepListening: true) unwrap] fork
    self assert: (self awaitClosed: rx)
