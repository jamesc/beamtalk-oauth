// TokenRevocation tokenInfo: against the fixture provider's /tokeninfo
// route, with the GitLab and Google presets pointed at the fixture. No
// test hits the network, and none may reach httpc.

TestCase subclass: TokenInfoTest
  field: provider = nil

  setUp =>
    HttpcGuard install
    self.provider := FixtureProvider start

  tearDown =>
    self.provider stop
    self assert: HttpcGuard calls equals: 0
    nil

  /// `preset` with its endpoints pointed at the fixture.
  local: preset :: Dictionary -> Dictionary =>
    base := self.provider issuer
    (preset at: #tokenInfoEndpoint put: "{base}/tokeninfo") at: #revocationEndpoint put: "{base}/revoke"

  serverFor: preset :: Dictionary -> OAuthServer =>
    (OAuthServer
      fromDiscovery: self.provider issuer
      preset: (self local: preset)
      options: #{#allowUnsafeHttp => true}) unwrap

  gitlab -> OAuthServer => self serverFor: ProviderPresets gitlab

  google -> OAuthServer => self serverFor: ProviderPresets google

  client -> ClientRegistration =>
    (ClientRegistration forClient: FixtureProvider clientId redirect: "http://127.0.0.1:50278/callback") unwrap

  tokens -> TokenSet =>
    TokenSet new: #{#accessToken => "at-1", #refreshToken => "rt-1"}

  info: server :: OAuthServer token: tok :: Object -> Result =>
    TokenRevocation
      tokenInfo: server
      client: self client
      token: tok

  lastRequest -> Dictionary => self.provider lastRequestTo: "/tokeninfo"

  // ===== GitLab =====
  testGitlabNormalization =>
    self.provider
      tokenInfo: #{
        "resource_owner_id" => 42,
        "scope" => #("openid", "api"),
        "expires_in" => 7200,
        "application" => #{"uid" => "client-1"},
        "created_at" => 1700000000
      }
    info := (self info: self gitlab token: self tokens) unwrap
    self
      assert: info
      equals: #{
        #active => true,
        #subject => "42",
        #scopes => #("openid", "api"),
        #expiresIn => 7200
      }
    req := self lastRequest
    self assert: (req at: #method) equals: "GET"
    self assert: ((req at: #headers) at: "authorization") equals: "Bearer at-1"
    self deny: ((req at: #query) includesKey: "access_token")

  testGitlabInvalidTokenIsInactive =>
    info := (self info: self gitlab token: "bogus") unwrap
    self assert: (info at: #active) equals: false
    self assert: (info at: #subject) equals: nil
    self assert: (info at: #scopes) equals: #()
    self assert: (info at: #expiresIn) equals: nil

  // ===== Google =====
  testGoogleNormalization =>
    self.provider
      tokenInfo: #{
        "azp" => "client-1",
        "aud" => "client-1",
        "sub" => "1234567890",
        "scope" => "openid https://www.googleapis.com/auth/userinfo.email",
        "exp" => "1700003600",
        "expires_in" => "3599",
        "email" => "user@example.test"
      }
    info := (self info: self google token: self tokens) unwrap
    self
      assert: info
      equals: #{
        #active => true,
        #subject => "1234567890",
        #scopes => #("openid", "https://www.googleapis.com/auth/userinfo.email"),
        #expiresIn => 3599
      }
    req := self lastRequest
    self assert: ((req at: #query) at: "access_token") equals: "at-1"
    self deny: ((req at: #headers) includesKey: "authorization")

  testGoogleInvalidValueIsInactive =>
    self.provider
      fail: "/tokeninfo"
      status: 400
      body: #{"error_description" => "Invalid Value"}
    info := (self info: self google token: self tokens) unwrap
    self assert: (info at: #active) equals: false

  testInvalidTokenErrorIsInactive =>
    self.provider
      fail: "/tokeninfo"
      status: 400
      body: #{"error" => "invalid_token"}
    self assert: ((self info: self google token: self tokens) unwrap at: #active) equals: false

  testActiveMemberIsRespected =>
    self.provider tokenInfo: #{"active" => false, "sub" => "user-1"}
    self assert: ((self info: self google token: self tokens) unwrap at: #active) equals: false

  // ===== Errors =====
  testOtherErrorsAreErrors =>
    self.provider
      fail: "/tokeninfo"
      status: 400
      body: #{"error" => "invalid_request"}
    err := (self info: self google token: self tokens) error
    self assert: err code equals: "invalid_request"
    self assert: err status equals: 400
    self.provider
      respond: "/tokeninfo"
      status: 500
      body: "oops"
      contentType: "text/plain"
    err2 := (self info: self gitlab token: self tokens) error
    self assert: err2 code equals: "transport"
    self assert: err2 status equals: 500

  testNonJsonSuccessIsParseError =>
    self.provider
      respond: "/tokeninfo"
      status: 200
      body: "ok"
      contentType: "text/plain"
    self assert: (self info: self gitlab token: self tokens) error code equals: "parse"

  testMissingEndpointIsConfigError =>
    srv := (OAuthServer
      fromDiscovery: self.provider issuer
      preset: #{}
      options: #{#allowUnsafeHttp => true}) unwrap
    self assert: (self info: srv token: self tokens) error code equals: "config"
    self assert: self lastRequest equals: nil

  testEmptyTokenIsConfigError =>
    self assert: (self info: self gitlab token: "") error code equals: "config"

  testErrorsNeverCarryTheToken =>
    self.provider
      fail: "/tokeninfo"
      status: 403
      body: #{
        "error" => "insufficient_scope",
        "error_description" => "token at-1 lacks scope",
        "access_token" => "at-1"
      }
    err := (self info: self google token: self tokens) error
    self assert: err code equals: "insufficient_scope"
    self deny: (err printString includesSubstring: "at-1")
    self deny: (err asJson printString includesSubstring: "at-1")
