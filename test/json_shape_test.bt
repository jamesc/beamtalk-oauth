/// Pins the `asJson` wire shape of every JSON-mapped class and asserts that
/// no secret value appears in `asJson` or `Json generate:` output. `asJson`
/// is a security boundary: a mapped field without a converter is emitted
/// as-is, so each secret field must keep its redacting converter.
TestCase subclass: JsonShapeTest

  /// True when `text` holds none of `secrets`.
  assertNoneIn: text :: String of: secrets :: List =>
    secrets do: [:s | self deny: (text includesSubstring: s)]

  testTokenSetShape =>
    t := TokenSet
      new: #{
        #accessToken => "access-AAA111",
        #tokenType => "Bearer",
        #expiresIn => 3600,
        #obtainedAt => 1000,
        #refreshToken => "refresh-RRR222",
        #scope => "openid",
        #idTokenClaims => #{"sub" => "claims-SUB333"},
        #idToken => "eyJhbGciOiJSUzI1NiJ9.payload.sig"
      }
    self
      assert: t asJson
      equals: #{
        "accessToken" => "[redacted]",
        "tokenType" => "Bearer",
        "expiresIn" => 3600,
        "obtainedAt" => 1000,
        "refreshToken" => "[redacted]",
        "scope" => "openid",
        "idToken" => "[redacted]"
      }
    self assertNoneIn: t asJson printString ++ (Json generate: t) of: #("access-AAA111", "refresh-RRR222", "eyJhbGci", "claims-SUB333")

  testTokenSetAbsentTokensStayNil =>
    t := TokenSet new: #{#accessToken => "access-AAA111"}
    json := t asJson
    self assert: (json at: "accessToken") equals: "[redacted]"
    self assert: (json at: "refreshToken") equals: nil
    self assert: (json at: "idToken") equals: nil
    self assert: (json at: "tokenType") equals: "bearer"
    self assert: (json at: "expiresIn") equals: nil
    self assert: (json at: "scope") equals: nil
    self assert: json size equals: 7

  testOAuthSessionShape =>
    s := OAuthSession
      new: #{
        #state => "st-1",
        #nonce => "nonce-NNN444",
        #codeVerifier => "verifier-VVV555",
        #issuer => "https://idp.example",
        #redirectUri => "http://127.0.0.1:1/cb",
        #createdAt => 42
      }
    self
      assert: s asJson
      equals: #{
        "state" => "st-1",
        "nonce" => "[redacted]",
        "codeVerifier" => "[redacted]",
        "issuer" => "https://idp.example",
        "redirectUri" => "http://127.0.0.1:1/cb",
        "createdAt" => 42
      }
    self assertNoneIn: s asJson printString ++ (Json generate: s) of: #("nonce-NNN444", "verifier-VVV555")

  testOAuthSessionEmptySecretsStillRedacted =>
    json := OAuthSession new asJson
    self assert: (json at: "nonce") equals: "[redacted]"
    self assert: (json at: "codeVerifier") equals: "[redacted]"

  testCallbackShape =>
    sess := OAuthSession
      new: #{
        #state => "st-1",
        #nonce => "nonce-NNN444",
        #codeVerifier => "verifier-VVV555"
      }
    cb := Callback
      new: #{
        #code => "code-CCC666",
        #iss => "https://idp.example",
        #session => sess,
        #ticket => "ticket-TTT777"
      }
    json := cb asJson
    self assert: (json at: "code") equals: "[redacted]"
    self assert: (json at: "ticket") equals: "[redacted]"
    self assert: (json at: "iss") equals: "https://idp.example"
    self assert: (json at: "session") equals: sess asJson
    self assert: json size equals: 4
    self assertNoneIn: json printString ++ (Json generate: cb) of: #("code-CCC666", "ticket-TTT777", "nonce-NNN444", "verifier-VVV555")

  testClientRegistrationShape =>
    reg := ClientRegistration
      new: #{
        #clientId => "app",
        #clientSecret => "s3cret-value",
        #redirectUri => "https://app.example.com/cb"
      }
    self
      assert: reg asJson
      equals: #{
        "clientId" => "app",
        "clientSecret" => "[redacted]",
        "redirectUri" => "https://app.example.com/cb"
      }
    self assertNoneIn: reg asJson printString ++ (Json generate: reg) of: #("s3cret-value")

  testClientRegistrationPublicClientSecretStaysNil =>
    reg := ClientRegistration new: #{#clientId => "app"}
    self assert: (reg asJson at: "clientSecret") equals: nil

  testOAuthServerShapeOmitsContext =>
    server := OAuthServer
      new: #{
        #issuer => "https://idp.example",
        #context => "context-XXX888",
        #revocationEndpoint => "https://idp.example/revoke"
      }
    self
      assert: server asJson
      equals: #{
        "issuer" => "https://idp.example",
        "revocationEndpoint" => "https://idp.example/revoke",
        "tokenInfoEndpoint" => nil
      }
    self assertNoneIn: server asJson printString ++ (Json generate: server) of: #("context-XXX888")

  testOAuthErrorShape =>
    e := OAuthError
      new: #{
        #code => "invalid_grant",
        #description => "expired",
        #status => 400,
        #detail => #{"reason" => "x"}
      }
    json := e asJson
    self assert: (json at: "code") equals: "invalid_grant"
    self assert: (json at: "description") equals: "expired"
    self assert: (json at: "status") equals: 400
    self assert: (json at: "detail") equals: #{"reason" => "x"} printString
    self assert: json size equals: 4

  testOAuthErrorAbsentDetailAndStatusAreNil =>
    json := (OAuthError code: "x" description: "y") asJson
    self assert: (json at: "status") equals: nil
    self assert: (json at: "detail") equals: nil

  testOAuthErrorDetailSecretsRedacted =>
    e := OAuthError fromOidcc: {#bad, Binary fromIolist: #("glpat-abcdefghij1234567890")}
    self assertNoneIn: e asJson printString ++ (Json generate: e) of: #("glpat-abcdefghij1234567890")
