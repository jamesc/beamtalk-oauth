// End-to-end native login against the FixtureProvider, composed the way a
// native app composes it: a real LoopbackReceiver receives a real
// redirect (the fixture's /authorize answers a 302, followed with
// HTTPClient as a browser would, then a stray /favicon.ico), the code
// exchange goes through oidcc and the HTTP adapter, and the same objects
// then call userinfo, token info, refresh and revoke. Run once with a
// fromDiscovery: server and once with a ProviderWorker server. No test
// hits the network, and none may reach httpc (HttpcGuard).

TestCase subclass: E2eNativeLoginTest
  field: provider = nil
  field: rx = nil
  field: store = nil

  setUp =>
    HttpcGuard install
    self.provider := FixtureProvider start
    // Steps 2 and 4: the loopback receiver and the session store.
    self.rx := LoopbackReceiver start unwrap
    self.store := SessionStore spawn
    self

  tearDown =>
    self.rx stop
    self.store stop
    self.provider stop
    self assert: HttpcGuard calls equals: 0
    nil

  unsafe -> Dictionary => #{#allowUnsafeHttp => true}

  // The client is public, as a native app's is on GitLab. The fixture
  // advertises only client_secret_basic/post, so the exchange works only
  // if the gitlab preset's document override (adding `none`) reaches
  // oidcc.
  preset -> Dictionary =>
    #{#documentOverrides => (ProviderPresets gitlab at: #documentOverrides)}

  // Step 1, one-shot: discover the provider.
  discovered -> OAuthServer =>
    (OAuthServer
      fromDiscovery: self.provider issuer
      preset: self preset
      options: self unsafe) unwrap

  // Step 1, long-running: a ProviderWorker (the caller stops it).
  startWorker -> ProviderWorker =>
    (ProviderWorker
      issuer: self.provider issuer
      preset: self preset
      options: self unsafe) unwrap

  // The value of header `name` in `resp`, or "" when it has none.
  header: name :: String in: resp :: HTTPResponse -> String =>
    resp headers
      do: [:pair |
        (pair at: 1) asStringUnchecked lowercase =:= name ifTrue: [
          ^(pair at: 2) asStringUnchecked
        ]
      ]
    ""

  // Step 6, the browser hop: GET the authorize URL, follow its 302 to the
  // loopback receiver, with the stray requests a receiver sees around it:
  // a /favicon.ico and a /callback with the wrong state before the real
  // callback (neither may take the one-shot slot), another /favicon.ico
  // after. Answers the receiver's status for the real callback.
  browse: url :: String -> Integer =>
    authorize := (HTTPClient get: url) unwrap
    self assert: authorize status equals: 302
    location := self header: "location" in: authorize
    self assert: (location startsWith: "{self.rx redirectUri}?")
    base := "http://127.0.0.1:{self.rx port}"
    self assert: (HTTPClient get: "{base}/favicon.ico") unwrap status equals: 404
    junk := (HTTPClient get: "{base}/callback?code=evil&state=wrong") unwrap
    self assert: junk status equals: 404
    landed := (HTTPClient get: location) unwrap
    self assert: (HTTPClient get: "{base}/favicon.ico") unwrap status equals: 404
    landed status

  // Steps 3-7 up to the raw callback query: registration, session,
  // authorize URL, browser hop, await. Answers `{reg, sess, query}`.
  signIn: server :: OAuthServer -> Tuple =>
    reg := (ClientRegistration forClient: FixtureProvider clientId redirect: self.rx redirectUri) unwrap
    sess := OAuthSession newSessionFor: server client: reg
    (self.store create: sess boundTo: self.rx binding) unwrap
    self.rx expectState: sess state
    url := (OAuthFlows
      authorizeUrl: server
      client: reg
      scopes: #("openid", "profile")
      session: sess) unwrap
    self assert: (self browse: url) equals: 200
    query := (self.rx awaitCallback: 5000) unwrap
    {reg, sess, query}

  // The whole login and the calls after it, against `server`.
  runLogin: server :: OAuthServer =>
    {reg, sess, query} := self signIn: server
    self assert: (query at: "code") equals: "code-1"
    self assert: (query at: "state") equals: sess state
    self assert: (query at: "iss") equals: server issuer
    // Step 7: the callback, then the code exchange.
    cb := (OAuthFlows
      handleCallback: query
      store: self.store
      boundTo: self.rx binding) unwrap
    self assert: cb session state equals: sess state
    toks := (OAuthFlows
      exchangeCode: server
      client: reg
      callback: cb
      store: self.store) unwrap
    // The ID token carried the session's nonce (the fixture echoed it from
    // the authorize request) and oidcc validated it.
    self assert: toks subject equals: "user-1"
    self assert: (toks idTokenClaims at: "nonce") equals: sess nonce
    self assert: toks accessToken equals: "at-1"
    // PKCE: the verifier sent to /token hashes to the challenge the
    // browser carried to /authorize; a public client sends no secret.
    form := self.provider lastTokenRequest at: #form
    challenge := ((self.provider lastRequestTo: "/authorize") at: #query) at: "code_challenge"
    verifier := form at: "code_verifier"
    self assert: verifier equals: sess codeVerifier
    self assert: ((Erlang crypto hash: #sha256 with: verifier) asBase64Url replaceAll: "=" with: "") equals: challenge
    self assert: (form at: "grant_type") equals: "authorization_code"
    self assert: (form at: "code") equals: "code-1"
    self assert: (form at: "redirect_uri") equals: self.rx redirectUri
    self assert: (form at: "client_id") equals: FixtureProvider clientId
    self deny: (form includesKey: "client_secret")
    self deny: ((self.provider lastTokenRequest at: #headers) includesKey: "authorization")
    // Step 8: userinfo, token info, refresh (merged), revoke.
    info := (OAuthFlows
      userInfo: server
      client: reg
      tokenSet: toks) unwrap
    self assert: (info at: "sub") equals: toks subject
    infoServer := server withTokenInfoEndpoint: "{server issuer}/tokeninfo"
    self.provider
      tokenInfo: #{
        "sub" => "user-1",
        "aud" => FixtureProvider clientId,
        "scope" => "openid profile",
        "expires_in" => 3000
      }
    tokenInfo := (OAuthFlows
      tokenInfo: infoServer
      client: reg
      token: toks) unwrap
    self assert: (tokenInfo at: #active)
    self assert: (tokenInfo at: #subject) equals: toks subject
    self.provider tokenFields: #{
      "access_token" => "at-2",
      "refresh_token" => nil
    }
    fresh := (OAuthFlows
      refresh: server
      client: reg
      tokenSet: toks) unwrap
    self assert: fresh accessToken equals: "at-2"
    self assert: fresh refreshToken equals: "rt-1"
    self assert: fresh subject equals: toks subject
    self assert: ((self.provider lastTokenRequest at: #form) at: "grant_type") equals: "refresh_token"
    self
      assert: (OAuthFlows
        revoke: server
        client: reg
        token: fresh) isOk
    revoked := (self.provider lastRequestTo: "/revoke") at: #form
    self assert: (revoked at: "token") equals: "rt-1"
    self assert: (revoked at: "token_type_hint") equals: "refresh_token"
    self assert: (revoked at: "client_id") equals: FixtureProvider clientId
    // The access token too, with an explicit hint.
    self
      assert: (OAuthFlows
        revoke: server
        client: reg
        token: fresh
        hint: #access_token) isOk
    revoked := (self.provider lastRequestTo: "/revoke") at: #form
    self assert: (revoked at: "token") equals: "at-2"
    self assert: (revoked at: "token_type_hint") equals: "access_token"
    // The callback is spent: neither it nor its query can be used again.
    again := OAuthFlows
      exchangeCode: server
      client: reg
      callback: cb
      store: self.store
    self assert: again error code equals: "reused_state"
    replay := OAuthFlows
      handleCallback: query
      store: self.store
      boundTo: self.rx binding
    self assert: replay error code equals: "reused_state"
    self deny: self.rx isListening

  // ===== The happy path, both ways to get a server =====
  testNativeLoginWithDiscovery => self runLogin: self discovered

  testNativeLoginWithProviderWorker =>
    worker := self startWorker
    [self runLogin: worker server unwrap] ensure: [worker stop]
    // The worker discovered once; the login did not rediscover.
    self assert: (self.provider hits: "/.well-known/openid-configuration") equals: 1

  // ===== Replays (login CSRF) =====
  testCallbackWithOtherBindingFails =>
    {_, _, query} := self signIn: self discovered
    got := OAuthFlows
      handleCallback: query
      store: self.store
      boundTo: Secrets generate
    self assert: got error code equals: "session_mismatch"
    // The probe burned the session: the right binding cannot use it now.
    retry := OAuthFlows
      handleCallback: query
      store: self.store
      boundTo: self.rx binding
    self assert: retry error code equals: "reused_state"

  testCallbackInOtherStoreFails =>
    {reg, _, query} := self signIn: self discovered
    other := SessionStore spawn
    [
      self
        replay: query
        into: other
        client: reg
    ] ensure: [other stop]

  // `query` replayed into `other`, a second store, then the real login
  // carried on with the ticket redeemed against `other`.
  replay: query :: Dictionary into: other :: SessionStore client: reg :: ClientRegistration =>
    got := OAuthFlows
      handleCallback: query
      store: other
      boundTo: self.rx binding
    self assert: got error code equals: "reused_state"
    // The real store still holds the session, so the real login goes on.
    cb := (OAuthFlows
      handleCallback: query
      store: self.store
      boundTo: self.rx binding) unwrap
    // A ticket redeemed against another store fails too.
    elsewhere := OAuthFlows
      exchangeCode: self discovered
      client: reg
      callback: cb
      store: other
    self assert: elsewhere error code equals: "reused_state"

  // ===== Re-arming after a forged callback (BT-4572) =====

  // Registration, stored session and the authorize hop, without following
  // the redirect: answers `{reg, sess, location}`, where `location` is the
  // real callback URL the provider sent the browser to.
  authorizeOnly: server :: OAuthServer -> Tuple =>
    reg := (ClientRegistration forClient: FixtureProvider clientId redirect: self.rx redirectUri) unwrap
    sess := OAuthSession newSessionFor: server client: reg
    (self.store create: sess boundTo: self.rx binding) unwrap
    self.rx expectState: sess state
    url := (OAuthFlows
      authorizeUrl: server
      client: reg
      scopes: #("openid", "profile")
      session: sess) unwrap
    authorize := (HTTPClient get: url) unwrap
    self assert: authorize status equals: 302
    {reg, sess, self header: "location" in: authorize}

  // A forged callback for `sess`: a junk code with the real state.
  junkFor: sess :: OAuthSession -> String =>
    "{self.rx redirectUri}?code=junk&state={sess state urlEncoded}"

  // GET `url` until the receiver records it (200), at most `tries` times,
  // 20 ms apart: a stand-in for a callback that lands after a re-arm.
  // Answers how many were recorded (0 or 1).
  deliver: url :: String tries: tries :: Integer -> Integer =>
    tries
      timesRepeat: [
        got := HTTPClient get: url
        (got isOk and: [got value status =:= 200]) ifTrue: [^1]
        Timer sleep: 20
      ]
    0

  // The completion helper against `server`, default cap.
  complete: server :: OAuthServer client: reg :: ClientRegistration timeout: ms :: Integer -> Result =>
    OAuthFlows
      completeLoopbackLogin: self.rx
      server: server
      client: reg
      store: self.store
      timeout: ms

  // The completion helper against `server`, with `maxRearms` re-arms.
  complete: server :: OAuthServer client: reg :: ClientRegistration timeout: ms :: Integer maxRearms: n :: Integer -> Result =>
    OAuthFlows
      completeLoopbackLogin: self.rx
      server: server
      client: reg
      store: self.store
      timeout: ms
      maxRearms: n

  testForgedCodeFirstStillLogsIn =>
    server := self discovered
    {reg, sess, location} := self authorizeOnly: server
    junk := self junkFor: sess
    // The local attacker's callback lands first; the real redirect is
    // retried until the receiver has re-armed.
    this := self
    [
      this deliver: junk tries: 1
      this deliver: location tries: 200
    ] fork
    toks := (self
      complete: server
      client: reg
      timeout: 10000) unwrap
    self assert: toks subject equals: "user-1"
    self assert: (self.provider hits: "/token") equals: 2
    // The same session came back: same verifier, same nonce.
    form := self.provider lastTokenRequest at: #form
    self assert: (form at: "code") equals: "code-1"
    self assert: (form at: "code_verifier") equals: sess codeVerifier
    self assert: (toks idTokenClaims at: "nonce") equals: sess nonce
    self assert: self.store size equals: 0
    self deny: self.rx isListening

  testRearmsAreCapped =>
    server := self discovered
    {reg, sess, _} := self authorizeOnly: server
    junk := self junkFor: sess
    this := self
    // One forged callback, then one per re-arm, and one more that must
    // never be recorded.
    [5 timesRepeat: [this deliver: junk tries: 100]] fork
    got := self
      complete: server
      client: reg
      timeout: 10000
    self assert: got error code equals: "invalid_grant"
    self assert: (self.provider hits: "/token") equals: OAuthFlows defaultMaxRearms + 1
    self deny: self.rx isListening

  testZeroRearmsEndsOnTheFirstForgedCode =>
    server := self discovered
    {reg, sess, _} := self authorizeOnly: server
    HTTPClient get: (self junkFor: sess)
    got := OAuthFlows
      completeLoopbackLogin: self.rx
      server: server
      client: reg
      store: self.store
      timeout: 5000
      maxRearms: 0
    self assert: got error code equals: "invalid_grant"
    self assert: (self.provider hits: "/token") equals: 1
    // The session was burned, not put back.
    self assert: self.store size equals: 0
    self deny: self.rx isListening

  testProviderErrorCallbackIsNotRetried =>
    server := self discovered
    {reg, sess, _} := self authorizeOnly: server
    HTTPClient get: "{self.rx redirectUri}?error=access_denied&state={sess state urlEncoded}"
    got := self
      complete: server
      client: reg
      timeout: 5000
    self assert: got error code equals: "access_denied"
    self assert: (self.provider hits: "/token") equals: 0
    self assert: self.store size equals: 0
    self deny: self.rx isListening

  testOtherExchangeErrorsAreNotRetried =>
    server := self discovered
    {reg, _, location} := self authorizeOnly: server
    self.provider
      fail: "/token"
      status: 400
      body: #{"error" => "invalid_client"}
    HTTPClient get: location
    got := self
      complete: server
      client: reg
      timeout: 5000
    self assert: got error code equals: "invalid_client"
    self assert: (self.provider hits: "/token") equals: 1
    self deny: self.rx isListening

  testTimeoutBoundsTheWholeLogin =>
    server := self discovered
    {reg, sess, _} := self authorizeOnly: server
    // A forged callback re-arms, then nothing else comes.
    HTTPClient get: (self junkFor: sess)
    started := Erlang erlang monotonic_time: #millisecond
    got := self
      complete: server
      client: reg
      timeout: 500
    elapsed := (Erlang erlang monotonic_time: #millisecond) - started
    // The refused code says more than a timeout.
    self assert: got error code equals: "invalid_grant"
    self assert: (self.provider hits: "/token") equals: 1
    self assert: elapsed >= 500
    self assert: elapsed < 2000
    self deny: self.rx isListening

  testTimeoutWithoutACallbackAnswersCallbackTimeout =>
    server := self discovered
    {reg, _, _} := self authorizeOnly: server
    got := self
      complete: server
      client: reg
      timeout: 100
    self assert: got error code equals: "callback_timeout"
    self deny: self.rx isListening

  // ===== Filtering forged callbacks early (BT-4613) =====
  testForgedIssuerFirstStillLogsInWithoutARearm =>
    server := self discovered
    {reg, sess, location} := self authorizeOnly: server
    forged := "{self junkFor: sess}&iss=https%3A%2F%2Fevil.example"
    this := self
    [
      this deliver: forged tries: 1
      this deliver: location tries: 200
    ] fork
    toks := (self
      complete: server
      client: reg
      timeout: 10000) unwrap
    self assert: toks subject equals: "user-1"
    // Filtered, so never exchanged: no re-arm was used.
    self assert: (self.provider hits: "/token") equals: 1
    self deny: self.rx isListening

  testForgedIssuerRecordedBeforeTheHelperIsDropped =>
    // The forged callback lands before the helper sets the issuer, so the
    // receiver recorded it; setting the issuer drops it again.
    server := self discovered
    {reg, sess, location} := self authorizeOnly: server
    forged := (HTTPClient get: "{self junkFor: sess}&iss=https%3A%2F%2Fevil.example") unwrap
    self assert: forged status equals: 200
    this := self
    [this deliver: location tries: 200] fork
    toks := (self
      complete: server
      client: reg
      timeout: 10000
      maxRearms: 0) unwrap
    self assert: toks subject equals: "user-1"
    self assert: (self.provider hits: "/token") equals: 1

  testStateOnlyCallbackFirstStillLogsIn =>
    server := self discovered
    {reg, sess, location} := self authorizeOnly: server
    stateOnly := "{self.rx redirectUri}?state={sess state urlEncoded}"
    self assert: (HTTPClient get: stateOnly) unwrap status equals: 404
    this := self
    [this deliver: location tries: 200] fork
    toks := (self
      complete: server
      client: reg
      timeout: 10000
      maxRearms: 0) unwrap
    self assert: toks subject equals: "user-1"
    self assert: (self.provider hits: "/token") equals: 1

  testCompleteWithAReceiverExpectingAnotherIssuerAnswersConfig =>
    server := self discovered
    {reg, _, _} := self authorizeOnly: server
    self.rx expectIssuer: "https://other.example"
    got := self
      complete: server
      client: reg
      timeout: 1000
    self assert: got error code equals: "config"
    self deny: self.rx isListening

  testNegativeMaxRearmsAnswersConfig =>
    server := self discovered
    {reg, _, _} := self authorizeOnly: server
    got := OAuthFlows
      completeLoopbackLogin: self.rx
      server: server
      client: reg
      store: self.store
      timeout: 1000
      maxRearms: -1
    self assert: got error code equals: "config"
    self deny: self.rx isListening

  testBadArgumentsAnswerConfig =>
    server := self discovered
    {reg, _, _} := self authorizeOnly: server
    self
      assert: (self
        complete: server
        client: reg
        timeout: -1) error code
      equals: "config"
    self deny: self.rx isListening
