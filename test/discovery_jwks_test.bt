// Unknown-kid JWKS reloads for `fromDiscovery:` servers (BT-4578): the
// reloaded keys are kept for the provider's jwks_uri, and reloads are
// limited to one per #minJwksReloadInterval. Each test has its own
// FixtureProvider, so its own jwks_uri, and a fresh discovery resets what
// is kept for it. No test hits the network or httpc (HttpcGuard).

TestCase subclass: DiscoveryJwksTest
  field: provider = nil

  setUp =>
    HttpcGuard install
    self.provider := FixtureProvider start
    self.provider keyId: "key-1"
    self

  tearDown =>
    self.provider stop
    self assert: HttpcGuard calls equals: 0
    nil

  discover: opts :: Dictionary -> OAuthServer =>
    all := #{#allowUnsafeHttp => true}
    opts keysAndValuesDo: [:k :v | all := all at: k put: v]
    (OAuthServer
      fromDiscovery: self.provider issuer
      preset: #{}
      options: all) unwrap

  retrieve: server :: OAuthServer -> Result => self retrieveWith: server context

  // An exchange through a provider context (say one with a small
  // deadline, `with_deadline/2`).
  retrieveWith: context -> Result =>
    Erlang beamtalk_oauth_oidcc
      retrieve_token: context
      with: #{
        #client_id => FixtureProvider clientId,
        #client_secret => FixtureProvider clientSecret
      }
      with: #{
        #issuer => self.provider issuer,
        #code => "code-1",
        #redirect_uri => "http://127.0.0.1:50278/callback",
        #nonce => FixtureProvider nonce,
        #pkce_verifier => Secrets generate
      }

  jwksHits -> Integer => self.provider hits: "/jwks"

  testRotatedKeyIsKept =>
    server := self discover: #{}
    self assertOk: (self retrieve: server)
    self.provider rotateKeyTo: "key-2"
    self assertOk: (self retrieve: server)
    self assert: self jwksHits equals: 2
    // The server still holds key-1 only; the kept keys answer its next
    // unknown kid without a fetch.
    self assertOk: (self retrieve: server)
    self assert: self jwksHits equals: 2

  testUnknownKidReloadIsRateLimited =>
    server := self discover: #{}
    self.provider rotateKeyTo: "key-2"
    self assertOk: (self retrieve: server)
    self.provider rotateKeyTo: "key-3"
    // Within the interval (30 s by default): no fetch, so validation fails.
    self assert: (self retrieve: server) isError
    self assert: (self retrieve: server) isError
    self assert: self jwksHits equals: 2

  testUnknownKidReloadsAgainAfterInterval =>
    server := self discover: #{#minJwksReloadInterval => 200}
    self.provider rotateKeyTo: "key-2"
    self assertOk: (self retrieve: server)
    self.provider rotateKeyTo: "key-3"
    Erlang timer sleep: 250
    self assertOk: (self retrieve: server)
    self assert: self jwksHits equals: 3

  testFailedReloadIsRateLimited =>
    server := self discover: #{}
    self.provider rotateKeyTo: "key-2"
    self.provider failNext: "/jwks" times: 1
    self assert: (self retrieve: server) isError
    // The failed reload counts: no retry within the interval.
    self assert: (self retrieve: server) isError
    self assert: self jwksHits equals: 2

  testRediscoveryResetsTheInterval =>
    server := self discover: #{}
    self.provider rotateKeyTo: "key-2"
    self assertOk: (self retrieve: server)
    self.provider rotateKeyTo: "key-3"
    // A fresh discovery loads (and keeps) key-3 itself.
    fresh := self discover: #{}
    self assertOk: (self retrieve: fresh)
    self assertOk: (self retrieve: server)
    self assert: self jwksHits equals: 3

  // ===== the operation deadline (BT-4618, BT-4639) =====
  // The error a shim answer maps to.
  errorOf: result :: Result -> OAuthError => OAuthError fromOidcc: result error

  testSlowReloadIsBoundedByDeadline =>
    server := self discover: #{#deadline => 300}
    self.provider rotateKeyTo: "key-2"
    self.provider slow: "/jwks" by: 1500
    before := Erlang erlang monotonic_time: #millisecond
    result := self retrieve: server
    elapsed := (Erlang erlang monotonic_time: #millisecond) - before
    // The reload times out at what is left of the deadline, well before
    // the slow answer, and says so.
    self assert: result isError
    self assert: (self errorOf: result) code equals: "transport"
    self assert: ((self errorOf: result) description includesSubstring: "deadline exceeded")
    self assert: elapsed < 1200

  testSpentDeadlineStartsNoRequest =>
    server := self discover: #{}
    context := Erlang beamtalk_oauth_oidcc with_deadline: server context with: 0
    result := self retrieveWith: context
    self assert: ((self errorOf: result) description includesSubstring: "deadline exceeded")
    self assert: (self.provider hits: "/token") equals: 0

  testSpentDeadlineClaimsNoReload =>
    server := self discover: #{}
    self.provider rotateKeyTo: "key-2"
    // The unknown-kid refresh of an operation whose deadline is already
    // spent (as by a slow token request): no load, and none claimed.
    context := Erlang beamtalk_oauth_oidcc with_deadline: server context with: 1
    opts := Erlang beamtalk_oauth_oidcc call_opts: context
    Erlang timer sleep: 20
    refreshed := (opts at: #refresh_jwks) value: nil value: "key-2"
    self assert: refreshed equals: {#error, #deadline_exceeded}
    self assert: self jwksHits equals: 1
    // The interval was not used up: an exchange with time left reloads.
    self assertOk: (self retrieve: server)
    self assert: self jwksHits equals: 2

  testBadIntervalRaises =>
    #(-1, "soon")
      do: [:value |
        self should: [
          self discover: #{#minJwksReloadInterval => value}
        ] raise: #signal
      ]
