/// FixtureProvider — a local OpenID provider for tests, so no test hits
/// the network.
///
/// An `HTTPServer` on an ephemeral port (plain HTTP, so discovery needs
/// `#allowUnsafeHttp`) with this actor as its handler:
///
/// | Path                                | Answers                                |
/// |-------------------------------------|----------------------------------------|
/// | `/.well-known/openid-configuration` | the discovery document                 |
/// | `/authorize`                        | a 302 back to `redirect_uri` (below)   |
/// | `/jwks`                             | the public half of an ES256 test key   |
/// | `/token`                            | a token response with a signed ID token|
/// | `/userinfo`                         | userinfo claims (401 without a bearer) |
/// | `/revoke`                           | 200 with an empty body (RFC 7009)      |
/// | `/tokeninfo`, `/oauth/token/info`   | `tokenInfo:` for `at-1`, else 401      |
///
/// Configure it per test: `claims:` (ID-token claims), `tokenFields:`
/// (token-response members), `discoveryOverrides:`, and
/// `fail:status:body:` for an error answer on any path. A nil value in
/// any of those dictionaries removes the member. `reset` restores the
/// defaults. `lastTokenRequest` answers the last `/token` request's form
/// body and headers.
///
/// For `/revoke` and `/tokeninfo`, `respond:status:body:contentType:`
/// answers a raw body (empty, text or JSON) instead, `tokenInfo:` sets the
/// token-info answer, and `lastRequestTo:` answers the last request's
/// method, form, query and headers. `/tokeninfo` takes the token as a
/// bearer header or an `access_token` form parameter. `redirect:to:`
/// answers a 302 with a `Location`.
///
/// `/authorize` stands in for the user signing in: it answers a 302 to
/// the request's `redirect_uri` with `code` (`code-1`), the request's
/// `state` and `iss` (the issuer), and makes the request's `nonce` the
/// ID-token `nonce` claim from then on, as a real provider binds the
/// nonce to the code. A request without `redirect_uri` answers 400.
/// `lastRequestTo: "/authorize"` answers its query (for the PKCE
/// challenge).
///
/// ID tokens are signed with the actor's own P-256 key through `jose`.
/// `keyId:` names the key (a `kid` in the JWKS and the ID-token header);
/// `rotateKeyTo:` replaces it with a new key under a new `kid`, so the
/// JWKS a client loaded earlier no longer has it. `hits:` counts the
/// requests made to a path, and `slow:by:` delays its answers.
/// Default claims: `iss` (the issuer), `sub` `user-1`, `aud` `client-1`,
/// `nonce` `nonce-1`, `iat` now and `exp` five minutes on.
///
/// ## Examples
/// ```beamtalk
/// provider := FixtureProvider start
/// opts := #{#allowUnsafeHttp => true}
/// server := (OAuthServer fromDiscovery: provider issuer preset: #{} options: opts) unwrap
/// provider fail: "/token" status: 400 body: #{"error" => "invalid_grant"}
/// provider stop
/// ```
Actor subclass: FixtureProvider
  /// The `HTTPServer` serving this provider.
  state: server = nil
  /// `http://127.0.0.1:<port>`.
  state: issuer :: String = ""
  /// The `jose` EC private key ID tokens are signed with.
  state: key = nil
  /// ID-token claim overrides (String keys; nil removes a claim).
  state: claims :: Dictionary = #{}
  /// Token-response member overrides (nil removes a member).
  state: tokenFields :: Dictionary = #{}
  /// Discovery-document member overrides (nil removes a member).
  state: discoveryOverrides :: Dictionary = #{}
  /// Path -> {status, body Dictionary}: answer that instead.
  state: failures :: Dictionary = #{}
  /// `#{#form => Dictionary, #headers => Dictionary}` of the last `/token`
  /// request, or nil.
  state: lastTokenRequest = nil
  /// Path -> {status, body String, content type}: answer that raw body.
  state: responses :: Dictionary = #{}
  /// Path -> the last request's record, for `/revoke` and `/tokeninfo`.
  state: requests :: Dictionary = #{}
  /// The `/tokeninfo` answer for an active token.
  state: tokenInfo :: Dictionary = #{}
  /// The signing key's `kid`, or nil for none.
  state: keyId :: String | Nil = nil
  /// Path -> number of requests served.
  state: hits :: Dictionary = #{}
  /// Path -> milliseconds to wait before answering.
  state: delays :: Dictionary = #{}

  /// Start a provider on an ephemeral port. `stop` it when done.
  ///
  /// Also sets the test-only application flag that lets
  /// `#allowUnsafeHttp` work (the fixture is plain HTTP).
  class start -> FixtureProvider =>
    Erlang beamtalk_oauth_oidcc ensure_started
    Erlang application
      set_env: #beamtalk_oauth
      with: #allow_unsafe_http_for_tests
      with: true
    provider := self spawnWith: #{
      #key => (Erlang jose_jwk generate_key: {#ec, #secp256r1})
    }
    provider attach: (HTTPServer start: 0 handler: provider)
    provider

  /// The client id the default `aud` claim names.
  class clientId -> String => "client-1"

  /// The client secret tests register with.
  class clientSecret -> String => "secret-1"

  /// The nonce the default ID token carries.
  class nonce -> String => "nonce-1"

  /// Record the server and derive the issuer from its port.
  attach: srv :: HTTPServer -> Nil =>
    self.server := srv
    self.issuer := "http://127.0.0.1:{srv port}"
    nil

  /// `http://127.0.0.1:<port>`.
  issuer -> String => self.issuer

  /// The port the provider listens on.
  port -> Integer => self.server port

  /// Override ID-token claims (merged over the defaults).
  claims: overrides :: Dictionary -> Nil =>
    self.claims := overrides
    nil

  /// Override token-response members (merged over the defaults).
  tokenFields: overrides :: Dictionary -> Nil =>
    self.tokenFields := overrides
    nil

  /// Override discovery-document members (merged over the defaults).
  discoveryOverrides: overrides :: Dictionary -> Nil =>
    self.discoveryOverrides := overrides
    nil

  /// Answer `status` with `body` as JSON on `path` until `reset`.
  fail: path :: String status: status :: Integer body: body :: Dictionary -> Nil =>
    self.failures := self.failures at: path put: {status, body}
    nil

  /// Name the signing key `kid` (in the JWKS and ID-token headers).
  keyId: kid :: String -> Nil =>
    self.keyId := kid
    nil

  /// Sign with a new P-256 key named `kid` from now on; the JWKS serves
  /// only the new key.
  rotateKeyTo: kid :: String -> Nil =>
    self.key := Erlang jose_jwk generate_key: {#ec, #secp256r1}
    self.keyId := kid
    nil

  /// Wait `ms` milliseconds before answering each request on `path`.
  slow: path :: String by: ms :: Integer -> Nil =>
    self.delays := self.delays at: path put: ms
    nil

  /// The number of requests served on `path`.
  hits: path :: String -> Integer => self.hits at: path ifAbsent: [0]

  /// Back to the defaults: no overrides, no failures, no recorded request.
  reset -> Nil =>
    self.claims := #{}
    self.tokenFields := #{}
    self.discoveryOverrides := #{}
    self.failures := #{}
    self.lastTokenRequest := nil
    self.responses := #{}
    self.requests := #{}
    self.tokenInfo := #{}
    nil

  /// The last `/token` request: `#{#form => ..., #headers => ...}`, both
  /// with String keys (header names lowercase), or nil.
  lastTokenRequest -> Dictionary | Nil => self.lastTokenRequest

  /// Answer `status` with the raw `body` and `contentType` on `path`
  /// until `reset`.
  respond: path :: String status: status :: Integer body: body :: String contentType: contentType :: String -> Nil =>
    self.responses := self.responses at: path put: {status, body, contentType, #()}
    nil

  /// Answer a 302 to `location` on `path` until `reset`.
  redirect: path :: String to: location :: String -> Nil =>
    self.responses := self.responses at: path put: {302, "", "text/plain", #(#("location", location))}
    nil

  /// Set the `/tokeninfo` answer for the active token `at-1`.
  tokenInfo: body :: Dictionary -> Nil =>
    self.tokenInfo := body
    nil

  /// The last request to `path` (`/authorize`, `/revoke`, `/tokeninfo`
  /// or `/oauth/token/info`):
  /// `#{#method, #form, #query, #headers}`, or nil.
  lastRequestTo: path :: String -> Dictionary | Nil =>
    self.requests at: path ifAbsent: [nil]

  /// Answer one request (the `HTTPHandler` protocol).
  handle: req :: HTTPRequest -> HTTPResponse =>
    path := req path
    self.hits := self.hits at: path put: (self hits: path) + 1
    delay := self.delays at: path ifAbsent: [0]
    delay > 0 ifTrue: [Erlang timer sleep: delay]
    failure := self.failures at: path ifAbsent: [nil]
    path =:= "/token" ifTrue: [self.lastTokenRequest := self recordOf: req]
    (#("/authorize", "/revoke", "/tokeninfo", "/oauth/token/info") includes: path)
      ifTrue: [
        record := ((self recordOf: req) at: #method put: req method) at: #query put: req queryParams
        self.requests := self.requests at: path put: record
      ]
    raw := self.responses at: path ifAbsent: [nil]
    raw notNil
      ifTrue: [
        ^HTTPResponse
          new: #{
            #status => (raw at: 1),
            #headers => #(#("content-type", raw at: 3)) ++ (raw at: 4),
            #body => (raw at: 2)
          }
      ]
    failure notNil ifTrue: [^self json: (failure at: 2) status: (failure at: 1)]
    path match: [
      "/.well-known/openid-configuration" -> self json: self discoveryDocument status: 200;
      "/authorize" -> self authorizeFor: req;
      "/jwks" -> self jwksResponse;
      "/token" -> self json: self tokenResponse status: 200;
      "/userinfo" -> self userinfoFor: req;
      "/revoke" -> HTTPResponse new: #{#status => 200, #body => ""};
      "/tokeninfo" -> self tokenInfoFor: req;
      "/oauth/token/info" -> self tokenInfoFor: req;
      _ -> HTTPResponse new: #{#status => 404, #body => "not found"}
    ]

  /// The sign-in stand-in: a 302 to the request's `redirect_uri` with
  /// `code`, `state` and `iss`; the request's `nonce` becomes the ID-token
  /// `nonce` claim. 400 without a `redirect_uri`.
  authorizeFor: req :: HTTPRequest -> HTTPResponse =>
    q := req queryParams
    redirect := q at: "redirect_uri" ifAbsent: [""]
    redirect isEmpty ifTrue: [
      ^self json: #{"error" => "invalid_request"} status: 400
    ]
    nonce := q at: "nonce" ifAbsent: [nil]
    nonce isNil ifFalse: [self.claims := self.claims at: "nonce" put: nonce]
    state := q at: "state" ifAbsent: [""]
    query := "code=code-1&state={state urlEncoded}&iss={self.issuer urlEncoded}"
    sep := (redirect includesSubstring: "?") ifTrue: ["&"] ifFalse: ["?"]
    HTTPResponse
      new: #{
        #status => 302,
        #headers => #(#("location", "{redirect}{sep}{query}")),
        #body => ""
      }

  /// The discovery document, overrides applied.
  discoveryDocument -> Dictionary =>
    base := self.issuer
    doc := #{
      "issuer" => base,
      "authorization_endpoint" => "{base}/authorize",
      "token_endpoint" => "{base}/token",
      "userinfo_endpoint" => "{base}/userinfo",
      "jwks_uri" => "{base}/jwks",
      "revocation_endpoint" => "{base}/revoke",
      "response_types_supported" => #("code"),
      "grant_types_supported" => #("authorization_code", "refresh_token"),
      "scopes_supported" => #("openid", "profile", "email"),
      "subject_types_supported" => #("public"),
      "id_token_signing_alg_values_supported" => #("ES256"),
      "token_endpoint_auth_methods_supported" => #("client_secret_basic", "client_secret_post"),
      "code_challenge_methods_supported" => #("S256")
    }
    self merge: self.discoveryOverrides into: doc

  /// The token response: fixed tokens and a freshly signed ID token.
  tokenResponse -> Dictionary =>
    body := #{
      "access_token" => "at-1",
      "token_type" => "Bearer",
      "expires_in" => 3600,
      "refresh_token" => "rt-1",
      "scope" => "openid profile email",
      "id_token" => self idToken
    }
    self merge: self.tokenFields into: body

  /// The ID-token claims: defaults with `claims:` overrides applied.
  idTokenClaims -> Dictionary =>
    now := Erlang erlang system_time: #second
    defaults := #{
      "iss" => self.issuer,
      "sub" => "user-1",
      "aud" => FixtureProvider clientId,
      "iat" => now,
      "exp" => now + 300,
      "nonce" => FixtureProvider nonce
    }
    self merge: self.claims into: defaults

  /// A compact ES256 JWT over `idTokenClaims`, signed with the key.
  idToken -> String =>
    fields := #{"alg" => "ES256", "typ" => "JWT"}
    self.keyId isNil ifFalse: [fields := fields at: "kid" put: self.keyId]
    header := Json generate: fields
    signed := Erlang jose_jwt
      sign: self.key
      with: header
      with: (Json generate: self idTokenClaims)
    {_, compact} := Erlang jose_jws compact: signed
    compact asStringUnchecked

  /// The JWKS: the public half of the key.
  jwksResponse -> HTTPResponse =>
    {_, jwk} := Erlang jose_jwk to_binary: (Erlang jose_jwk to_public: self.key)
    public := (Json parse: jwk asStringUnchecked) unwrap
    self.keyId isNil ifFalse: [public := public at: "kid" put: self.keyId]
    self json: #{"keys" => #(public)} status: 200

  /// Userinfo for a request with a bearer token; 401 without one.
  userinfoFor: req :: HTTPRequest -> HTTPResponse =>
    auth := (self headersOf: req) at: "authorization" ifAbsent: [""]
    (auth startsWith: "Bearer ") ifFalse: [
      ^self json: #{"error" => "invalid_token"} status: 401
    ]
    claims := self idTokenClaims
    self
      json: #{
        "sub" => (claims at: "sub" ifAbsent: [nil]),
        "name" => "Fixture User",
        "email" => "user-1@example.test"
      }
      status: 200

  /// The token-info answer: `tokenInfo:` for the token `at-1`, sent as a
  /// bearer header or an `access_token` parameter; 401 otherwise.
  tokenInfoFor: req :: HTTPRequest -> HTTPResponse =>
    auth := (self headersOf: req) at: "authorization" ifAbsent: [""]
    token := (auth startsWith: "Bearer ") ifTrue: [
      auth drop: 7
    ] ifFalse: [
      ((self recordOf: req) at: #form) at: "access_token" ifAbsent: [""]
    ]
    token =:= "at-1" ifFalse: [
      ^self json: #{"error" => "invalid_token"} status: 401
    ]
    self json: self.tokenInfo status: 200

  /// The form body and headers of `req`, for `lastTokenRequest`.
  recordOf: req :: HTTPRequest -> Dictionary =>
    form := #{}
    pairs := Erlang uri_string dissect_query: req body asStringUnchecked
    pairs
      do: [:pair |
        form := form at: (pair at: 1) asStringUnchecked put: (pair at: 2) asStringUnchecked
      ]
    #{#form => form, #headers => (self headersOf: req)}

  /// Request headers as a Dictionary, names lowercased.
  headersOf: req :: HTTPRequest -> Dictionary =>
    out := #{}
    req headers
      do: [:pair |
        out := out at: (pair at: 1) asStringUnchecked lowercase put: (pair at: 2) asStringUnchecked
      ]
    out

  /// `body` as a JSON response with `status`.
  json: body :: Dictionary status: status :: Integer -> HTTPResponse =>
    HTTPResponse
      new: #{
        #status => status,
        #headers => #(#("content-type", "application/json")),
        #body => (Json generate: body)
      }

  /// `base` with `overrides` applied; a nil override removes the member.
  merge: overrides :: Dictionary into: base :: Dictionary -> Dictionary =>
    out := base
    overrides keysAndValuesDo: [:k :v |
      out := v isNil ifTrue: [out removeKey: k] ifFalse: [out at: k put: v]
    ]
    out

  /// Stop the HTTP server with the actor.
  terminate: _reason :: Object -> Nil =>
    self.server isNil ifFalse: [[self.server stop] on: Exception do: [:e | nil]]
    nil
