/// Test clock: a settable time in milliseconds, read by the block a test
/// injects as `SessionStore`'s `#now`.
Actor subclass: FakeClock
  state: time :: Integer = 0

  time -> Integer => self.time

  time: ms :: Integer -> Nil =>
    self.time := ms
    nil
