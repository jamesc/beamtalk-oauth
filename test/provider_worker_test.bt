// Copyright 2026 James Casey
// SPDX-License-Identifier: Apache-2.0

// ProviderWorker against the local FixtureProvider: the server it builds,
// key rotation, refresh, supervision and status redaction. No test hits
// the network, and none may reach httpc (HttpcGuard), including the
// oidcc worker's own loads.
//
// The exchange goes through the shim's retrieve_token/3; OAuthFlows
// (BT-4562) runs the full flow through a worker in BT-4565's end-to-end
// test.

TestCase subclass: ProviderWorkerTest
  field: provider = nil
  field: worker = nil

  // testUnsafeHttpNeedsTestFlag clears the global
  // beamtalk_oauth/allow_unsafe_http_for_tests flag, which every
  // fixture-backed test class relies on: run alone, not concurrently.
  class serial -> Boolean => true

  setUp =>
    HttpcGuard install
    self.provider := FixtureProvider start
    self

  tearDown =>
    (self.worker notNil and: [self.worker isAlive]) ifTrue: [self.worker stop]
    self.provider stop
    self assert: HttpcGuard calls equals: 0
    nil

  unsafe -> Dictionary => #{#allowUnsafeHttp => true}

  // A worker with the test-only opt-in plus `opts`.
  startWith: opts :: Dictionary -> ProviderWorker =>
    all := self unsafe
    opts keysAndValuesDo: [:k :v | all := all at: k put: v]
    self.worker := (ProviderWorker
      issuer: self.provider issuer
      preset: #{}
      options: all) unwrap
    self.worker

  // Messages waiting in the oidcc worker's mailbox.
  queuedAt: pid -> Integer =>
    {_, n} := Erlang erlang process_info: pid with: #message_queue_len
    n

  start: preset :: Dictionary -> ProviderWorker =>
    self.worker := (ProviderWorker
      issuer: self.provider issuer
      preset: preset
      options: self unsafe) unwrap
    self.worker

  confidential -> Dictionary =>
    #{
      #client_id => FixtureProvider clientId,
      #client_secret => FixtureProvider clientSecret
    }

  codeParams -> Dictionary =>
    #{
      #issuer => self.provider issuer,
      #code => "code-1",
      #redirect_uri => "http://127.0.0.1:50278/callback",
      #nonce => FixtureProvider nonce,
      #pkce_verifier => Secrets generate
    }

  retrieve: server :: OAuthServer client: client :: Dictionary -> Result =>
    self retrieveWith: server context client: client

  // An exchange through a provider context (say one with a small
  // deadline, `with_deadline/2`).
  retrieveWith: context client: client :: Dictionary -> Result =>
    Erlang beamtalk_oauth_oidcc
      retrieve_token: context
      with: client
      with: self codeParams

  // `server`'s context with an operation deadline of `ms` (0 allowed).
  budgeted: server :: OAuthServer ms: ms :: Integer =>
    Erlang beamtalk_oauth_oidcc with_deadline: server context with: ms

  // `result` (a shim answer) failed with the deadline error.
  assertDeadline: result :: Result =>
    self assert: result isError
    err := OAuthError fromOidcc: result error
    self assert: err code equals: "transport"
    self assert: (err description includesSubstring: "deadline exceeded")

  now -> Integer => Erlang erlang monotonic_time: #millisecond

  exchange: server :: OAuthServer -> Dictionary =>
    self assertOk: (self retrieve: server client: self confidential)

  render: term =>
    Erlang unicode characters_to_binary: (Erlang io_lib format: "~p" with: #(term))

  // ===== server =====
  testServerFromWorker =>
    worker := self start: #{}
    server := self assertOk: worker server
    issuer := self.provider issuer
    self assert: worker issuer equals: issuer
    self assert: server issuer equals: issuer
    self assert: server tokenEndpoint equals: "{issuer}/token"
    self assert: server revocationEndpoint equals: "{issuer}/revoke"
    self deny: server context isNil

  testExchangeThroughWorkerServer =>
    server := self assertOk: (self start: #{}) server
    toks := self exchange: server
    self assert: (toks at: #access_token) equals: "at-1"
    self assert: ((toks at: #id_token_claims) at: "sub") equals: "user-1"

  testServerDoesNotRediscover =>
    worker := self start: #{}
    self assertOk: worker server
    self assertOk: worker server
    self assert: (self.provider hits: "/.well-known/openid-configuration") equals: 1
    self assert: (self.provider hits: "/jwks") equals: 1

  // ===== server cache =====
  testServerMakesNoOidccCallWithinTtl =>
    worker := self start: #{}
    first := self assertOk: worker server
    inner := worker oidccWorker
    // A suspended oidcc worker answers nothing and queues every call.
    Erlang sys suspend: inner
    [
      #(1, 2, 3) do: [:i |
        self assert: (self assertOk: worker server) equals: first
      ]
      Erlang timer sleep: 50
      self assert: (self queuedAt: inner) equals: 0
    ] ensure: [Erlang sys resume: inner]

  testServerRereadsAfterTtl =>
    worker := self startWith: #{#cacheTtl => 100}
    self assertOk: worker server
    inner := worker oidccWorker
    Erlang timer sleep: 150
    Erlang sys suspend: inner
    [
      // Still answered from the cache at once; the re-read waits behind.
      self assertOk: worker server
      Erlang timer sleep: 50
      self assert: (self queuedAt: inner) equals: 1
      // One re-read at a time.
      self assertOk: worker server
      Erlang timer sleep: 50
      self assert: (self queuedAt: inner) equals: 1
    ] ensure: [Erlang sys resume: inner]

  testServerFollowsReloadAfterTtl =>
    self.provider keyId: "key-1"
    worker := self startWith: #{#cacheTtl => 100}
    before := self assertOk: worker server
    // The oidcc worker's own reload (as its expiry timer would start it).
    self.provider rotateKeyTo: "key-2"
    Erlang gen_server cast: worker oidccWorker with: #refresh_jwks
    Erlang timer sleep: 150
    // The first call after the TTL answers the old keys and re-reads.
    self assert: (self assertOk: worker server) equals: before
    Erlang timer sleep: 100
    after := self assertOk: worker server
    self deny: after =:= before
    // The re-read keys hold key-2: no unknown-kid reload is needed.
    self exchange: after
    self assert: (self.provider hits: "/jwks") equals: 2

  testBackgroundLoadsIgnoreDeadline =>
    // The worker's own loads are not operations: a slow JWKS load longer
    // than #deadline still lands.
    self.provider keyId: "key-1"
    worker := self startWith: #{#cacheTtl => 100, #deadline => 100}
    before := self assertOk: worker server
    self.provider rotateKeyTo: "key-2"
    self.provider slow: "/jwks" by: 400
    Erlang gen_server cast: worker oidccWorker with: #refresh_jwks
    Erlang timer sleep: 600
    self assert: (self assertOk: worker server) equals: before
    Erlang timer sleep: 100
    after := self assertOk: worker server
    self deny: after =:= before
    self.provider slow: "/jwks" by: 0
    self exchange: after
    self assert: (self.provider hits: "/jwks") equals: 2

  testBadCacheOptionsAreRefused =>
    #(#cacheTtl, #minJwksReloadInterval)
      do: [:opt |
        #(-1, "soon")
          do: [:value |
            err := (ProviderWorker
              issuer: self.provider issuer
              preset: #{}
              options: (self unsafe at: opt put: value)) error
            self assert: err code equals: "config"
            self assert: (err description includesSubstring: opt asString)
          ]
      ]

  testBadDeadlineIsRefused =>
    #(0, -1, "soon")
      do: [:value |
        err := (ProviderWorker
          issuer: self.provider issuer
          preset: #{}
          options: (self unsafe at: #deadline put: value)) error
        self assert: err code equals: "config"
        self assert: (err description includesSubstring: "deadline")
      ]

  testDeadlineOptionReachesServer =>
    worker := self startWith: #{#deadline => 300}
    server := self assertOk: worker server
    self.provider slow: "/token" by: 1000
    before := self now
    result := self retrieve: server client: self confidential
    self assertDeadline: result
    self assert: self now - before < 800

  testPresetQuirksApply =>
    preset := ProviderPresets gitlab
    server := self assertOk: (self start: preset) server
    self assert: server preset equals: preset
    // The preset's endpoint, moved onto the discovered issuer (BT-4575).
    self assert: server tokenInfoEndpoint equals: "{self.provider issuer}/oauth/token/info"
    // The gitlab preset adds "none", so a public client can exchange.
    public := #{#client_id => FixtureProvider clientId, #client_secret => nil}
    self assertOk: (self retrieve: server client: public)

  // ===== key rotation =====
  testRotatedKeyValidatesAndIsKept =>
    self.provider keyId: "key-1"
    worker := self start: #{}
    server := self assertOk: worker server
    self exchange: server
    self.provider rotateKeyTo: "key-2"
    // The server's keys predate the rotation; the unknown kid makes the
    // worker reload its JWKS.
    self exchange: server
    self assert: (self.provider hits: "/jwks") equals: 2
    // The worker kept the new key: a fresh server validates without
    // another JWKS load.
    self exchange: (self assertOk: worker server)
    self assert: (self.provider hits: "/jwks") equals: 2

  testUnknownKidReloadIsRateLimited =>
    self.provider keyId: "key-1"
    worker := self start: #{}
    server := self assertOk: worker server
    self exchange: server
    self.provider rotateKeyTo: "key-2"
    self exchange: server
    self assert: (self.provider hits: "/jwks") equals: 2
    // Within #minJwksReloadInterval (30 s by default) an unknown kid gets
    // the kept keys and no fetch, so validation fails.
    self.provider rotateKeyTo: "key-3"
    self assert: (self retrieve: server client: self confidential) isError
    self assert: (self retrieve: (self assertOk: worker server) client: self confidential) isError
    self assert: (self.provider hits: "/jwks") equals: 2

  testUnknownKidReloadsAgainAfterInterval =>
    self.provider keyId: "key-1"
    worker := self startWith: #{#minJwksReloadInterval => 200}
    server := self assertOk: worker server
    self.provider rotateKeyTo: "key-2"
    self exchange: server
    self.provider rotateKeyTo: "key-3"
    Erlang timer sleep: 250
    self exchange: server
    self assert: (self.provider hits: "/jwks") equals: 3

  testWithinIntervalGetsTheKeptKeys =>
    // A server built before a reload gets the worker's newer keys, without
    // a fetch, for a kid they hold.
    self.provider keyId: "key-1"
    worker := self start: #{}
    old := self assertOk: worker server
    other := self assertOk: worker server
    self.provider rotateKeyTo: "key-2"
    self exchange: old
    self exchange: other
    self assert: (self.provider hits: "/jwks") equals: 2

  testUnknownKidDuringReloadWaitsForIt =>
    self.provider keyId: "key-1"
    worker := self start: #{}
    server := self assertOk: worker server
    self.provider rotateKeyTo: "key-2"
    self.provider slow: "/jwks" by: 300
    table := Ets new: #bt4578_kid_reload type: #set
    this := self
    [
      ok := (this retrieve: server client: this confidential) isOk
      table at: #first put: ok
    ] fork
    Erlang timer sleep: 100
    // The forked exchange's reload is under way: this one waits for its
    // keys instead of failing with the old ones.
    self exchange: server
    tries := 0
    [(table at: #first) isNil and: [tries < 100]]
      whileTrue: [
        tries := tries + 1
        Erlang timer sleep: 20
      ]
    self assert: (table at: #first) equals: true
    self assert: (self.provider hits: "/jwks") equals: 2
    table delete

  testFailedWorkerReloadFallsBackToDirect =>
    self.provider keyId: "key-1"
    worker := self startWith: #{#backoffMin => 60000, #backoffMax => 60000}
    server := self assertOk: worker server
    self exchange: server
    self.provider rotateKeyTo: "key-2"
    // The worker's reload gets a 503 and keeps the old keys; validation
    // then loads the keys itself.
    self.provider failNext: "/jwks" times: 1
    self exchange: server
    self assert: (self.provider hits: "/jwks") equals: 3
    // The directly loaded keys went back to the worker: a fresh server
    // validates key-2 without another fetch.
    self exchange: (self assertOk: worker server)
    self exchange: server
    self assert: (self.provider hits: "/jwks") equals: 3

  testAfterFailedReloadOnlyDirectLoads =>
    // After a reload that failed, the worker casts no further oidcc reload
    // (each would start its own oidcc backoff retry chain): the next
    // unknown kid, past the interval, is one direct load.
    self.provider keyId: "key-1"
    worker := self startWith: #{
      #backoffMin => 60000,
      #backoffMax => 60000,
      #minJwksReloadInterval => 200
    }
    server := self assertOk: worker server
    self.provider rotateKeyTo: "key-2"
    // Both the worker's reload and the direct load fail.
    self.provider failNext: "/jwks" times: 2
    self assert: (self retrieve: server client: self confidential) isError
    self assert: (self.provider hits: "/jwks") equals: 3
    Erlang timer sleep: 250
    self exchange: server
    self assert: (self.provider hits: "/jwks") equals: 4

  testRotationAfterWorkerStopsStillValidates =>
    self.provider keyId: "key-1"
    worker := self start: #{}
    server := self assertOk: worker server
    worker stop
    self.provider rotateKeyTo: "key-2"
    self exchange: server

  testRefreshReloads =>
    worker := self start: #{}
    self assertOk: worker server
    self assert: worker refresh equals: nil
    self assert: (self.provider hits: "/.well-known/openid-configuration") equals: 2
    self assert: (self.provider hits: "/jwks") equals: 2

  // ===== configuration errors =====
  testInsecureIssuerIsRefused =>
    err := (ProviderWorker issuer: "http://example.com") error
    self assert: err code equals: "insecure_endpoint"
    // The fixture is plain HTTP: refused without the test-only opt-in.
    local := (ProviderWorker issuer: self.provider issuer) error
    self assert: local code equals: "insecure_endpoint"

  testUnknownOptionIsRefused =>
    err := (ProviderWorker
      issuer: self.provider issuer
      preset: #{}
      options: #{#allowUnsafeHttp => true, #bogus => 1}) error
    self assert: err code equals: "config"
    self assert: (err description includesSubstring: "bogus")

  testPresetWithoutIssuerIsRefused =>
    self assert: (ProviderWorker preset: #{}) error code equals: "config"

  testUnreachableProviderIsUnavailable =>
    self.worker := self unreachableWorker
    self assert: self.worker server error code equals: "provider_unavailable"
    self assert: self.worker isAlive

  testRefreshBeforeFirstLoadKeepsRunning =>
    // A JWKS reload with no configuration would crash the oidcc worker.
    self.worker := self unreachableWorker
    self assert: self.worker refresh equals: nil
    self assert: self.worker isAlive
    self assert: self.worker server error code equals: "provider_unavailable"

  testStopBackoffIsRefused =>
    err := (ProviderWorker
      issuer: self.provider issuer
      preset: #{}
      options: #{#allowUnsafeHttp => true, #backoffType => #stop}) error
    self assert: err code equals: "config"

  testPlainHttpJwksIsNeverFetched =>
    // oidcc accepts a plain-HTTP jwks_uri and its worker fetches it as soon
    // as the configuration loads; the adapter refuses that request. The
    // host is under .invalid (RFC 2606), so nothing could be contacted even
    // if the refusal broke; the refusal event proves the adapter stopped it.
    log := EventLog spawn
    log listenTo: #(#beamtalk_oauth, #http_adapter, #refused)
    self.provider discoveryOverrides: #{
      "jwks_uri" => "http://jwks.invalid/jwks"
    }
    self.worker := (ProviderWorker
      issuer: self.provider issuer
      preset: #{}
      options: #{
        #allowUnsafeHttp => true,
        #backoffMin => 60000,
        #backoffMax => 60000
      }) unwrap
    tries := 0
    [log events isEmpty and: [tries < 100]]
      whileTrue: [
        tries := tries + 1
        Erlang timer sleep: 20
      ]
    log detach
    self assert: log events equals: #(#{#reason => #insecure_url})
    self assert: (Erlang gen_server call: self.worker oidccWorker with: #get_jwks) equals: #undefined
    self assert: self.worker server error code equals: "insecure_endpoint"
    self assert: self.worker isAlive
    log stop

  testServerAnswersFromCacheDuringReload =>
    worker := self start: #{}
    self assertOk: worker server
    // A reload against a slow provider: the oidcc worker answers nothing
    // until it finishes.
    self.provider slow: "/.well-known/openid-configuration" by: 3000
    Erlang gen_server cast: worker oidccWorker with: #refresh_configuration
    Erlang timer sleep: 200
    before := Erlang erlang monotonic_time: #millisecond
    server := self assertOk: worker server
    elapsed := (Erlang erlang monotonic_time: #millisecond) - before
    self assert: elapsed < 2000
    self exchange: server

  testRefreshIsRateLimited =>
    self.worker := (ProviderWorker
      issuer: self.provider issuer
      preset: #{}
      options: #{
        #allowUnsafeHttp => true,
        #backoffMin => 60000,
        #backoffMax => 60000
      }) unwrap
    self assertOk: self.worker server
    self.worker refresh
    self.worker refresh
    self assert: (self.provider hits: "/.well-known/openid-configuration") equals: 2

  testRefreshDuringOutageAddsNoRetryChain =>
    self refreshDuringOutage: [:path | self.provider failNext: path times: 1000]

  testRefreshDuringMaintenancePageAddsNoRetryChain =>
    // A 200 that is not a JSON document fails the oidcc load all the same.
    self
      refreshDuringOutage: [:path |
        self.provider
          respond: path
          status: 200
          body: "<html>down for maintenance</html>"
          contentType: "text/html"
      ]

  // BT-4618: each failed oidcc load starts its own backoff retry chain, so
  // refresh leaves a part whose last load failed to the chain already
  // retrying it. `breakPath` makes the provider fail loads of a path.
  refreshDuringOutage: breakPath :: Block =>
    discovery := "/.well-known/openid-configuration"
    self.worker := (ProviderWorker
      issuer: self.provider issuer
      preset: #{}
      options: #{
        #allowUnsafeHttp => true,
        #backoffMin => 50,
        #backoffMax => 400,
        #backoffType => #exponential
      }) unwrap
    self assertOk: self.worker server
    loads := [(self.provider hits: discovery) + (self.provider hits: "/jwks")]
    base := loads value
    // The provider goes down: both loads fail.
    breakPath value: discovery
    breakPath value: "/jwks"
    #(1, 2, 3, 4, 5, 6)
      do: [:i |
        self assert: self.worker refresh equals: nil
        Erlang timer sleep: 60
      ]
    // The first refresh's two loads, then the two chains' retries, their
    // shared backoff doubling from 50 ms: the configuration at 50 and
    // 250 ms, the JWKS at 100 (and maybe 500) ms. A chain per refresh
    // would add two loads per refresh, 12 in all.
    outage := loads value - base
    self assert: outage >= 2
    self assert: outage <= 7
    // The provider recovers; each chain's next retry (within 400 ms)
    // succeeds, and refresh reloads both again.
    self.provider reset
    Erlang timer sleep: 900
    before := loads value
    self.worker refresh
    self assert: loads value equals: before + 2

  testRefreshDuringRunningLoadAddsNoReload =>
    // A provider that hangs: a reload cast while a load runs would queue
    // behind it, fail with it, and start a second retry chain.
    srv := HTTPServer
      start: 0
      handler: [:req |
        Erlang timer sleep: 600
        HTTPResponse new: #{#status => 503}
      ]
    self.worker := (ProviderWorker
      issuer: "http://127.0.0.1:{srv port}"
      preset: #{}
      options: #{
        #allowUnsafeHttp => true,
        #backoffMin => 60000,
        #backoffMax => 60000
      }) unwrap
    inner := self.worker oidccWorker
    // The first load is under way.
    Erlang timer sleep: 100
    worker := self.worker
    [worker refresh] fork
    Erlang timer sleep: 100
    // Only the refresh's read waits; no reload was cast.
    self assert: (self queuedAt: inner) equals: 1
    Erlang timer sleep: 700
    srv stop

  testKidReloadWithNoLoadLeavesRefreshFree =>
    // An unknown-kid reload counts the JWKS as loading from its cast; when
    // the oidcc worker already has the key no load starts, and refresh
    // must still reload the JWKS afterwards.
    self.provider keyId: "key-1"
    worker := self startWith: #{#minJwksReloadInterval => 0, #backoffMin => 50}
    old := self assertOk: worker server
    self.provider rotateKeyTo: "key-2"
    self exchange: old
    self assert: (self.provider hits: "/jwks") equals: 2
    // The oidcc worker holds key-2 now: this reload loads nothing.
    self exchange: old
    self assert: (self.provider hits: "/jwks") equals: 2
    Erlang timer sleep: 60
    worker refresh
    self assert: (self.provider hits: "/jwks") equals: 3

  testOddTimeoutStillTracksLoads =>
    // A #timeout the request options drop (not a positive Integer) falls
    // back to oidcc's default, for the load tracking too.
    #(0, -5, "soon")
      do: [:value |
        worker := self startWith: #{#timeout => value}
        self assertOk: worker server
        worker stop
      ]

  testSpentDeadlineAsksNoWorkerReload =>
    self.provider keyId: "key-1"
    worker := self start: #{}
    server := self assertOk: worker server
    self.provider rotateKeyTo: "key-2"
    // The unknown-kid refresh of an operation whose deadline is already
    // spent (as by a slow token request).
    opts := Erlang beamtalk_oauth_oidcc call_opts: (self budgeted: server ms: 1)
    Erlang timer sleep: 20
    refreshed := (opts at: #refresh_jwks) value: nil value: "key-2"
    self assert: refreshed equals: {#error, #deadline_exceeded}
    // No reload was asked of the worker (one would land within this).
    Erlang timer sleep: 200
    self assert: (self.provider hits: "/jwks") equals: 1
    // None used up the worker's interval: the next exchange reloads.
    self exchange: server
    self assert: (self.provider hits: "/jwks") equals: 2

  testSlowWorkerReloadIsBoundedByDeadline =>
    self.provider keyId: "key-1"
    worker := self start: #{}
    server := self assertOk: worker server
    self.provider rotateKeyTo: "key-2"
    self.provider slow: "/jwks" by: 1500
    before := self now
    result := self retrieveWith: (self budgeted: server ms: 300) client: self confidential
    elapsed := self now - before
    // The wait for the worker's slow reload ends with the deadline.
    self assertDeadline: result
    self assert: elapsed < 1200

  testSlowDirectLoadIsBoundedByDeadline =>
    self.provider keyId: "key-1"
    worker := self startWith: #{
      #backoffMin => 60000,
      #backoffMax => 60000,
      #minJwksReloadInterval => 0
    }
    server := self assertOk: worker server
    self.provider rotateKeyTo: "key-2"
    // The worker's reload and the direct load both fail: the worker then
    // answers at once that the caller should load the keys itself.
    self.provider failNext: "/jwks" times: 2
    self assert: (self retrieve: server client: self confidential) isError
    self.provider slow: "/jwks" by: 1500
    before := self now
    result := self retrieveWith: (self budgeted: server ms: 300) client: self confidential
    elapsed := self now - before
    // The direct load times out at what is left of the deadline.
    self assertDeadline: result
    self assert: elapsed < 1200
    self assert: (self.provider hits: "/jwks") equals: 4

  testUnsafeHttpNeedsTestFlag =>
    unset := [
      Erlang application
        set_env: #beamtalk_oauth
        with: #allow_unsafe_http_for_tests
        with: false
    ]
    restore := [
      Erlang application
        set_env: #beamtalk_oauth
        with: #allow_unsafe_http_for_tests
        with: true
    ]
    unset value
    [
      worker := ProviderWorker
        issuer: self.provider issuer
        preset: #{}
        options: self unsafe
      self assert: worker error code equals: "config"
      server := OAuthServer
        fromDiscovery: self.provider issuer
        preset: #{}
        options: self unsafe
      self assert: server error code equals: "unsafe_http_disabled"
    ] ensure: restore

  // A worker for a closed port, retrying only once a minute.
  unreachableWorker -> ProviderWorker =>
    srv := HTTPServer start: 0 handler: [:req |
      HTTPResponse new: #{#status => 404}
    ]
    port := srv port
    srv stop
    (ProviderWorker
      issuer: "http://127.0.0.1:{port}"
      preset: #{}
      options: #{
        #allowUnsafeHttp => true,
        #backoffMin => 60000,
        #backoffMax => 60000
      }) unwrap

  // ===== process =====
  testStatusShowsNoSecrets =>
    worker := self start: ProviderPresets gitlab
    self exchange: (self assertOk: worker server)
    text := self render: (Erlang sys get_status: worker pid)
    self assert: (text includesSubstring: "127.0.0.1")
    self deny: (text includesSubstring: FixtureProvider clientSecret)
    self deny: (text includesSubstring: "request_opts")
    self deny: (text includesSubstring: "document_overrides")
    // The oidcc worker holds the load options and the public configuration
    // and keys; no client credential ever reaches it.
    inner := self render: (Erlang sys get_status: worker oidccWorker)
    self assert: (inner includesSubstring: "127.0.0.1")
    self deny: (inner includesSubstring: FixtureProvider clientSecret)

  testStopStopsOidccWorker =>
    worker := self start: #{}
    inner := worker oidccWorker
    self assert: (Erlang erlang is_process_alive: inner)
    worker stop
    self deny: (Erlang erlang is_process_alive: inner)

  testSupervisedChild =>
    sup := ProviderWorkerSup spawnWith: #{
      #issuer => self.provider issuer,
      #options => self unsafe
    }
    child := self providerChildOf: sup
    self exchange: (self assertOk: child server)
    // The oidcc worker crashing takes the ProviderWorker with it, and the
    // supervisor restarts both.
    Erlang erlang exit: child oidccWorker with: #kill
    restarted := self waitForRestartOf: child in: sup
    self exchange: (self assertOk: restarted server)
    sup stop

  testSupervisionSpecForBadConfigRaises =>
    self should: [
      ProviderWorker supervisionSpecFor: #{#preset => 1}
    ] raise: #signal
    self should: [ProviderWorker supervisionSpecFor: #{}] raise: #signal

  testStartBadConfigRaises =>
    self should: [ProviderWorker start: #{}] raise: #signal

  // The running #provider child once it is no longer `old`.
  // The supervisor's #provider child (childWithId: answers it untyped).
  providerChildOf: sup :: ProviderWorkerSup -> Dynamic =>
    (sup childWithId: #provider) unwrap

  waitForRestartOf: old in: sup :: ProviderWorkerSup =>
    current := nil
    tries := 0
    [current isNil and: [tries < 100]]
      whileTrue: [
        tries := tries + 1
        found := [(sup childWithId: #provider) unwrap] on: Error do: [:e | nil]
        (found notNil and: [
          (found pid =:= old pid) not
        ]) ifTrue: [current := found] ifFalse: [Erlang timer sleep: 20]
      ]
    self deny: current isNil
    current
