// OAuthFlows against the FixtureProvider: the authorization URL, the
// callback, the code exchange, refresh and userinfo. No test hits the
// network, and none may reach httpc (HttpcGuard).

TestCase subclass: OAuthFlowsTest
  field: provider = nil
  field: server = nil
  field: reg = nil
  field: store = nil
  field: binding = nil

  setUp =>
    HttpcGuard install
    self.provider := FixtureProvider start
    self.server := self discover: #{}
    self.reg := (ClientRegistration
      forClient: FixtureProvider clientId
      secret: FixtureProvider clientSecret
      redirect: self redirectUri) unwrap
    self.store := SessionStore spawn
    self.binding := Secrets generate
    self

  tearDown =>
    self.store stop
    self.provider stop
    self assert: HttpcGuard calls equals: 0
    nil

  redirectUri -> String => "http://127.0.0.1:50278/callback"

  // Discover the fixture provider with `preset`.
  discover: preset :: Dictionary -> OAuthServer =>
    (OAuthServer
      fromDiscovery: self.provider issuer
      preset: preset
      options: #{#allowUnsafeHttp => true}) unwrap

  // A fresh session for the fixture, stored under the test's binding, with
  // the fixture's ID token carrying its nonce.
  newSession -> OAuthSession =>
    sess := OAuthSession newSessionFor: self.server client: self.reg
    self.store create: sess boundTo: self.binding
    self.provider claims: #{"nonce" => sess nonce}
    sess

  // A real callback (with its ticket) for the stored session with `sess`'s
  // state, then carrying `sess` itself, so a test can tamper with the
  // session and still get past the ticket check.
  callbackFor: sess :: OAuthSession -> Callback =>
    cb := (OAuthFlows
      handleCallback: #(#("code", "code-1"), #("state", sess state))
      store: self.store
      boundTo: self.binding) unwrap
    cb withSession: sess

  // `self exchange:client:callback:store:` with the test's store.
  exchange: server :: OAuthServer client: reg :: ClientRegistration callback: cb :: Callback -> Result =>
    OAuthFlows
      exchangeCode: server
      client: reg
      callback: cb
      store: self.store

  // A completed code exchange.
  exchange -> TokenSet =>
    sess := self newSession
    (self
      exchange: self.server
      client: self.reg
      callback: (self callbackFor: sess)) unwrap

  // The query of `url` as a Dictionary.
  queryOf: url :: String -> Object => OAuthFlows parseQuery: url

  codeOf: result :: Result -> String => result error code

  // ===== Authorization URL =====
  testAuthorizeUrlContents =>
    sess := self newSession
    url := (OAuthFlows
      authorizeUrl: self.server
      client: self.reg
      scopes: #("openid", "profile")
      session: sess) unwrap
    self assert: (url startsWith: "{self.provider issuer}/authorize?")
    q := self queryOf: url
    self assert: (q at: "response_type") equals: "code"
    self assert: (q at: "client_id") equals: FixtureProvider clientId
    self assert: (q at: "redirect_uri") equals: self redirectUri
    self assert: (q at: "state") equals: sess state
    self assert: (q at: "nonce") equals: sess nonce
    self assert: (q at: "scope") equals: "openid profile"
    self assert: (q at: "code_challenge_method") equals: "S256"
    challenge := (Erlang crypto hash: #sha256 with: sess codeVerifier) asBase64Url replaceAll: "=" with: ""
    self assert: (q at: "code_challenge") equals: challenge
    self deny: (url includesSubstring: sess codeVerifier)
    // Building the URL makes no request.
    self assert: self.provider lastTokenRequest equals: nil

  testAuthorizeUrlAddsOpenidAndExtras =>
    self.server := self discover: #{
      #authorizeParams => #{"access_type" => "offline", "prompt" => "none"}
    }
    sess := self newSession
    url := (OAuthFlows
      authorizeUrl: self.server
      client: self.reg
      scopes: #("profile")
      session: sess
      extraParams: #{#prompt => "consent", "login_hint" => "a@b.test"}) unwrap
    q := self queryOf: url
    self assert: (q at: "scope") equals: "openid profile"
    self assert: (q at: "access_type") equals: "offline"
    self assert: (q at: "prompt") equals: "consent"
    self assert: (q at: "login_hint") equals: "a@b.test"

  testAuthorizeUrlRefusesReservedExtras =>
    sess := self newSession
    #("state", "code_challenge_method", "nonce", "redirect_uri", "iss", "jti")
      do: [:name |
        got := OAuthFlows
          authorizeUrl: self.server
          client: self.reg
          scopes: #("openid")
          session: sess
          extraParams: (#{} at: name put: "x")
        self assert: (self codeOf: got) equals: "config"
      ]

  testAuthorizeUrlRequiresS256 =>
    self.provider discoveryOverrides: #{
      "code_challenge_methods_supported" => #("plain")
    }
    self.server := self discover: #{}
    got := OAuthFlows
      authorizeUrl: self.server
      client: self.reg
      scopes: #("openid")
      session: self newSession
    self assert: (self codeOf: got) equals: "no_supported_code_challenge"
    self.provider discoveryOverrides: #{
      "code_challenge_methods_supported" => nil
    }
    self.server := self discover: #{}
    missing := OAuthFlows
      authorizeUrl: self.server
      client: self.reg
      scopes: #("openid")
      session: self newSession
    self assert: (self codeOf: missing) equals: "no_supported_code_challenge"

  testAuthorizeUrlChecksSessionAndRedirect =>
    sess := self newSession
    other := sess withIssuer: "https://other.test"
    got := OAuthFlows
      authorizeUrl: self.server
      client: self.reg
      scopes: #("openid")
      session: other
    self assert: (self codeOf: got) equals: "session_mismatch"
    // A registration built without validation is re-checked.
    bad := self.reg withRedirectUri: "http://localhost/cb"
    badSess := sess withRedirectUri: "http://localhost/cb"
    refused := OAuthFlows
      authorizeUrl: self.server
      client: bad
      scopes: #("openid")
      session: badSess
    self assert: (self codeOf: refused) equals: "insecure_endpoint"

  // ===== Callback =====
  testHandleCallback =>
    sess := self newSession
    query := #(#("code", "code-9"), #("state", sess state), #("iss", self.provider issuer))
    cb := (OAuthFlows
      handleCallback: query
      store: self.store
      boundTo: self.binding) unwrap
    self assert: cb code equals: "code-9"
    self assert: cb iss equals: self.provider issuer
    self assert: cb session state equals: sess state
    self assert: cb session nonce equals: sess nonce
    self deny: (cb printString includesSubstring: "code-9")
    // Single use.
    again := OAuthFlows
      handleCallback: query
      store: self.store
      boundTo: self.binding
    self assert: (self codeOf: again) equals: "reused_state"

  testHandleCallbackAcceptsQueryStringAndUrl =>
    sess := self newSession
    raw := "?code=abc&state={sess state}"
    cb := (OAuthFlows
      handleCallback: raw
      store: self.store
      boundTo: self.binding) unwrap
    self assert: cb code equals: "abc"
    self assert: cb iss equals: nil
    sess2 := self newSession
    url := "{self redirectUri}?code=def&state={sess2 state}"
    cb2 := (OAuthFlows
      handleCallback: url
      store: self.store
      boundTo: self.binding) unwrap
    self assert: cb2 code equals: "def"
    sess3 := self newSession
    dict := #{"code" => "ghi", "state" => sess3 state}
    cb3 := (OAuthFlows
      handleCallback: dict
      store: self.store
      boundTo: self.binding) unwrap
    self assert: cb3 code equals: "ghi"

  testDuplicateCallbackParameterIsParseError =>
    sess := self newSession
    raw := "code=a&state={sess state}&state={sess state}"
    got := OAuthFlows
      handleCallback: raw
      store: self.store
      boundTo: self.binding
    self assert: (self codeOf: got) equals: "parse"
    dupCode := OAuthFlows
      handleCallback: #(#("code", "a"), #("code", "b"), #("state", sess state))
      store: self.store
      boundTo: self.binding
    self assert: (self codeOf: dupCode) equals: "parse"
    // The named session was burned on the first failure.
    self assert: self.store size equals: 0

  testMissingCodeOrStateIsParseError =>
    sess := self newSession
    noCode := OAuthFlows
      handleCallback: "state={sess state}"
      store: self.store
      boundTo: self.binding
    self assert: (self codeOf: noCode) equals: "parse"
    // The session named by the failed callback is burned.
    self assert: self.store size equals: 0
    sess := self newSession
    noState := OAuthFlows
      handleCallback: "code=a"
      store: self.store
      boundTo: self.binding
    self assert: (self codeOf: noState) equals: "parse"
    emptyCode := OAuthFlows
      handleCallback: "code=&state={sess state}"
      store: self.store
      boundTo: self.binding
    self assert: (self codeOf: emptyCode) equals: "parse"
    flag := OAuthFlows
      handleCallback: "code&state={sess state}"
      store: self.store
      boundTo: self.binding
    self assert: (self codeOf: flag) equals: "parse"
    self
      assert: (self
        codeOf: (OAuthFlows
          handleCallback: 42
          store: self.store
          boundTo: self.binding))
      equals: "parse"
    self assert: self.store size equals: 0

  testProviderErrorIsVerbatimAndBurnsSession =>
    sess := self newSession
    raw := "error=access_denied&error_description=User%20said%20no&state={sess state}"
    got := OAuthFlows
      handleCallback: raw
      store: self.store
      boundTo: self.binding
    err := got error
    self assert: err code equals: "access_denied"
    self assert: err description equals: "User said no"
    self assert: self.store size equals: 0

  testProviderErrorWithWrongBindingIsSessionMismatch =>
    sess := self newSession
    raw := "error=access_denied&state={sess state}"
    got := OAuthFlows
      handleCallback: raw
      store: self.store
      boundTo: Secrets generate
    self assert: (self codeOf: got) equals: "session_mismatch"

  testMismatchedBindingIsSessionMismatch =>
    sess := self newSession
    raw := "code=a&state={sess state}"
    got := OAuthFlows
      handleCallback: raw
      store: self.store
      boundTo: Secrets generate
    self assert: (self codeOf: got) equals: "session_mismatch"
    // The probed session is burned.
    retry := OAuthFlows
      handleCallback: raw
      store: self.store
      boundTo: self.binding
    self assert: (self codeOf: retry) equals: "reused_state"

  testCallbackIssMustMatchSession =>
    sess := self newSession
    query := #(#("code", "a"), #("state", sess state), #("iss", "https://attacker.test"))
    got := OAuthFlows
      handleCallback: query
      store: self.store
      boundTo: self.binding
    self assert: (self codeOf: got) equals: "issuer_mismatch"
    self assert: self.store size equals: 0

  // ===== Code exchange =====
  testExchangeCode =>
    before := TokenSet now
    sess := self newSession
    toks := (self
      exchange: self.server
      client: self.reg
      callback: (self callbackFor: sess)) unwrap
    self assert: toks accessToken equals: "at-1"
    self assert: toks refreshToken equals: "rt-1"
    self assert: toks expiresIn equals: 3600
    self assert: toks scope equals: "openid profile email"
    self assert: toks subject equals: "user-1"
    self assert: (toks idTokenClaims at: "nonce") equals: sess nonce
    self assert: (toks idToken startsWith: "eyJ")
    self assert: toks obtainedAt >= before
    self assert: toks obtainedAt <= TokenSet now

  testTokenRequestCarriesPkceAndClientAuth =>
    sess := self newSession
    (self
      exchange: self.server
      client: self.reg
      callback: (self callbackFor: sess)) unwrap
    form := self.provider lastTokenRequest at: #form
    self assert: (form at: "grant_type") equals: "authorization_code"
    self assert: (form at: "code") equals: "code-1"
    self assert: (form at: "redirect_uri") equals: self redirectUri
    self assert: (form at: "code_verifier") equals: sess codeVerifier
    self assert: (form at: "client_id") equals: FixtureProvider clientId
    self assert: (form at: "client_secret") equals: FixtureProvider clientSecret

  testFullFlowThroughCallback =>
    sess := self newSession
    url := (OAuthFlows
      authorizeUrl: self.server
      client: self.reg
      scopes: #("openid")
      session: sess) unwrap
    state := (self queryOf: url) at: "state"
    cb := (OAuthFlows
      handleCallback: #(#("code", "code-1"), #("state", state), #("iss", self.provider issuer))
      store: self.store
      boundTo: self.binding) unwrap
    toks := (self
      exchange: self.server
      client: self.reg
      callback: cb) unwrap
    self assert: toks subject equals: "user-1"

  testNonceMismatchIsMissingClaim =>
    sess := self newSession
    self.provider claims: #{"nonce" => "someone-elses"}
    got := self
      exchange: self.server
      client: self.reg
      callback: (self callbackFor: sess)
    self assert: (self codeOf: got) equals: "missing_claim"
    self deny: (got error printString includesSubstring: "someone-elses")
    detail := got error detail printString
    self deny: (detail includesSubstring: "someone-elses")
    self deny: (detail includesSubstring: sess nonce)

  testWrongIssuerIsRejectedBeforeNetwork =>
    sess := (self newSession) withIssuer: "https://other.test"
    got := self
      exchange: self.server
      client: self.reg
      callback: (self callbackFor: sess)
    self assert: (self codeOf: got) equals: "session_mismatch"
    self assert: self.provider lastTokenRequest equals: nil

  testWrongRedirectIsRejectedBeforeNetwork =>
    sess := (self newSession) withRedirectUri: "http://127.0.0.1:9999/callback"
    got := self
      exchange: self.server
      client: self.reg
      callback: (self callbackFor: sess)
    self assert: (self codeOf: got) equals: "session_mismatch"
    self assert: self.provider lastTokenRequest equals: nil

  testInsecureRedirectIsRejectedBeforeNetwork =>
    uri := "http://example.test/callback"
    sess := (self newSession) withRedirectUri: uri
    got := self
      exchange: self.server
      client: (self.reg withRedirectUri: uri)
      callback: (self callbackFor: sess)
    self assert: (self codeOf: got) equals: "insecure_endpoint"
    self assert: self.provider lastTokenRequest equals: nil

  testHandBuiltServerIssuerIsCheckedAgainstContext =>
    // A server pairing one issuer with another provider's context.
    forged := self.server withIssuer: "https://forged.test"
    sess := (self newSession) withIssuer: "https://forged.test"
    got := self
      exchange: forged
      client: self.reg
      callback: (self callbackFor: sess)
    self assert: (self codeOf: got) equals: "session_mismatch"
    self assert: self.provider lastTokenRequest equals: nil
    url := OAuthFlows
      authorizeUrl: forged
      client: self.reg
      scopes: #("openid")
      session: sess
    self assert: (self codeOf: url) equals: "session_mismatch"

  testCallbackIssIsCheckedAtExchange =>
    sess := self newSession
    cb := (self callbackFor: sess) withIss: "https://other.test"
    got := self
      exchange: self.server
      client: self.reg
      callback: cb
    self assert: (self codeOf: got) equals: "issuer_mismatch"
    self assert: self.provider lastTokenRequest equals: nil

  testIssRequiredWhenAdvertised =>
    self.provider discoveryOverrides: #{
      "authorization_response_iss_parameter_supported" => true
    }
    self.server := self discover: #{}
    sess := self newSession
    got := self
      exchange: self.server
      client: self.reg
      callback: (self callbackFor: sess)
    self assert: (self codeOf: got) equals: "issuer_mismatch"
    self assert: self.provider lastTokenRequest equals: nil
    sess2 := self newSession
    withIss := (OAuthFlows
      handleCallback: #(#("code", "code-1"), #("state", sess2 state), #("iss", self.provider issuer))
      store: self.store
      boundTo: self.binding) unwrap
    self
      assert: (self
        exchange: self.server
        client: self.reg
        callback: withIss) isOk

  testInvalidGrantPassesThrough =>
    sess := self newSession
    self.provider
      fail: "/token"
      status: 400
      body: #{"error" => "invalid_grant", "error_description" => "code expired"}
    err := (self
      exchange: self.server
      client: self.reg
      callback: (self callbackFor: sess)) error
    self assert: err code equals: "invalid_grant"
    self assert: err status equals: 400
    self assert: err description equals: "code expired"

  // ===== Refresh =====
  testRefreshMergesResponse =>
    toks := self exchange
    self.provider tokenFields: #{
      "access_token" => "at-2",
      "refresh_token" => nil
    }
    fresh := (OAuthFlows
      refresh: self.server
      client: self.reg
      tokenSet: toks) unwrap
    self assert: fresh accessToken equals: "at-2"
    // The response omitted a refresh token: the old one carries forward.
    self assert: fresh refreshToken equals: "rt-1"
    self assert: fresh subject equals: "user-1"
    form := self.provider lastTokenRequest at: #form
    self assert: (form at: "grant_type") equals: "refresh_token"
    self assert: (form at: "refresh_token") equals: "rt-1"
    self assert: (form at: "client_secret") equals: FixtureProvider clientSecret

  testRefreshTakesNewRefreshToken =>
    toks := self exchange
    self.provider tokenFields: #{"refresh_token" => "rt-2"}
    fresh := (OAuthFlows
      refresh: self.server
      client: self.reg
      tokenSet: toks) unwrap
    self assert: fresh refreshToken equals: "rt-2"

  testRefreshRejectsChangedSubject =>
    toks := self exchange
    self.provider claims: #{"sub" => "user-2"}
    got := OAuthFlows
      refresh: self.server
      client: self.reg
      tokenSet: toks
    self assert: (self codeOf: got) equals: "sub_invalid"

  testRefreshRefusesTokensFromAnotherIssuer =>
    toks := self exchange
    claims := toks idTokenClaims at: "iss" put: "https://other.test"
    self.provider reset
    got := OAuthFlows
      refresh: self.server
      client: self.reg
      tokenSet: (toks withIdTokenClaims: claims)
    self assert: (self codeOf: got) equals: "issuer_mismatch"
    self assert: self.provider lastTokenRequest equals: nil

  testRefreshNeedsRefreshTokenAndSubject =>
    toks := self exchange
    self.provider reset
    noRt := OAuthFlows
      refresh: self.server
      client: self.reg
      tokenSet: (toks withRefreshToken: nil)
    self assert: (self codeOf: noRt) equals: "config"
    noClaims := OAuthFlows
      refresh: self.server
      client: self.reg
      tokenSet: (toks withIdTokenClaims: nil)
    self assert: (self codeOf: noClaims) equals: "config"
    self assert: self.provider lastTokenRequest equals: nil

  // ===== Userinfo =====
  testUserInfo =>
    toks := self exchange
    info := (OAuthFlows
      userInfo: self.server
      client: self.reg
      tokenSet: toks) unwrap
    self assert: (info at: "sub") equals: "user-1"
    self assert: (info at: "name") equals: "Fixture User"
    // Without the registration, the client id comes from the ID token.
    again := (OAuthFlows userInfo: self.server tokenSet: toks) unwrap
    self assert: (again at: "email") equals: "user-1@example.test"

  testUserInfoChecksSubject =>
    toks := self exchange
    self.provider claims: #{"sub" => "user-2"}
    got := OAuthFlows
      userInfo: self.server
      client: self.reg
      tokenSet: toks
    self assert: (self codeOf: got) equals: "bad_subject"

  testUserInfoRefusesTokensFromAnotherIssuer =>
    toks := self exchange
    claims := toks idTokenClaims at: "iss" put: "https://other.test"
    got := OAuthFlows userInfo: self.server tokenSet: (toks withIdTokenClaims: claims)
    self assert: (self codeOf: got) equals: "issuer_mismatch"

  // ===== Hardening =====
  testValuelessAndMalformedErrorAreParseErrors =>
    sess := self newSession
    empty := OAuthFlows
      handleCallback: "error=&state={sess state}"
      store: self.store
      boundTo: self.binding
    self assert: (self codeOf: empty) equals: "parse"
    quoted := OAuthFlows
      handleCallback: #(#("error", "bad""code"), #("state", sess state))
      store: self.store
      boundTo: self.binding
    self assert: (self codeOf: quoted) equals: "parse"
    symbol := OAuthFlows
      handleCallback: #(#("code", #true), #("state", sess state))
      store: self.store
      boundTo: self.binding
    self assert: (self codeOf: symbol) equals: "parse"
    self assert: self.store size equals: 0

  testIssRequirementComesFromContextNotMetadata =>
    self.provider discoveryOverrides: #{
      "authorization_response_iss_parameter_supported" => true
    }
    self.server := (self discover: #{}) withMetadata: #{}
    sess := self newSession
    got := self
      exchange: self.server
      client: self.reg
      callback: (self callbackFor: sess)
    self assert: (self codeOf: got) equals: "issuer_mismatch"
    self assert: self.provider lastTokenRequest equals: nil

  testMissingIdTokenIsRejected =>
    sess := self newSession
    self.provider tokenFields: #{"id_token" => nil}
    got := self
      exchange: self.server
      client: self.reg
      callback: (self callbackFor: sess)
    self assert: (self codeOf: got) equals: "missing_id_token"

  testOidccCrashBecomesErrorWithoutSecrets =>
    // Empty algorithm lists make oidcc raise badarg with the ID token,
    // client context and options as the call's arguments.
    self.provider
      discoveryOverrides: #{
        "id_token_signing_alg_values_supported" => #(),
        "id_token_encryption_alg_values_supported" => #()
      }
    self.server := self discover: #{}
    sess := self newSession
    got := self
      exchange: self.server
      client: self.reg
      callback: (self callbackFor: sess)
    err := got error
    self assert: err code equals: "oidcc_crash"
    text := err printString ++ err detail printString
    self deny: (text includesSubstring: FixtureProvider clientSecret)
    self deny: (text includesSubstring: sess codeVerifier)
    self deny: (text includesSubstring: sess nonce)
    self deny: (text includesSubstring: "code-1")

  testUserInfoWithoutEndpoint =>
    self.provider discoveryOverrides: #{"userinfo_endpoint" => nil}
    self.server := self discover: #{}
    toks := self exchange
    got := OAuthFlows
      userInfo: self.server
      client: self.reg
      tokenSet: toks
    self assert: (self codeOf: got) equals: "no_userinfo_endpoint"

  testForgedServerIsRefusedForRefreshAndUserInfo =>
    toks := self exchange
    self.provider reset
    self.provider
      fail: "/userinfo"
      status: 500
      body: #{"error" => "server_error"}
    forged := self.server withIssuer: "https://forged.test"
    claims := toks idTokenClaims at: "iss" put: "https://forged.test"
    forgedToks := toks withIdTokenClaims: claims
    refreshed := OAuthFlows
      refresh: forged
      client: self.reg
      tokenSet: forgedToks
    self assert: (self codeOf: refreshed) equals: "session_mismatch"
    self assert: self.provider lastTokenRequest equals: nil
    // A request would have answered the configured 500.
    info := OAuthFlows
      userInfo: forged
      client: self.reg
      tokenSet: forgedToks
    self assert: (self codeOf: info) equals: "session_mismatch"

  testTokensForAnotherClientAreRefused =>
    toks := self exchange
    self.provider reset
    other := self.reg withClientId: "client-2"
    got := OAuthFlows
      refresh: self.server
      client: other
      tokenSet: toks
    self assert: (self codeOf: got) equals: "session_mismatch"
    self assert: self.provider lastTokenRequest equals: nil

  // ===== Callback tickets =====
  testHandBuiltCallbackIsRefused =>
    sess := self newSession
    // Consume the session as a real callback would, then forge one.
    self.store consume: sess state boundTo: self.binding
    forged := Callback
      code: "code-1"
      iss: nil
      session: sess
      ticket: Secrets generate
    got := self
      exchange: self.server
      client: self.reg
      callback: forged
    self assert: (self codeOf: got) equals: "reused_state"
    self assert: self.provider lastTokenRequest equals: nil
    noTicket := Callback
      code: "code-1"
      iss: nil
      session: sess
      ticket: ""
    again := self
      exchange: self.server
      client: self.reg
      callback: noTicket
    self assert: (self codeOf: again) equals: "reused_state"

  testCallbackCannotBeExchangedTwice =>
    cb := self callbackFor: self newSession
    first := self
      exchange: self.server
      client: self.reg
      callback: cb
    self assert: first isOk
    self.provider reset
    second := self
      exchange: self.server
      client: self.reg
      callback: cb
    self assert: (self codeOf: second) equals: "reused_state"
    self assert: self.provider lastTokenRequest equals: nil

  testTicketIsBoundToItsSession =>
    cb := self callbackFor: self newSession
    other := self newSession
    swapped := cb withSession: other
    got := self
      exchange: self.server
      client: self.reg
      callback: swapped
    self assert: (self codeOf: got) equals: "session_mismatch"
    self assert: self.provider lastTokenRequest equals: nil

  testCallbackPrintStringRedactsTicket =>
    cb := self callbackFor: self newSession
    self deny: (cb printString includesSubstring: cb ticket)
    self deny: (cb asJson printString includesSubstring: cb ticket)

  testExchangeRejectsWrongAudience =>
    sess := self newSession
    self.provider claims: #{"nonce" => sess nonce, "aud" => "another-client"}
    got := self
      exchange: self.server
      client: self.reg
      callback: (self callbackFor: sess)
    self assert: (self codeOf: got) equals: "missing_claim"

  // ===== Refresh without an ID token =====
  testRefreshWithoutIdTokenKeepsTheOldOne =>
    toks := self exchange
    self.provider tokenFields: #{
      "id_token" => nil,
      "access_token" => "at-2",
      "refresh_token" => "rt-2"
    }
    fresh := (OAuthFlows
      refresh: self.server
      client: self.reg
      tokenSet: toks) unwrap
    self assert: fresh accessToken equals: "at-2"
    self assert: fresh refreshToken equals: "rt-2"
    self assert: fresh idToken equals: toks idToken
    self assert: fresh idTokenClaims equals: toks idTokenClaims
    self assert: fresh subject equals: "user-1"
    self assert: fresh expiresIn equals: 3600

  testRefreshWithoutGrantTypesSupported =>
    self.provider discoveryOverrides: #{"grant_types_supported" => nil}
    self.server := self discover: #{}
    toks := self exchange
    self.provider tokenFields: #{"access_token" => "at-2"}
    fresh := (OAuthFlows
      refresh: self.server
      client: self.reg
      tokenSet: toks) unwrap
    self assert: fresh accessToken equals: "at-2"

  testRefreshIdTokenWithAnotherSubjectFailsEvenWhenCaptured =>
    toks := self exchange
    self.provider claims: #{"sub" => "user-2"}
    self.provider tokenFields: #{"access_token" => "at-2"}
    got := OAuthFlows
      refresh: self.server
      client: self.reg
      tokenSet: toks
    self assert: (self codeOf: got) equals: "sub_invalid"

  // ===== Hardening, round 2 =====
  testReservedExtrasAreCaseInsensitive =>
    sess := self newSession
    got := OAuthFlows
      authorizeUrl: self.server
      client: self.reg
      scopes: #("openid")
      session: sess
      extraParams: #{"STATE" => "x"}
    self assert: (self codeOf: got) equals: "config"

  testUnregisteredProviderErrorCannotPoseAsLocalCode =>
    sess := self newSession
    got := OAuthFlows
      handleCallback: #(#("error", "session_mismatch"), #("state", sess state))
      store: self.store
      boundTo: self.binding
    err := got error
    self assert: err code equals: "provider_error"
    self assert: err detail equals: "session_mismatch"
    self assert: self.store size equals: 0

  testMalformedErrorStillBurnsSession =>
    sess := self newSession
    got := OAuthFlows
      handleCallback: #(#("error", ""), #("state", sess state))
      store: self.store
      boundTo: self.binding
    self assert: (self codeOf: got) equals: "parse"
    self assert: self.store size equals: 0

  testCallbackTextIsSanitized =>
    sess := self newSession
    long := (1 to: 500) inject: "" into: [:acc :i | acc ++ "a"]
    got := OAuthFlows
      handleCallback: #(#("error", "access_denied"), #("error_description", "line1\nline2" ++ long), #("state", sess state))
      store: self.store
      boundTo: self.binding
    desc := got error description
    self deny: (desc includesSubstring: "\n")
    self assert: desc size <= OAuthFlows maxEchoSize

  // ===== Distributed claims =====
  // The fixture rediscovered with signed userinfo (ES256) allowed: a
  // distributed claim is a JWT validated against the userinfo algorithms.
  signedUserinfoServer -> OAuthServer =>
    self.provider discoveryOverrides: #{
      "userinfo_signing_alg_values_supported" => #("ES256")
    }
    self discover: #{}

  // Userinfo claims for `user-1` naming the claim `claimN` from the source
  // `srcN` at the Nth of `endpoints`.
  claimsWithSources: endpoints :: List -> Dictionary =>
    names := #{}
    sources := #{}
    (1 to: endpoints size)
      do: [:i |
        names := names at: "claim{i}" put: "src{i}"
        sources := sources at: "src{i}" put: #{
          "endpoint" => (endpoints at: i),
          "access_token" => "ext-at"
        }
      ]
    #{"sub" => "user-1", "_claim_names" => names, "_claim_sources" => sources}

  // Answer `/userinfo` with `claims` as JSON.
  userinfoAnswers: claims :: Dictionary -> Nil =>
    self.provider
      respond: "/userinfo"
      status: 200
      body: (Json generate: claims)
      contentType: "application/json"
    nil

  // The userinfo claims for `toks`, with the test's registration.
  userInfoFor: toks :: TokenSet -> Result =>
    OAuthFlows
      userInfo: self.server
      client: self.reg
      tokenSet: toks

  testDistributedClaimsFromAnAllowedEndpoint =>
    self.server := self signedUserinfoServer
    toks := self exchange
    // The source answers a JWT signed with the provider's key.
    self.provider claims: #{"claim1" => #("admins")}
    self.provider
      respond: "/claims"
      status: 200
      body: self.provider idToken
      contentType: "application/jwt"
    self.provider claims: #{}
    self userinfoAnswers: (self claimsWithSources: #("{self.provider issuer}/claims"))
    info := (self userInfoFor: toks) unwrap
    self assert: (info at: "claim1") equals: #("admins")
    self assert: (self.provider hits: "/claims") equals: 1

  testInsecureClaimSourceFailsBeforeAnyFetch =>
    self.server := self signedUserinfoServer
    toks := self exchange
    self userinfoAnswers: (self claimsWithSources: #("{self.provider issuer}/claims", "http://claims.example.test/groups"))
    err := (self userInfoFor: toks) error
    self assert: err code equals: "insecure_endpoint"
    self assert: (err description includesSubstring: "claim_source")
    self assert: (err description includesSubstring: "http://claims.example.test/groups")
    // The allowed source was not fetched either.
    self assert: (self.provider hits: "/claims") equals: 0

  testInsecureClaimSourceInSignedUserinfo =>
    self.server := self signedUserinfoServer
    toks := self exchange
    sources := self claimsWithSources: #("http://claims.example.test/groups")
    self.provider
      claims: #{
        "_claim_names" => (sources at: "_claim_names"),
        "_claim_sources" => (sources at: "_claim_sources")
      }
    self.provider
      respond: "/userinfo"
      status: 200
      body: self.provider idToken
      contentType: "application/jwt"
    err := (self userInfoFor: toks) error
    self assert: err code equals: "insecure_endpoint"
    self assert: (err description includesSubstring: "claim_source")

  testAggregatedClaimNeedsNoEndpointCheck =>
    toks := self exchange
    // A source carrying an aggregated JWT has no endpoint to check; oidcc
    // then validates the JWT (here, one it cannot verify).
    self
      userinfoAnswers: #{
        "sub" => "user-1",
        "_claim_names" => #{"claim1" => "src1"},
        "_claim_sources" => #{"src1" => #{"JWT" => "e30.e30.sig"}}
      }
    err := (self userInfoFor: toks) error
    self deny: err code =:= "insecure_endpoint"

  // ===== Non-object JSON bodies =====
  testNonObjectTokenBodyIsAnError =>
    #("[1, 2]", """at-1""", "42", "null")
      do: [:body |
        sess := self newSession
        self.provider
          respond: "/token"
          status: 200
          body: body
          contentType: "application/json"
        got := self
          exchange: self.server
          client: self.reg
          callback: (self callbackFor: sess)
        self assert: (self codeOf: got) equals: "oidcc_crash"
        self deny: (got error asJson printString includesSubstring: sess codeVerifier)
      ]

  testNonObjectRefreshBodyIsAnError =>
    toks := self exchange
    #("[1, 2]", """rt-1""", "42")
      do: [:body |
        self.provider
          respond: "/token"
          status: 200
          body: body
          contentType: "application/json"
        got := OAuthFlows
          refresh: self.server
          client: self.reg
          tokenSet: toks
        self assert: (self codeOf: got) equals: "oidcc_crash"
      ]

  testNonObjectUserinfoBodyIsAnError =>
    toks := self exchange
    #("[1, 2]", """user-1""", "42", "null")
      do: [:body |
        self.provider
          respond: "/userinfo"
          status: 200
          body: body
          contentType: "application/json"
        self assert: (self codeOf: (self userInfoFor: toks)) equals: "oidcc_crash"
      ]

  // ===== Pushed authorization requests =====
  testPushedAuthorizationRequestGoesThroughTheAdapter =>
    self.provider discoveryOverrides: #{
      "pushed_authorization_request_endpoint" => "{self.provider issuer}/par"
    }
    self.server := self discover: #{}
    requestUri := "urn:ietf:params:oauth:request_uri:par-1"
    self.provider
      respond: "/par"
      status: 201
      body: (Json generate: #{"request_uri" => requestUri, "expires_in" => 60})
      contentType: "application/json"
    sess := self newSession
    url := (OAuthFlows
      authorizeUrl: self.server
      client: self.reg
      scopes: #("openid")
      session: sess) unwrap
    q := self queryOf: url
    self assert: (q at: "request_uri") equals: requestUri
    self assert: (q at: "client_id") equals: FixtureProvider clientId
    // The state and nonce went to the PAR endpoint, not into the URL.
    self deny: (url includesSubstring: sess state)
    self deny: (url includesSubstring: sess nonce)
    self assert: (self.provider hits: "/par") equals: 1

  // ===== Redaction =====
  testRefreshErrorEchoingTheRefreshTokenIsRedacted =>
    toks := self exchange
    self.provider
      fail: "/token"
      status: 400
      body: #{
        "error" => "invalid_grant",
        "error_description" => "refresh token rt-1 was revoked",
        "refresh_token" => "rt-1",
        "hint" => "rt-1"
      }
    err := (OAuthFlows
      refresh: self.server
      client: self.reg
      tokenSet: toks) error
    self assert: err code equals: "invalid_grant"
    self assert: err status equals: 400
    self deny: (err printString includesSubstring: "rt-1")
    self deny: (err asJson printString includesSubstring: "rt-1")

  testUserinfoErrorEchoingTheTokensIsRedacted =>
    toks := self exchange
    self.provider
      fail: "/userinfo"
      status: 401
      body: #{
        "error" => "invalid_token",
        "error_description" => "token at-1 (refresh rt-1) expired",
        "hint" => "rt-1"
      }
    err := (self userInfoFor: toks) error
    self assert: err code equals: "invalid_token"
    self assert: err status equals: 401
    text := err printString ++ err asJson printString
    self deny: (text includesSubstring: "rt-1")
    self deny: (text includesSubstring: "at-1")

  // ===== Unsigned ID tokens =====
  // `text` as unpadded base64url.
  base64Url: text :: String -> String =>
    text asBase64Url replaceAll: "=" with: ""

  testAlgNoneIdTokenIsRejected =>
    sess := self newSession
    header := self base64Url: (Json generate: #{
      "alg" => "none",
      "typ" => "JWT"
    })
    payload := self base64Url: (Json generate: self.provider idTokenClaims)
    self.provider tokenFields: #{"id_token" => "{header}.{payload}."}
    got := self
      exchange: self.server
      client: self.reg
      callback: (self callbackFor: sess)
    // oidcc accepts only the advertised algorithms (ES256), so no key
    // verifies an unsigned token.
    self assert: (self codeOf: got) equals: "no_matching_key"
