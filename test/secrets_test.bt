TestCase subclass: SecretsTest

  testGenerateIs43Characters => self assert: Secrets generate size equals: 43

  testGenerateUsesOnlyUnreservedBase64UrlCharacters =>
    // RFC 7636 unreserved characters; base64url uses the [A-Za-z0-9_-] subset
    // and the `=` padding must be gone.
    10 timesRepeat: [
      self assert: (Secrets generate matchesRegex: "^[A-Za-z0-9_-]+$")
    ]

  testGenerateHasNoPadding =>
    self deny: (Secrets generate includesSubstring: "=")

  testGenerateIsFreshEachTime =>
    self deny: Secrets generate =:= Secrets generate
