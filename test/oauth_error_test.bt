TestCase subclass: OAuthErrorTest

  // A raw Erlang binary, as oidcc produces (distinct from a String).
  bin: text => Binary fromIolist: #(text)

  testLocalConstructors =>
    self assert: (OAuthError transport: "x") code equals: "transport"
    self assert: (OAuthError parse: "x") code equals: "parse"
    self assert: (OAuthError config: "x") code equals: "config"
    self assert: (OAuthError insecureEndpoint: "x") code equals: "insecure_endpoint"
    self assert: OAuthError expiredSession code equals: "expired_session"
    self assert: OAuthError reusedState code equals: "reused_state"
    self assert: OAuthError sessionMismatch code equals: "session_mismatch"
    self assert: OAuthError callbackTimeout code equals: "callback_timeout"
    self assert: OAuthError sessionStoreFull code equals: "session_store_full"
    self assert: (OAuthError callbackTimeoutRefusing: 0) description equals: OAuthError callbackTimeout description
    refused := OAuthError callbackTimeoutRefusing: 3
    self assert: refused code equals: "callback_timeout"
    self assert: refused detail equals: 3
    self assert: (refused description includesSubstring: "3 callback")

  testLocalConstructorKeepsDescription =>
    e := OAuthError transport: "connection refused"
    self assert: e description equals: "connection refused"
    self assert: e status equals: nil

  testHttpErrorWithProviderCode =>
    body := (#{} at: (self bin: "error") put: (self bin: "invalid_grant")) at: (self bin: "error_description") put: (self bin: "code expired")
    e := OAuthError fromOidcc: {#http_error, 400, body}
    self assert: e code equals: "invalid_grant"
    self assert: e status equals: 400
    self assert: e description equals: "code expired"

  testHttpErrorWithStringKeys =>
    e := OAuthError fromOidcc: {#http_error, 401, #{
      "error" => "invalid_client"
    }}
    self assert: e code equals: "invalid_client"
    self assert: e status equals: 401
    self assert: e description equals: ""

  testHttpErrorWithoutProviderCode =>
    e := OAuthError fromOidcc: {#http_error, 500, self bin: "Internal Server Error"}
    self assert: e code equals: "http_error"
    self assert: e status equals: 500

  testAtomReason =>
    self assert: (OAuthError fromOidcc: #token_expired) code equals: "token_expired"
    self assert: (OAuthError fromOidcc: #no_supported_auth_method) code equals: "no_supported_auth_method"

  testTupleReason =>
    claims := #{} at: (self bin: "sub") put: (self bin: "1234")
    e := OAuthError fromOidcc: {#missing_claim, {self bin: "aud", self bin: "app"}, claims}
    self assert: e code equals: "missing_claim"

  testWrappedErrorTupleIsUnwrapped =>
    self assert: (OAuthError fromOidcc: {#error, #sub_invalid}) code equals: "sub_invalid"

  testAnythingElseIsTransport =>
    self assert: (OAuthError fromOidcc: 42) code equals: "transport"
    self assert: (OAuthError fromOidcc: (self bin: "boom")) code equals: "transport"
    self assert: (OAuthError fromOidcc: {1, 2}) code equals: "transport"

  testHttpClientIsTransport =>
    e := OAuthError fromOidcc: {#http_client, self bin: "Could not open connection (econnrefused)"}
    self assert: e code equals: "transport"
    self assert: e description equals: "Could not open connection (econnrefused)"
    self assert: (OAuthError fromOidcc: {#http_client, #streaming_request_body}) description equals: "streaming_request_body"

  testInsecureEndpointNamesField =>
    e := OAuthError fromOidcc: {#insecure_endpoint, #token_endpoint, self bin: "http://a.test/token"}
    self assert: e code equals: "insecure_endpoint"
    self assert: e description equals: "token_endpoint must be https: http://a.test/token"

  testFfiErrorIsUnwrapped =>
    // An FFI {error, R} arrives as an Exception whose reason is R.
    failed := Erlang beamtalk_oauth_oidcc check_https: #{
      #issuer => "http://a.test"
    } with: false
    self assert: (failed error isKindOf: Exception)
    self assert: (OAuthError fromOidcc: failed error) code equals: "insecure_endpoint"

  testDetailRedactsClaimsMap =>
    claims := (#{} at: (self bin: "sub") put: (self bin: "1234")) at: (self bin: "email") put: (self bin: "alice@example.com")
    e := OAuthError fromOidcc: {#missing_claim, {self bin: "aud", self bin: "app"}, claims}
    self assert: (e detail at: 1) equals: #missing_claim
    self assert: (e detail at: 3) equals: "[redacted]"
    self deny: (e detail printString includesSubstring: "alice@example.com")

  testDetailRedactsJwt =>
    jwt := self bin: "eyJhbGciOiJFUzI1NiJ9.eyJzdWIiOiIxIn0.c2lnbmF0dXJl"
    e := OAuthError fromOidcc: {#token_invalid, jwt}
    self assert: (e detail at: 2) equals: "[redacted]"

  testDetailRedactsOpaqueToken =>
    e := OAuthError fromOidcc: {#bad_token, self bin: "glpat-abcdefghij1234567890"}
    self assert: (e detail at: 2) equals: "[redacted]"

  testDetailRedactsSecretNamedMembers =>
    body := (#{} at: (self bin: "access_token") put: (self bin: "short")) at: (self bin: "token_type") put: (self bin: "bearer")
    e := OAuthError fromOidcc: {#http_error, 200, body}
    redactedBody := e detail at: 3
    self assert: (redactedBody at: (self bin: "access_token")) equals: "[redacted]"
    self assert: ((redactedBody at: (self bin: "token_type")) =:= (self bin: "bearer"))

  testDetailRedactsInvalidUtf8 =>
    e := OAuthError fromOidcc: {#odd, Erlang erlang list_to_binary: #(255, 254, 253)}
    self assert: (e detail at: 2) equals: "[redacted]"

  testDetailKeepsHarmlessValues =>
    e := OAuthError fromOidcc: {#issuer_mismatch, self bin: "https://gitlab.com", #(1, 2)}
    self assert: ((e detail at: 2) =:= (self bin: "https://gitlab.com"))
    self assert: (e detail at: 3) equals: #(1, 2)

  testPrintStringOmitsDetail =>
    jwt := self bin: "eyJhbGciOiJFUzI1NiJ9.eyJzdWIiOiIxIn0.c2lnbmF0dXJl"
    e := OAuthError fromOidcc: {#token_invalid, jwt}
    self deny: (e printString includesSubstring: "eyJ")
    self assert: (e printString includesSubstring: "token_invalid")

  testDetailRedactsNonAlphabetSecret =>
    e := OAuthError fromOidcc: {#bad, self bin: "p@ss!w0rd#secret-value-xyz"}
    self assert: (e detail at: 2) equals: "[redacted]"

  testDetailRedactsBearerHeader =>
    e := OAuthError fromOidcc: {#bad, self bin: "Bearer abc"}
    self assert: (e detail at: 2) equals: "[redacted]"

  testDetailRedactsEmbeddedJwt =>
    e := OAuthError fromOidcc: {#bad, self bin: "token was eyJhbGciOiJFUzI1NiJ9.eyJzdWIiOiIxIn0 rejected"}
    self assert: (e detail at: 2) equals: "[redacted]"

  testDetailRedactsCallbackUrl =>
    e := OAuthError fromOidcc: {#bad, self bin: "https://app/cb?code=abc&state=xyz"}
    self assert: (e detail at: 2) equals: "[redacted]"

  testDetailRedactsSecretRecords =>
    e := OAuthError fromOidcc: {#bad, {#oidcc_token, 1, 2, 3}, {#oidcc_client_context, #x}, {#jose_jwk, #y}}
    self assert: (e detail at: 2) equals: "[redacted]"
    self assert: (e detail at: 3) equals: "[redacted]"
    self assert: (e detail at: 4) equals: "[redacted]"

  testDetailRedactsKeywordListPairs =>
    e := OAuthError fromOidcc: {#bad, #({#client_secret, self bin: "s"}, {#scope, #openid})}
    self assert: (e detail at: 2) equals: #({#client_secret, "[redacted]"}, {#scope, #openid})

  testDetailRedactsClaimsWithoutSub =>
    claims := #{} at: (self bin: "email") put: (self bin: "alice@example.com")
    e := OAuthError fromOidcc: {#missing_claim, {self bin: "sub", #undefined}, claims}
    self assert: (e detail at: 3) equals: "[redacted]"

  testNestedErrorTuplesAreUnwrapped =>
    self assert: (OAuthError fromOidcc: {#error, {#error, #sub_invalid}}) code equals: "sub_invalid"

  testNonReasonAtomsAreTransport =>
    self assert: (OAuthError fromOidcc: #undefined) code equals: "transport"
    self assert: (OAuthError fromOidcc: false) code equals: "transport"

  testJsonGenerateHidesDetailSecrets =>
    e := OAuthError fromOidcc: {#bad, self bin: "glpat-abcdefghij1234567890"}
    self deny: ((Json generate: e) includesSubstring: "glpat")

  testScrubRemovesSecretsInStringValues =>
    // A body from Json parse: holds Strings (as TokenRevocation's errors
    // do), not raw binaries.
    json := Json
      generate: #{
        "error" => "invalid_request",
        "token" => "rt-1",
        "error_description" => "bad token rt-1"
      }
    body := (Json parse: json) unwrap
    self assert: ((body isKindOf: Dictionary) and: [
      (body at: "token") isKindOf: String
    ])
    scrubbed := OAuthError scrub: body secrets: #("rt-1")
    self deny: (scrubbed printString includesSubstring: "rt-1")
    self assert: (scrubbed at: "error") equals: "invalid_request"

  testScrubRemovesSecretsInEveryShape =>
    secret := "my secret/x"
    body := #{
      (self bin: "error") => (self bin: "invalid_grant"),
      (self bin: "raw") => (self bin: "echo my secret/x"),
      (self bin: "url") => (self bin: "echo my%20secret%2Fx"),
      (self bin: "form") => (self bin: "echo my+secret%2Fx"),
      (self bin: "my secret/x") => (self bin: "as a key"),
      (self bin: "bad") => (Binary fromIolist: #(#(255, 254)))
    }
    scrubbed := OAuthError scrub: {#http_error, 400, body} secrets: #(secret)
    text := scrubbed printString
    self deny: (text includesSubstring: "secret")
    self assert: (text includesSubstring: "invalid_grant")
    // With no secrets (or only empty ones) the term is unchanged.
    self assert: (OAuthError scrub: body secrets: #("")) equals: body
    err := OAuthError fromOidcc: {#http_error, 400, body} secrets: #(secret)
    self assert: err code equals: "invalid_grant"
    self deny: (err detail printString includesSubstring: "secret")
